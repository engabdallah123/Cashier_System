                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <button type="button" class="btn-whatsapp" @onclick='() => OpenWhatsApp("01062592321")' title="فتح محادثة واتساب فورية">
