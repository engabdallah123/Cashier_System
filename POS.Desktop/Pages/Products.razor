@page "/products"
@using System.IO
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using global::POS.Desktop.Services
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@using global::POS.Desktop.Services.State
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject CustomAuthStateProvider AuthState
@inject StoreStateContainer StoreState
@inject IJSRuntime JS

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">كتالوج المنتجات والمخزون</h2>
            <p class="page-subtitle">إدارة المنتجات والأسعار وحدود الطلب والتصنيفات</p>
        </div>
        @if (CanManageProducts)
        {
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <NavLink href="expiry" class="btn btn-secondary" style="font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-clock-rotate-left text-amber"></i>
                    <span>متابعة الصلاحية</span>
                </NavLink>
                <button class="btn btn-secondary" style="background: rgba(16, 124, 65, 0.15); border-color: #107c41; color: #107c41;" @onclick="OpenImportModal">
                    <i class="fa-solid fa-file-import me-1"></i> استيراد من إكسيل
                </button>
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد
                </button>
            </div>
        }
    </div>

    <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: center; flex-wrap: wrap;">
        <div class="search-box" style="max-width: 380px; flex: 1;">
            <i class="fa-solid fa-search"></i>
            <input id="products-search-input" @bind="search" @bind:event="oninput" @onkeyup="Filter" placeholder="تصفية بالاسم أو الباركود..." />
        </div>
        <div class="search-box" style="max-width: 320px; flex: 1;">
            <i class="fa-solid fa-barcode" style="color: var(--accent-indigo);"></i>
            <input id="product-quick-scan-barcode" @bind="quickScanBarcode" @bind:event="oninput" @onkeyup="HandleQuickScanBarcodeKeyUp" placeholder="مسح باركود صنف للتسجيل... [Enter]" style="border-color: var(--accent-indigo);" />
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">
            إجمالي المنتجات: <strong style="color: var(--text-primary);">@filtered.Count</strong>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>الباركود</th>
                    <th>الاسم (عربي)</th>
                    <th>الاسم (إنجليزي)</th>
                    <th>التصنيف</th>
                    <th>سعر البيع</th>
                    <th>المخزون</th>
                    <th>الحالة</th>
                    @if (CanManageProducts)
                    {
                        <th style="width: 120px; text-align: center;">الإجراءات</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!filtered.Any())
                {
                    <tr>
                        <td colspan="@(CanManageProducts ? 8 : 7)" style="text-align: center; padding: 2.5rem; color: var(--text-muted);">
                            <i class="fa-solid fa-box-open" style="font-size: 2.2rem; margin-bottom: 0.5rem; display: block;"></i>
                            لا توجد منتجات في الكتالوج حالياً.
                        </td>
                    </tr>
                }
                else
                {
                    var pagedList = PagedProducts.ToList();
                    for (int i = 0; i < pagedList.Count; i++)
                    {
                        var prod = pagedList[i];
                        bool isNearBottom = i >= pagedList.Count - 3 && pagedList.Count > 3;
                        <tr>
                            <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@prod.Barcode</code></td>
                            <td style="font-weight: 600;">@prod.NameAr</td>
                            <td>@prod.NameEn</td>
                            <td>
                                <span class="badge badge-indigo">
                                    @(prod.CategoryName ?? "عام")
                                </span>
                            </td>
                            <td style="color: var(--accent-emerald); font-weight: 700;">@prod.SellingPrice.ToString("N2") ج.م</td>
                            <td>
                                <div style="font-weight: 600; color: var(--text-primary);">
                                    @PackagingUnitHelper.FormatTwoTierStockBreakdown(prod.QuantityInStock, prod.ConversionFactor, prod.BaseUnit, prod.ParentUnit)
                                </div>
                            </td>
                            <td>
                                <span class="badge @(prod.IsActive ? "badge-green" : "badge-red")" style="cursor: pointer;" @onclick="() => ToggleProductStatus(prod)" title="اضغط لتغيير حالة النشاط">
                                    <i class="fa-solid fa-circle" style="font-size: 0.45rem;"></i>
                                    @(prod.IsActive ? "نشط" : "غير نشط")
                                </span>
                            </td>
                            @if (CanManageProducts)
                            {
                                <td style="text-align: center;">
                                    <div class="action-dropdown-container">
                                        <button class="action-dropdown-btn @(activeMenuProductId == prod.Id ? "active" : "")" @onclick="() => ToggleProductMenu(prod.Id)">
                                            <i class="fa-solid fa-sliders"></i>
                                            <span>خيارات</span>
                                            <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>
                                        </button>
                                        @if (activeMenuProductId == prod.Id)
                                        {
                                            <div class="action-dropdown-backdrop" @onclick="CloseProductMenu"></div>
                                            <div class="action-dropdown-menu @(isNearBottom ? "dropup" : "")" @onclick:stopPropagation="true">
                                                <button class="action-dropdown-item item-primary" @onclick="async () => { CloseProductMenu(); await OpenBarcodeModal(prod); }">
                                                    <i class="fa-solid fa-barcode" style="color: var(--accent-blue);"></i>
                                                    <span>طباعة الباركود</span>
                                                </button>
                                                <button class="action-dropdown-item item-primary" @onclick="() => { CloseProductMenu(); OpenEditModal(prod); }">
                                                    <i class="fa-solid fa-pen-to-square" style="color: var(--accent-indigo);"></i>
                                                    <span>تعديل المنتج</span>
                                                </button>
                                                <button class="action-dropdown-item @(prod.IsActive ? "item-warning" : "item-success")" @onclick="() => ToggleProductStatus(prod)">
                                                    <i class="fa-solid @(prod.IsActive ? "fa-ban" : "fa-circle-check")" style="color: @(prod.IsActive ? "var(--accent-amber)" : "var(--accent-emerald)");"></i>
                                                    <span>@(prod.IsActive ? "تعطيل المنتج" : "تفعيل المنتج")</span>
                                                </button>
                                                <div class="action-dropdown-divider"></div>
                                                <button class="action-dropdown-item item-danger" @onclick="() => { CloseProductMenu(); ConfirmDeleteProduct(prod); }">
                                                    <i class="fa-solid fa-trash-can" style="color: var(--accent-red);"></i>
                                                    <span>حذف المنتج</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="@currentPage" TotalItems="@filtered.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; EnsureValidPage(); })" />
</div>


<!-- Add / Edit Modal -->
@if (showAddModal || showEditModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 750px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid @(showEditModal ? "fa-pen-to-square" : "fa-box-archive") me-2" style="color: var(--accent-indigo);"></i>
                    @(showEditModal ? "تعديل بيانات المنتج" : "إضافة منتج جديد")
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div class="form-group" style="margin-bottom: 1.1rem; background: rgba(255,255,255,0.02); padding: 0.85rem 1rem; border-radius: 0.75rem; border: 1px solid var(--border-color-light);">
                    <label style="font-weight: 700; display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
                        <span>رمز الباركود <span style="color: var(--accent-red);">*</span></span>
                        <span style="font-size: 0.78rem; font-weight: normal; color: var(--text-secondary);">امسح بالقارئ أو أدخل الأرقام يدوياً</span>
                    </label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input id="product-modal-barcode-input" class="form-control" @bind="newProduct.Barcode" placeholder="امسح أو أدخل رقم الباركود..." style="flex: 1; min-width: 280px; font-size: 1.15rem; font-weight: 700; font-family: 'Courier New', Courier, monospace; letter-spacing: 1.5px; color: var(--accent-blue); background: var(--bg-secondary); padding: 0.6rem 0.85rem;" />
                        
                        <button class="btn btn-secondary" type="button" @onclick="FetchOnlineProductInfo" disabled="@isFetchingOnline" title="جلب اسم المنتج والصورة أونلاين عبر الباركود" style="padding: 0.6rem 0.85rem; font-weight: 600; white-space: nowrap;">
                            @if (isFetchingOnline)
                            {
                                <i class="fa-solid fa-spinner fa-spin"></i>
                            }
                            else
                            {
                                <span>جلب 🌐</span>
                            }
                        </button>
                        <button class="btn btn-secondary" type="button" @onclick="GenerateBarcode" title="توليد باركود تلقائي" style="padding: 0.6rem 0.85rem; font-weight: 600; white-space: nowrap;">
                            <span>توليد 🪄</span>
                        </button>
                        <button class="btn btn-secondary" type="button" @onclick="PrintBarcodeFromAddModal" title="طباعة ملصق الباركود لهذا الكود" style="padding: 0.6rem 0.85rem; font-weight: 600; white-space: nowrap;">
                             <span>طباعة 🖨️</span>
                        </button>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>التصنيف <span style="color: var(--accent-red);">*</span></label>
                        <select class="form-select" @bind="categoryIdString">
                            <option value="">-- اختر التصنيف --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id.ToString()">@cat.NameAr</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>الاسم (بالعربية) <span style="font-size: 0.78rem; font-weight: normal; color: var(--text-secondary);">(مطلوب إن لم يُدخل الاسم بالإنجليزي)</span></label>
                        <input class="form-control" @bind="newProduct.NameAr" placeholder="مثال: حليب كامل الدسم 1 لتر" />
                    </div>

                    <div class="form-group">
                        <label>الاسم (بالإنجليزية) <span style="font-size: 0.78rem; font-weight: normal; color: var(--text-secondary);">(مطلوب إن لم يُدخل الاسم بالعربية)</span></label>
                        <input class="form-control" @bind="newProduct.NameEn" placeholder="مثال: Full Cream Milk 1L" />
                    </div>
                </div>

                <!-- 2-Tier Unit Packaging Configuration -->
                <div style="background: rgba(99, 102, 241, 0.05); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 0.75rem; padding: 0.85rem 1rem; margin-bottom: 1.1rem;">
                    <div style="font-weight: 700; font-size: 0.88rem; color: var(--accent-indigo); margin-bottom: 0.6rem; display: flex; align-items: center; gap: 0.4rem;">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>تهيئة وحدات المنتج (الوحدة الصغرى / الوحدة الكبرى / معامل التحويل)</span>
                    </div>
                    <div class="grid-3" style="margin-bottom: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.82rem;">الوحدة الأساسية / الصغرى (Base Unit) <span style="color: var(--accent-red);">*</span></label>
                            <input class="form-control" @bind="newProduct.BaseUnit" list="common-base-units-list" placeholder="مثال: قطعة، كيس..." />
                            <datalist id="common-base-units-list">
                                <option value="قطعة"></option>
                                <option value="كيس"></option>
                                <option value="علبة"></option>
                                <option value="زجاجة"></option>
                                <option value="كانز"></option>
                                <option value="شريط"></option>
                                <option value="قرص"></option>
                                <option value="كيلوجرام"></option>
                                <option value="جرام"></option>
                                <option value="لتر"></option>
                            </datalist>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.82rem;">الوحدة الكبرى (Parent Unit)</label>
                            <input class="form-control" @bind="newProduct.ParentUnit" list="common-parent-units-list" placeholder="مثال: كرتونة، كيس كبير..." />
                            <datalist id="common-parent-units-list">
                                <option value="كرتونة"></option>
                                <option value="كيس"></option>
                                <option value="باكت"></option>
                                <option value="علبة"></option>
                                <option value="دستة"></option>
                                <option value="رول"></option>
                            </datalist>
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.82rem;">معامل التحويل (كم قطعة بالكرتونة؟) <span style="color: var(--accent-red);">*</span></label>
                            <input type="number" min="1" class="form-control" @bind="newProduct.ConversionFactor" @bind:after="SyncCartonPricesFromPiecePrices" placeholder="1" />
                        </div>
                    </div>
                    <div style="font-size: 0.8rem; color: var(--accent-indigo); background: rgba(99, 102, 241, 0.08); padding: 0.4rem 0.75rem; border-radius: 0.4rem; display: flex; align-items: center; justify-content: space-between;">
                        <span><i class="fa-solid fa-circle-info me-1"></i> 1 @(string.IsNullOrWhiteSpace(newProduct.ParentUnit) ? "كرتونة" : newProduct.ParentUnit) = <strong>@(newProduct.ConversionFactor > 0 ? newProduct.ConversionFactor : 1)</strong> @(string.IsNullOrWhiteSpace(newProduct.BaseUnit) ? "قطعة" : newProduct.BaseUnit)</span>
                        <span style="color: var(--text-secondary);">المخزون يُحسب دائماً بالوحدة الأساسية (@(string.IsNullOrWhiteSpace(newProduct.BaseUnit) ? "قطعة" : newProduct.BaseUnit))</span>
                    </div>
                </div>

                <!-- Carton Price Calculator & Matching (معاينة وحاسبة أسعار الكرتونة) -->
                @if (newProduct.ConversionFactor > 1)
                {
                    <div style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.75rem; padding: 0.9rem 1rem; margin-bottom: 1.1rem;">
                        <div style="font-weight: 700; font-size: 0.88rem; color: var(--accent-emerald); display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; flex-wrap: wrap; gap: 0.5rem;">
                            <div style="display: flex; align-items: center; gap: 0.4rem;">
                                <i class="fa-solid fa-calculator"></i>
                                <span>حاسبة أسعار الكرتونة والقطع (1 @(string.IsNullOrWhiteSpace(newProduct.ParentUnit) ? "كرتونة" : newProduct.ParentUnit) = @newProduct.ConversionFactor @(string.IsNullOrWhiteSpace(newProduct.BaseUnit) ? "قطعة" : newProduct.BaseUnit))</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" style="background: var(--accent-emerald); border-color: var(--accent-emerald); font-weight: 700; font-size: 0.8rem; padding: 0.35rem 0.85rem; display: inline-flex; align-items: center; gap: 0.35rem; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);" @onclick="ApplyCartonPricesToPiecePrices" title="تطبيق أسعار القطعة المدخلة في خانات أسعار المنتج">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                <span>مطابقة الأسعار</span>
                            </button>
                        </div>

                        <div class="grid-3" style="margin-bottom: 0.4rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.2rem;">سعر تكلفة شراء القطعة (جنيه)</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="calcPiecePurchaseCost" @bind:event="oninput" placeholder="تكلفة القطعة" style="border-color: rgba(59, 130, 246, 0.4);" />
                                <div style="font-size: 0.78rem; color: var(--accent-blue); margin-top: 0.3rem;">
                                    <span>سعر شراء الكرتونة: </span>
                                    <strong style="font-size: 0.92rem; color: #60a5fa;">@(calcCartonPurchaseCost.ToString("N2")) ج.م</strong>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.2rem;">سعر بيع القطعة قطاعي (جنيه)</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="calcPieceSellingPrice" @bind:event="oninput" placeholder="بيع القطعة قطاعي" style="border-color: rgba(16, 185, 129, 0.4);" />
                                <div style="font-size: 0.78rem; color: var(--accent-emerald); margin-top: 0.3rem;">
                                    <span>سعر بيع الكرتونة قطاعي: </span>
                                    <strong style="font-size: 0.92rem; color: #34d399;">@(calcCartonSellingPrice.ToString("N2")) ج.م</strong>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.2rem;">سعر بيع القطعة جملة (جنيه)</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="calcPieceWholesalePrice" @bind:event="oninput" placeholder="بيع القطعة جملة" style="border-color: rgba(245, 158, 11, 0.4);" />
                                <div style="font-size: 0.78rem; color: var(--accent-amber); margin-top: 0.3rem;">
                                    <span>سعر بيع الكرتونة جملة: </span>
                                    <strong style="font-size: 0.92rem; color: #fbbf24;">@(calcCartonWholesalePrice.ToString("N2")) ج.م</strong>
                                </div>
                            </div>
                        </div>

                        @if (priceMatchedSuccessNotice)
                        {
                            <div style="font-size: 0.78rem; color: var(--accent-emerald); margin-top: 0.3rem; display: flex; align-items: center; gap: 0.35rem;">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>تمت مطابقة ونقل الأسعار إلى حقول أسعار المنتج بنجاح!</span>
                            </div>
                        }
                    </div>
                }

                <div class="grid-2">
                    <div class="form-group">
                        <label>المورد (اختياري)</label>
                        <select class="form-select" @bind="supplierIdString">
                            <option value="">-- اختر المورد --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id.ToString()">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>نسبة الضريبة (%)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.TaxRate" placeholder="14" />
                    </div>
                </div>

                <div class="grid-3">
                    <div class="form-group">
                        <label>سعر التكلفة للقطعة (جنيه)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.PurchasePrice" @bind:after="OnPiecePriceChanged" />
                    </div>

                    <div class="form-group">
                        <label>سعر البيع للقطاعي / قطعة (جنيه) <span style="color: var(--accent-red);">*</span></label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.SellingPrice" @bind:after="OnPiecePriceChanged" />
                    </div>

                    <div class="form-group">
                        <label>سعر البيع للجملة / قطعة (جنيه)</label>
                        <input type="number" step="0.01" class="form-control" @bind="newProduct.WholesalePrice" @bind:after="OnPiecePriceChanged" />
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>حد إعادة الطلب (بالقطعة)</label>
                        <input type="number" class="form-control" @bind="newProduct.ReorderLevel" />
                    </div>

                    <div class="form-group">
                        <label>الحد الأقصى للمخزون (بالقطعة)</label>
                        <input type="number" class="form-control" @bind="newProduct.MaxStockLevel" />
                    </div>
                </div>

                <div class="form-group">
                    <label>الوصف والملاحظات</label>
                    <textarea class="form-control" rows="2" @bind="newProduct.Description" placeholder="ملاحظات اختيارية..."></textarea>
                </div>

                <!-- Unified Image Management for Add and Edit -->
                <div class="form-group">
                    <label>صورة المنتج (عرض وتغيير أو إزالة الصورة)</label>
                    <div class="file-upload-box" style="position: relative; padding: 1rem; text-align: center;">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <div style="text-align: center; margin-bottom: 0.5rem;">
                                <img src="@imagePreviewUrl" style="max-height: 110px; border-radius: 0.5rem; border: 1px solid var(--border-color); object-fit: contain;" alt="صورة المنتج" />
                                <div style="font-size: 0.75rem; color: var(--accent-emerald); font-weight: 600; margin-top: 0.25rem;">
                                    <i class="fa-solid fa-circle-check me-1"></i> تم تحديد صورة جديدة
                                </div>
                            </div>
                        }
                        else if (showEditModal && !string.IsNullOrEmpty(currentProductImageUrl))
                        {
                            <div style="text-align: center; margin-bottom: 0.5rem;">
                                <img src="@ApiClient.GetImageFullUrl(currentProductImageUrl)" style="max-height: 110px; border-radius: 0.5rem; border: 1px solid var(--border-color); object-fit: contain;" alt="الصورة الحالية للمنتج" />
                                <div style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 600; margin-top: 0.25rem;">الصورة الحالية للمنتج</div>
                            </div>
                        }
                        else
                        {
                            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 1.8rem; color: var(--accent-indigo); margin-bottom: 0.5rem;"></i>
                            <div style="font-size: 0.85rem; color: var(--text-secondary);">اضغط لاختيار صورة يدوية أو سيتم الاعتماد على الأيقونة الافتراضية</div>
                        }

                        <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.5rem; position: relative; z-index: 2;">
                            <label class="btn btn-sm btn-secondary" style="margin: 0; cursor: pointer;">
                                <i class="fa-solid fa-upload me-1"></i> @(string.IsNullOrEmpty(imagePreviewUrl) && (showEditModal && !string.IsNullOrEmpty(currentProductImageUrl)) ? "تغيير الصورة" : "اختيار صورة")
                                <InputFile OnChange="HandleFileSelected" accept="image/*" style="display: none;" />
                            </label>
                            @if (!string.IsNullOrEmpty(imagePreviewUrl) || (showEditModal && !string.IsNullOrEmpty(currentProductImageUrl)))
                            {
                                <button type="button" class="btn btn-sm btn-danger" @onclick="RemoveImage">
                                    <i class="fa-solid fa-trash me-1"></i> حذف الصورة
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(selectedFileName))
                        {
                            <div style="margin-top: 0.35rem; color: var(--accent-indigo); font-weight: 600; font-size: 0.8rem;">
                                <i class="fa-solid fa-file-image me-1"></i> @selectedFileName
                            </div>
                        }
                    </div>
                </div>

                <div style="display: flex; gap: 1.5rem; margin-top: 1rem; background: var(--bg-primary); padding: 0.75rem 1rem; border-radius: 0.5rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.IsActive" /> المنتج نشط
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.IsWeighable" /> صنف مباع بالميزان
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.85rem;">
                        <input type="checkbox" @bind="newProduct.TrackExpiry" /> تتبع تاريخ الصلاحية
                    </label>
                </div>

                @if (newProduct.TrackExpiry)
                {
                    <div style="background: rgba(245, 158, 11, 0.07); border: 1.5px solid rgba(245, 158, 11, 0.3); border-radius: 0.75rem; padding: 1rem; margin-top: 0.9rem;">
                        <div style="font-weight: 700; font-size: 0.88rem; color: var(--accent-amber); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                            <i class="fa-solid fa-calendar-check"></i>
                            <span>إعدادات مدة وتاريخ صلاحية المنتج</span>
                        </div>

                        <!-- Shelf Life Duration: Unit Selector + Count (العدد كم) -->
                        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; margin-bottom: 0.65rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.82rem; font-weight: 700; color: #fef08a;">
                                    وحدة مدة الصلاحية <span style="color: var(--accent-red);">*</span>
                                </label>
                                <select class="form-select" value="@shelfLifeUnit" @onchange="OnShelfLifeUnitChanged" style="font-weight: 600;">
                                    <option value="day">يوم (Days)</option>
                                    <option value="month">شهر (Months)</option>
                                    <option value="year">سنة (Years)</option>
                                </select>
                            </div>

                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.82rem; font-weight: 700; color: #fef08a;">
                                    العدد كم؟ (@(shelfLifeUnit == "year" ? "عدد السنوات" : (shelfLifeUnit == "month" ? "عدد الشهور" : "عدد الأيام"))) <span style="color: var(--accent-red);">*</span>
                                </label>
                                <input type="number" min="1" class="form-control" value="@shelfLifeCount" @onchange="OnShelfLifeCountChanged" @oninput="OnShelfLifeCountInput" placeholder="@(shelfLifeUnit == "year" ? "مثال: 2 سنة" : (shelfLifeUnit == "month" ? "مثال: 6 شهور" : "مثال: 30 يوم"))" style="font-weight: 700; font-size: 1rem; color: var(--accent-emerald);" />
                            </div>
                        </div>

                        <!-- Live Calculation Summary Badge -->
                        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.45rem; padding: 0.5rem 0.85rem; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; flex-wrap: wrap; gap: 0.4rem;">
                            <div style="color: #34d399;">
                                <i class="fa-solid fa-clock-rotate-left me-1"></i>
                                <span>مدة الصلاحية المحددة: <strong style="color: #fbbf24; font-size: 0.95rem;">@shelfLifeCount @(shelfLifeUnit == "year" ? "سنة" : (shelfLifeUnit == "month" ? "شهر" : "يوم"))</strong></span>
                                @if (shelfLifeUnit != "day")
                                {
                                    <span style="color: #a7f3d0;"> (محسوبة بالنظام: <strong>@newProduct.ShelfLifeDays يوم</strong>)</span>
                                }
                            </div>
                            <small style="color: var(--text-secondary); font-size: 0.75rem;">تُستخدم لاقتراح تاريخ الانتهاء تلقائياً عند توريد البضاعة</small>
                        </div>

                        <!-- Expiry Alert Settings: Unit + Count -->
                        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.75rem; align-items: flex-end; border-top: 1px dashed rgba(245, 158, 11, 0.25); padding-top: 0.75rem;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary);">
                                    وحدة تنبيه قرب انتهاء الصلاحية
                                </label>
                                <select class="form-select" value="@expiryAlertUnit" @onchange="OnExpiryAlertUnitChanged">
                                    <option value="day">أيام قبل الانتهاء</option>
                                    <option value="month">شهور قبل الانتهاء</option>
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary);">
                                    العدد كم؟ (تنبيه مسبق قبل @(expiryAlertUnit == "month" ? "كم شهر؟" : "كم يوم؟"))
                                </label>
                                <input type="number" min="1" class="form-control" value="@expiryAlertCount" @onchange="OnExpiryAlertCountChanged" @oninput="OnExpiryAlertCountInput" placeholder="3" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء [Esc]</button>
                <button class="btn btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>@(showEditModal ? "تحديث المنتج [Enter]" : "حفظ المنتج [Enter]")</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && productToDelete != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 440px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: var(--accent-red);">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> حذف المنتج
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 1rem;">هل أنت تأكد من رغبتك في حذف المنتج <strong style="color: var(--text-primary);">@productToDelete.NameAr</strong> (@productToDelete.Barcode)؟</p>
                <p style="font-size: 0.85rem; color: var(--text-muted);">لا يمكن التراجع عن هذا الإجراء بعد تنفيذه.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-danger" @onclick="ExecuteDeleteProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-trash-can me-1"></i> <span>تأكيد الحذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Excel Import Modal -->
@if (showImportModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 680px; max-width: 95vw;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-file-excel me-2" style="color: #107c41;"></i> استيراد منتجات من ملف إكسيل
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 75vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(importErrorMessage))
                {
                    <div style="background: rgba(239, 68, 68, 0.15); border-right: 4px solid var(--accent-red); color: var(--accent-red); padding: 0.75rem 1rem; border-radius: 0.4rem; margin-bottom: 1rem; font-size: 0.9rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @importErrorMessage
                    </div>
                }

                <div style="background: rgba(16, 124, 65, 0.1); border: 1px solid rgba(16, 124, 65, 0.3); border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1.15rem; display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">
                        <i class="fa-solid fa-circle-info text-primary me-1"></i>
                        <span>يمكنك تحميل نموذج الإكسيل المعتمد المتوافق مع كافة بيانات المنتجات:</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" style="background: rgba(16, 124, 65, 0.2); border-color: #107c41; color: #107c41; font-weight: 700; display: flex; align-items: center; gap: 0.4rem;" @onclick="DownloadExcelTemplate">
                        <i class="fa-solid fa-download"></i>
                        <span>تحميل نموذج الإكسيل (.xlsx)</span>
                    </button>
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label class="form-label" style="font-weight: 600;">اختر ملف Excel (.xlsx, .xls) أو حزمة ZIP تحتوي على صور المنتجات (.zip)</label>
                    <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls,.csv,.zip" class="form-control" style="padding: 0.5rem;" />
                    @if (!string.IsNullOrEmpty(selectedImportFileName))
                    {
                        <div style="margin-top: 0.4rem; font-size: 0.85rem; color: var(--accent-emerald);">
                            <i class="fa-solid fa-file-circle-check me-1"></i> الملف المحدد: <strong>@selectedImportFileName</strong> (@(selectedImportFileBytes?.Length / 1024 ?? 0) KB)
                        </div>
                    }
                </div>

                <div style="background: rgba(255,255,255,0.03); padding: 0.85rem; border-radius: 0.5rem; border: 1px dashed rgba(255,255,255,0.1); margin-bottom: 1.25rem;">
                    <label style="display: flex; align-items: center; gap: 0.6rem; cursor: pointer; font-size: 0.9rem; margin-bottom: 0.3rem; font-weight: 600;">
                        <input type="checkbox" @bind="updateExistingInImport" style="width: 1.1rem; height: 1.1rem;" />
                        تحديث بيانات المنتج إذا كان الباركود موجواً بالفعل في الكتالوج
                    </label>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0; padding-right: 1.7rem;">
                        عند تفعيل هذا الخيار، سيتم تعديل أسعار واسم وتصنيف المنتج الموجود مسبقاً بنفس الباركود بدلاً من تخطيه.
                    </p>
                </div>

                @if (importResult != null)
                {
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                        <h4 style="font-size: 0.95rem; margin-bottom: 0.75rem; color: var(--text-primary);">ملخص نتيجة الاستيراد:</h4>
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-bottom: 1rem;">
                            <div style="background: rgba(255,255,255,0.05); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--text-muted);">إجمالي الصفوف</div>
                                <div style="font-size: 1.3rem; font-weight: 700;">@importResult.TotalRows</div>
                            </div>
                            <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--accent-emerald);">تم استيرادها بنجاح</div>
                                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-emerald);">@importResult.SuccessCount</div>
                            </div>
                            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.75rem; border-radius: 0.5rem; text-align: center;">
                                <div style="font-size: 0.8rem; color: var(--accent-red);">صفوف بها أخطاء</div>
                                <div style="font-size: 1.3rem; font-weight: 700; color: var(--accent-red);">@importResult.ErrorCount</div>
                            </div>
                        </div>

                        @if (importResult.Errors != null && importResult.Errors.Any())
                        {
                            <h5 style="font-size: 0.85rem; color: var(--accent-red); margin-bottom: 0.5rem;">
                                <i class="fa-solid fa-list-check me-1"></i> قائمة الصفوف غير المستوردة وأسباب الخطأ:
                            </h5>
                            <div style="max-height: 200px; overflow-y: auto; border: 1px solid rgba(255,255,255,0.1); border-radius: 0.4rem;">
                                <table class="data-table" style="font-size: 0.8rem;">
                                    <thead>
                                        <tr>
                                            <th>الصف</th>
                                            <th>الباركود</th>
                                            <th>الاسم</th>
                                            <th>سبب الخطأ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var err in importResult.Errors)
                                        {
                                            <tr>
                                                <td>#@err.RowNumber</td>
                                                <td><code>@err.Barcode</code></td>
                                                <td>@err.ProductName</td>
                                                <td style="color: var(--accent-red);">@err.ErrorMessage</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إغلاق</button>
                <button class="btn btn-primary" style="background: #107c41; border-color: #107c41;" @onclick="ExecuteImportExcel" disabled="@(isSaving || selectedImportFileBytes == null)">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الاستيراد...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-upload me-1"></i> <span>بدء الاستيراد الان</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Barcode Printing Modal -->
@if (showBarcodeModal && selectedProductForBarcode is not null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-barcode me-2" style="color: var(--accent-indigo);"></i>
                    طباعة ملصق الباركود للمنتج
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 1.25rem; text-align: center;">
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">
                        @selectedProductForBarcode.NameAr
                    </h4>
                    <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
                        الباركود: <code style="font-weight: 700; color: var(--accent-blue);">@selectedProductForBarcode.Barcode</code>
                        | السعر: <strong style="color: var(--accent-emerald);">@selectedProductForBarcode.SellingPrice.ToString("N2") ج.م</strong>
                    </p>

                    <!-- Live Barcode SVG Preview Box -->
                    <div style="background: #ffffff; border-radius: 0.5rem; padding: 0.75rem; display: inline-block; margin: 0 auto; box-shadow: var(--shadow-sm);">
                        <svg id="preview-barcode-svg"></svg>
                    </div>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>عدد الملصقات المطلوب طباعتها</label>
                        <input type="number" min="1" max="500" class="form-control" @bind="barcodePrintQty" />
                    </div>

                    <div class="form-group">
                        <label>اسم المحل على الملصق</label>
                        <input class="form-control" @bind="barcodeStoreName" placeholder="اسم المحل..." />
                    </div>
                </div>

                <div class="form-group" style="margin-top: 0.75rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                        <input type="checkbox" @bind="barcodeShowPrice" style="width: 18px; height: 18px;" />
                        <span>إظهار سعر البيع على ملصق الباركود</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer" style="display: flex; justify-content: space-between;">
                <button class="btn btn-secondary" @onclick="CloseModals">إلغاء</button>
                <button class="btn btn-primary" style="padding: 0.65rem 1.5rem; font-weight: 700;" @onclick="ExecutePrintBarcode">
                    <i class="fa-solid fa-print me-1"></i> طباعة الملصقات (@barcodePrintQty)
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Product Confirmation Modal -->
@if (showDeleteModal && productToDelete != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 500px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #ef4444;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> تأكيد حذف المنتج
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; font-size: 0.9rem;">
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">اسم المنتج:</span>
                        <strong style="color: var(--text-primary);">@productToDelete.NameAr</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">الباركود:</span>
                        <code>@productToDelete.Barcode</code>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">سعر البيع:</span>
                        <strong style="color: var(--accent-emerald);">@productToDelete.SellingPrice.ToString("N2") ج.م</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">الرصيد بالمخزن:</span>
                        <strong style="color: var(--accent-amber);">@productToDelete.QuantityInStock.ToString("N0") @(productToDelete.UnitSymbol ?? "قطع")</strong>
                    </div>
                </div>

                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; line-height: 1.5;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <strong>تحذير الأثر:</strong> سيتم حذف هذا المنتج نهائياً من قاعدة البيانات. لن تتمكن من بيعه في الكاشير أو إضافته في فواتير جديدة، مع بقاء سجلات الفواتير السابقة مسجلة لأغراض التدقيق.
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-danger" @onclick="ExecuteDeleteProduct" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-trash me-1"></i> <span>نعم، احذف المنتج نهائياً</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool CanManageProducts =>
        string.Equals(AuthState.UserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Cashier", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Administrator", StringComparison.OrdinalIgnoreCase);

    private List<ProductDto> products = new();
    private List<ProductDto> filtered = new();
    private List<CategoryDto> categories = new();
    private List<UnitDto> units = new();
    private List<SupplierDto> suppliers = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<ProductDto> PagedProducts => filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private string search = string.Empty;
    private string quickScanBarcode = string.Empty;
    private bool isFetchingOnline = false;
    private bool showAddModal = false;
    private bool showEditModal = false;
    private bool showDeleteModal = false;
    private bool showBarcodeModal = false;
    private ProductDto? selectedProductForBarcode;
    private int barcodePrintQty = 1;
    private string barcodeStoreName = "سوبرماركت";
    private bool barcodeShowPrice = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;

    private Guid editingProductId = Guid.Empty;
    private ProductDto? productToDelete;
    private string categoryIdString = string.Empty;
    private string unitIdString = string.Empty;
    private string supplierIdString = string.Empty;

    private byte[]? selectedImageBytes;
    private string? selectedFileName;
    private string? imagePreviewUrl;
    private string? currentProductImageUrl;
    private bool imageRemoved = false;

    // Multi-Unit Packaging State
    private void RemoveImage()
    {
        selectedImageBytes = null;
        selectedFileName = null;
        imagePreviewUrl = null;
        currentProductImageUrl = null;
        imageRemoved = true;
    }

    private CreateProductFormModel newProduct = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusElementAsync("product-quick-scan-barcode", 50);
        }
    }

    private async Task FocusElementAsync(string elementId, int delay = 0)
    {
        try
        {
            await JS.InvokeVoidAsync("focusElementById", elementId, delay);
        }
        catch { }
    }

    private async Task LoadData()
    {
        products = await ApiClient.GetProductsAsync();
        categories = await ApiClient.GetCategoriesAsync();
        units = await ApiClient.GetUnitsAsync();
        suppliers = await ApiClient.GetSuppliersAsync();
        Filter();
    }

    private void Filter()
    {
        currentPage = 1;
        if (string.IsNullOrWhiteSpace(search))
        {
            filtered = products.ToList();
        }
        else
        {
            filtered = products.Where(p =>
                p.NameAr.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                p.NameEn.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                p.Barcode.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filtered.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private async Task HandleQuickScanBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(quickScanBarcode))
        {
            var code = quickScanBarcode.Trim();
            quickScanBarcode = string.Empty;

            var existing = products.FirstOrDefault(p => string.Equals(p.Barcode, code, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
            {
                existing = await ApiClient.GetProductByBarcodeAsync(code);
            }

            if (existing is not null)
            {
                OpenEditModal(existing);
            }
            else
            {
                await OpenAddModalWithBarcodeAsync(code);
            }
        }
    }

    private async Task OpenAddModalWithBarcodeAsync(string barcode)
    {
        OpenAddModal();
        newProduct.Barcode = barcode;
        await FetchOnlineProductInfo();
    }

    private async Task FetchOnlineProductInfo()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Barcode))
        {
            errorMessage = "الرجاء أدخل أو امسح الباركود أولاً قبل البحث أونلاين.";
            return;
        }

        isFetchingOnline = true;
        errorMessage = string.Empty;

        var result = await ApiClient.LookupProductOnlineAsync(newProduct.Barcode);
        isFetchingOnline = false;

        if (result is not null)
        {
            if (!string.IsNullOrWhiteSpace(result.NameAr)) newProduct.NameAr = result.NameAr;
            if (!string.IsNullOrWhiteSpace(result.NameEn)) newProduct.NameEn = result.NameEn;

            if (result.ImageBytes is not null && result.ImageBytes.Length > 0)
            {
                selectedImageBytes = result.ImageBytes;
                selectedFileName = $"{newProduct.Barcode}_online.jpg";
                var base64 = Convert.ToBase64String(result.ImageBytes);
                imagePreviewUrl = $"data:image/jpeg;base64,{base64}";
            }
        }
        else
        {
            errorMessage = "لم يتوفر هذا الباركود في قاعدة البيانات العالمية المفتوحة. يمكنك أدخال اسم المنتج وسعر البيع يدوياً بسهولة.";
        }
    }

    // Carton Price Calculator State
    private decimal calcPiecePurchaseCost = 0;
    private decimal calcPieceSellingPrice = 0;
    private decimal calcPieceWholesalePrice = 0;

    private decimal calcCartonPurchaseCost => (newProduct.ConversionFactor > 0 && calcPiecePurchaseCost > 0)
        ? Math.Round(calcPiecePurchaseCost * newProduct.ConversionFactor, 2)
        : 0;

    private decimal calcCartonSellingPrice => (newProduct.ConversionFactor > 0 && calcPieceSellingPrice > 0)
        ? Math.Round(calcPieceSellingPrice * newProduct.ConversionFactor, 2)
        : 0;

    private decimal calcCartonWholesalePrice => (newProduct.ConversionFactor > 0 && calcPieceWholesalePrice > 0)
        ? Math.Round(calcPieceWholesalePrice * newProduct.ConversionFactor, 2)
        : 0;

    private bool priceMatchedSuccessNotice = false;

    private void ApplyCartonPricesToPiecePrices()
    {
        if (newProduct.ConversionFactor <= 1) return;

        if (calcPiecePurchaseCost > 0)
            newProduct.PurchasePrice = calcPiecePurchaseCost;

        if (calcPieceSellingPrice > 0)
            newProduct.SellingPrice = calcPieceSellingPrice;

        if (calcPieceWholesalePrice > 0)
            newProduct.WholesalePrice = calcPieceWholesalePrice;

        priceMatchedSuccessNotice = true;
    }

    private void SyncCartonPricesFromPiecePrices()
    {
        calcPiecePurchaseCost = newProduct.PurchasePrice;
        calcPieceSellingPrice = newProduct.SellingPrice;
        calcPieceWholesalePrice = newProduct.WholesalePrice;
        priceMatchedSuccessNotice = false;
    }

    private void OnPiecePriceChanged()
    {
        SyncCartonPricesFromPiecePrices();
    }

    // Shelf Life & Expiry Unit / Count State
    private string shelfLifeUnit = "month";
    private int shelfLifeCount = 1;
    private string expiryAlertUnit = "day";
    private int expiryAlertCount = 3;

    private void OnShelfLifeUnitChanged(ChangeEventArgs e)
    {
        shelfLifeUnit = e.Value?.ToString() ?? "month";
        RecalculateShelfLifeDays();
    }

    private void OnShelfLifeCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            shelfLifeCount = Math.Max(1, val);
        }
        RecalculateShelfLifeDays();
    }

    private void OnShelfLifeCountInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            shelfLifeCount = Math.Max(1, val);
            RecalculateShelfLifeDays();
        }
    }

    private void RecalculateShelfLifeDays()
    {
        int count = Math.Max(1, shelfLifeCount);
        newProduct.ShelfLifeDays = shelfLifeUnit switch
        {
            "year" => count * 365,
            "month" => count * 30,
            _ => count
        };
    }

    private void OnExpiryAlertUnitChanged(ChangeEventArgs e)
    {
        expiryAlertUnit = e.Value?.ToString() ?? "day";
        RecalculateExpiryAlertDays();
    }

    private void OnExpiryAlertCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            expiryAlertCount = Math.Max(1, val);
        }
        RecalculateExpiryAlertDays();
    }

    private void OnExpiryAlertCountInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            expiryAlertCount = Math.Max(1, val);
            RecalculateExpiryAlertDays();
        }
    }

    private void RecalculateExpiryAlertDays()
    {
        int count = Math.Max(1, expiryAlertCount);
        newProduct.ExpiryAlertDays = expiryAlertUnit switch
        {
            "month" => count * 30,
            _ => count
        };
    }

