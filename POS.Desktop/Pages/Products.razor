    private void GenerateBarcode()
    {
        newProduct.Barcode = $"{Random.Shared.Next(6290000, 6299999)}{Random.Shared.Next(10000, 99999)}";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            selectedFileName = file.Name;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            selectedImageBytes = ms.ToArray();

            var base64 = Convert.ToBase64String(selectedImageBytes);
            imagePreviewUrl = $"data:{file.ContentType};base64,{base64}";
        }
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(newProduct.Barcode))
        {
            errorMessage = "الرجاء إدخال أو توليد الباركود.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newProduct.NameAr) && string.IsNullOrWhiteSpace(newProduct.NameEn))
        {
            errorMessage = "الرجاء إدخال اسم المنتج (بالعربية أو بالإنجليزية على الأقل).";
            return;
        }

        if (string.IsNullOrWhiteSpace(newProduct.NameAr))
        {
            newProduct.NameAr = newProduct.NameEn;
        }
        else if (string.IsNullOrWhiteSpace(newProduct.NameEn))
        {
            newProduct.NameEn = newProduct.NameAr;
        }

        if (!Guid.TryParse(categoryIdString, out var categoryId) || categoryId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار تصنيف صحيح.";
            return;
        }

        Guid unitId = Guid.Empty;
        if (!string.IsNullOrWhiteSpace(newProduct.BaseUnit))
        {
            var matched = units.FirstOrDefault(u => string.Equals(u.NameAr?.Trim(), newProduct.BaseUnit.Trim(), StringComparison.OrdinalIgnoreCase));
            if (matched != null)
            {
                unitId = matched.Id;
            }
        }
        if (unitId == Guid.Empty)
        {
            unitId = units.FirstOrDefault()?.Id ?? (Guid.TryParse(unitIdString, out var uId) ? uId : Guid.Parse("00000000-0000-0000-0000-000000000001"));
        }

        newProduct.CategoryId = categoryId;
        newProduct.UnitId = unitId;
        newProduct.SupplierId = Guid.TryParse(supplierIdString, out var supplierId) ? supplierId : null;

        newProduct.Description = PackagingUnitHelper.CleanDescription(newProduct.Description);

        if (newProduct.TrackExpiry)
        {
            RecalculateShelfLifeDays();
            RecalculateExpiryAlertDays();
        }
        else
        {
            newProduct.ShelfLifeDays = 0;
            newProduct.ExpiryAlertDays = 0;
        }

        isSaving = true;
        errorMessage = string.Empty;

        if (showEditModal)
        {
            string? targetImageUrl = null;
            if (selectedImageBytes != null && !string.IsNullOrWhiteSpace(selectedFileName))
            {
                var (uploadedUrl, uploadErr) = await ApiClient.UploadProductImageAsync(selectedImageBytes, selectedFileName);
                if (!string.IsNullOrEmpty(uploadErr))
                {
                    errorMessage = $"فشل رفع الصورة الجديدة: {uploadErr}";
                    isSaving = false;
                    return;
                }
                targetImageUrl = uploadedUrl;
            }
            else if (imageRemoved)
            {
                targetImageUrl = string.Empty;
            }
            else
            {
                targetImageUrl = currentProductImageUrl;
            }

            var updateModel = new UpdateProductCommandModel(
                editingProductId,
                newProduct.Barcode,
                newProduct.NameAr,
                newProduct.NameEn,
                newProduct.Description,
                newProduct.CategoryId,
                newProduct.UnitId,
                newProduct.SupplierId,
                newProduct.PurchasePrice,
                newProduct.SellingPrice,
                newProduct.WholesalePrice,
                newProduct.ReorderLevel,
                newProduct.MaxStockLevel,
                newProduct.IsWeighable,
                newProduct.IsActive,
                newProduct.TrackExpiry,
                newProduct.TaxRate,
                targetImageUrl,
                newProduct.BaseUnit,
                newProduct.ParentUnit,
                newProduct.ConversionFactor,
                newProduct.ShelfLifeDays,
                newProduct.ExpiryAlertDays);

            var (success, error) = await ApiClient.UpdateProductAsync(updateModel);
            isSaving = false;

            if (success)
            {
                CloseModals();
                await LoadData();
            }
            else
            {
                errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل تحديث المنتج.";
            }
        }
        else
        {
            var (result, error) = await ApiClient.CreateProductAsync(newProduct, selectedImageBytes, selectedFileName);
            isSaving = false;

            if (result.HasValue && result.Value != Guid.Empty)
            {
                CloseModals();
                await LoadData();
            }
            else
            {
                errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل حفظ المنتج. الرجاء التحقق من مدخلاتك أو سجلات النظام.";
            }
        }
    }

    private async Task ExecuteDeleteProduct()
    {
        if (productToDelete == null) return;

        isSaving = true;
        errorMessage = string.Empty;
        var (success, error) = await ApiClient.DeleteProductAsync(productToDelete.Id);
        isSaving = false;

        if (success)
        {
            CloseModals();
            await LoadData();
        }
        else
        {
            errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل حذف المنتج من قاعدة البيانات.";
        }
    }

    private string GetImageFullUrl(string? relativeOrUrl)
    {
        if (string.IsNullOrWhiteSpace(relativeOrUrl)) return string.Empty;
        return ApiClient.GetImageFullUrl(relativeOrUrl);
    }

    private bool showImportModal = false;
    private bool updateExistingInImport = false;
    private byte[]? selectedImportFileBytes;
    private string? selectedImportFileName;
    private string importErrorMessage = string.Empty;
    private ProductImportResultDto? importResult;

    private void OpenImportModal()
    {
        selectedImportFileBytes = null;
        selectedImportFileName = null;
        importErrorMessage = string.Empty;
        importResult = null;
        updateExistingInImport = false;
        showImportModal = true;
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importErrorMessage = string.Empty;
        importResult = null;
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 100 * 1024 * 1024)
            {
                importErrorMessage = "حجم الملف يتجاوز الحد الأقصى المسموح به (100 ميجابايت).";
                return;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                selectedImportFileBytes = ms.ToArray();
                selectedImportFileName = file.Name;
            }
            catch (Exception ex)
            {
                importErrorMessage = $"خطأ في قراءة الملف: {ex.Message}";
            }
        }
    }

    private async Task ExecuteImportExcel()
    {
        if (selectedImportFileBytes == null || string.IsNullOrEmpty(selectedImportFileName))
        {
            importErrorMessage = "الرجاء اختيار ملف إكسيل أولاً.";
            return;
        }

        isSaving = true;
        importErrorMessage = string.Empty;
        importResult = null;

        var (res, err) = await ApiClient.ImportProductsExcelAsync(
            selectedImportFileBytes,
            selectedImportFileName,
            updateExistingInImport);

        isSaving = false;

        if (res != null)
        {
            importResult = res;
            await LoadData();
        }
        else
        {
            importErrorMessage = !string.IsNullOrEmpty(err) ? err : "فشل استيراد ملف الإكسيل.";
        }
    }

    private async Task DownloadExcelTemplate()
    {
        var bytes = await ApiClient.DownloadProductExcelTemplateAsync();
        if (bytes != null && bytes.Length > 0)
        {
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync(
                "downloadFileFromBase64",
                "Products_Import_Template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        else
        {
            errorMessage = "فشل تحميل قالب الإكسيل من السيرفر.";
        }
    }

