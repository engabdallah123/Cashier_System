    private void OpenEditModal(ProductDto prod)
    {
        editingProductId = prod.Id;
        currentProductImageUrl = prod.ImageUrl;
        selectedImageBytes = null;
        selectedFileName = null;
        imagePreviewUrl = null;
        imageRemoved = false;

        newProduct = new CreateProductFormModel
        {
            Barcode = prod.Barcode,
            NameAr = prod.NameAr,
            NameEn = prod.NameEn,
            Description = PackagingUnitHelper.CleanDescription(prod.Description),
            CategoryId = prod.CategoryId,
            UnitId = prod.UnitId,
            SupplierId = prod.SupplierId,
            BaseUnit = string.IsNullOrWhiteSpace(prod.BaseUnit) ? "قطعة" : prod.BaseUnit,
            ParentUnit = string.IsNullOrWhiteSpace(prod.ParentUnit) ? "كرتونة" : prod.ParentUnit,
            ConversionFactor = prod.ConversionFactor > 0 ? prod.ConversionFactor : 1,
            ShelfLifeDays = prod.ShelfLifeDays,
            ExpiryAlertDays = prod.ExpiryAlertDays > 0 ? prod.ExpiryAlertDays : 3,
            PurchasePrice = prod.PurchasePrice,
            SellingPrice = prod.SellingPrice,
            WholesalePrice = prod.WholesalePrice,
            ReorderLevel = prod.ReorderLevel,
            MaxStockLevel = prod.MaxStockLevel,
            IsWeighable = prod.IsWeighable,
            IsActive = prod.IsActive,
            TrackExpiry = prod.TrackExpiry,
            TaxRate = prod.TaxRate
        };

        if (prod.ShelfLifeDays > 0)
        {
            if (prod.ShelfLifeDays % 365 == 0)
            {
                shelfLifeUnit = "year";
                shelfLifeCount = prod.ShelfLifeDays / 365;
            }
            else if (prod.ShelfLifeDays % 30 == 0)
            {
                shelfLifeUnit = "month";
                shelfLifeCount = prod.ShelfLifeDays / 30;
            }
            else
            {
                shelfLifeUnit = "day";
                shelfLifeCount = prod.ShelfLifeDays;
            }
        }
        else
        {
            shelfLifeUnit = "month";
            shelfLifeCount = 1;
        }

        if (prod.ExpiryAlertDays > 0)
        {
            if (prod.ExpiryAlertDays % 30 == 0 && prod.ExpiryAlertDays >= 30)
            {
                expiryAlertUnit = "month";
                expiryAlertCount = prod.ExpiryAlertDays / 30;
            }
            else
            {
                expiryAlertUnit = "day";
                expiryAlertCount = prod.ExpiryAlertDays;
            }
        }
        else
        {
            expiryAlertUnit = "day";
            expiryAlertCount = 3;
        }
        RecalculateShelfLifeDays();
        RecalculateExpiryAlertDays();

        categoryIdString = prod.CategoryId.ToString();
        unitIdString = prod.UnitId.ToString();
        supplierIdString = prod.SupplierId?.ToString() ?? string.Empty;

        SyncCartonPricesFromPiecePrices();

        errorMessage = string.Empty;
        showEditModal = true;
        showAddModal = false;
        _ = FocusElementAsync("product-modal-barcode-input", 100);
    }

