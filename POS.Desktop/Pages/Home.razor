@page "/"
@page "/home"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using global::POS.Desktop.Services.Auth
@using global::POS.Desktop.Services.State
@attribute [Authorize]
@implements IDisposable
@inject CustomAuthStateProvider AuthState
@inject ShiftStateContainer ShiftState
@inject StoreStateContainer StoreState
@inject CalculatorStateContainer CalcState
@inject NavigationManager Nav

<div class="home-container">
    <!-- Top Hero Welcome Banner & Digital Clock -->
    <div class="home-hero-card">
        <div class="home-user-greeting">
            <h1>
                <i class="fa-solid @GreetingIcon me-1" style="color: var(--accent-amber);"></i>
                <span>@GreetingTitle، @(AuthState.UserFullName ?? "مستخدم الكاشير")</span>
            </h1>
            <p>
                <i class="fa-solid fa-store me-1" style="color: var(--accent-indigo);"></i>
                <span>نظام الكاشير والمبيعات السريع</span>
                <span class="badge badge-blue ms-2" style="font-size: 0.75rem;">@(IsAdminOrManager ? "مدير النظام" : "كاشير")</span>
            </p>
        </div>

        <!-- Professional Live Clock Box -->
        <div class="home-clock-wrapper">
            <div class="home-live-time">
                <span>@ClockHoursMinutes</span>
                <span class="seconds-badge">: @ClockSeconds</span>
                <span style="font-size: 0.9rem; margin-right: 0.25rem;">@ClockAmPm</span>
            </div>
            <div class="home-live-date">
                <i class="fa-solid fa-calendar-days me-1" style="color: var(--accent-blue);"></i>
                <span>@FormattedArabicDate</span>
            </div>
        </div>
    </div>

    <!-- Live Shift Status Widget -->
    <div class="shift-status-widget">
        <div class="shift-status-info">
            <div class="shift-status-icon @(ShiftState.IsShiftOpen ? "open" : "closed")">
                <i class="fa-solid @(ShiftState.IsShiftOpen ? "fa-lock-open" : "fa-lock")"></i>
            </div>
            <div>
                <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.1rem;">
                    حالة الوردية: 
                    <span style="color: @(ShiftState.IsShiftOpen ? "var(--accent-emerald)" : "var(--accent-red)"); font-weight: 800;">
                        @(ShiftState.IsShiftOpen ? "الوردية مفتوحة وسارية" : "الوردية مغلقة حالياً")
                    </span>
                </h4>
                <p style="font-size: 0.8rem; color: var(--text-secondary);">
                    @(ShiftState.IsShiftOpen ? $"رقم الوردية الحالية: #{ShiftState.ShiftId.ToString()[..8]} | جاهزة لاستقبال المبيعات" : "يجب فتح وردية جديدة قبل البدء في عمليات البيع")
                </p>
            </div>
        </div>
        <div style="display: flex; gap: 0.6rem; align-items: center;">
        
            <NavLink href="shifts" class="@ShiftButtonClass" style="padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 700; display: flex; align-items: center; gap: 0.4rem;">
                <i class="fa-solid fa-clock-rotate-left"></i>
                <span>@(ShiftState.IsShiftOpen ? "تقفيل الوردية" : "فتح وردية جديدة")</span>
            </NavLink>
        </div>
    </div>

    <!-- Keyboard Navigation Matrix (Alt + First Letter) -->
    <div style="flex: 1; display: flex; flex-direction: column; justify-content: center;">
        <div class="home-section-header" style="margin-bottom: 0.6rem;">
            <div class="home-section-title" style="font-size: 1.05rem;">
                <i class="fa-solid fa-keyboard"></i>
                <span>اختصارات الكيبورد الفورية</span>
            </div>
            <span style="font-size: 0.8rem; color: var(--accent-indigo); font-weight: 700;">اضغط الاختصار للتنقل المباشر بدون ماوس</span>
        </div>

        <div class="shortcuts-wrapper" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 0.85rem;">
            <!-- Main Operational Shortcuts Card (Right - 6 Items) -->
            <div class="shortcuts-card" style="padding: 1rem;">
                <div class="shortcuts-card-header" style="padding-bottom: 0.5rem; margin-bottom: 0.75rem;">
                    <div class="shortcuts-card-title" style="font-size: 0.95rem;">
                        <i class="fa-solid fa-bolt" style="color: var(--accent-amber);"></i>
                        <span>الشاشات الرئيسية والبيع</span>
                    </div>
                    <span class="badge badge-indigo" style="font-size: 0.7rem;">أوامر فورية</span>
                </div>

                <div class="shortcuts-list" style="gap: 0.5rem;">
                    <!-- Monthly Sales Report Shortcut Item (Clickable) -->
                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("monthly-report")' title="انقر لفتح تقرير ونتيجة المبيعات الشهرية">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-calendar-days" style="color: var(--accent-amber);"></i>
                            <span>نتيجة المبيعات الشهرية (Monthly Report)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>Y</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("pos")' title="انقر لفتح شاشة البيع">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-cash-register" style="color: var(--accent-blue);"></i>
                            <span>شاشة البيع والمبيعات (POS)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>P</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("products")' title="انقر لفتح المنتجات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-boxes-stacked" style="color: var(--accent-indigo);"></i>
                            <span>المنتجات والمخزون (Montajat)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>M</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("price-check")' title="انقر لاستعلام الأسعار">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-barcode" style="color: var(--accent-purple);"></i>
                            <span>استعلام الأسعار (Barcode / Price Check)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>B</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("shifts")' title="انقر لفتح الورديات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-clock-rotate-left" style="color: var(--accent-amber);"></i>
                            <span>إدارة الورديات الخزينة (Shifts)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>S</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("returns/sales")' title="انقر لفتح مرتجع المبيعات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-rotate-left" style="color: var(--accent-purple);"></i>
                            <span>مرتجع المبيعات (Sales Returns)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>R</kbd></div>
                    </div>
                </div>
            </div>

            <!-- More Navigation Shortcuts Card (Left - 6 Items) -->
            <div class="shortcuts-card" style="padding: 1rem;">
                <div class="shortcuts-card-header" style="padding-bottom: 0.5rem; margin-bottom: 0.75rem;">
                    <div class="shortcuts-card-title" style="font-size: 0.95rem;">
                        <i class="fa-solid fa-truck-ramp-box" style="color: var(--accent-blue);"></i>
                        <span>بقية الأقسام والتحكم</span>
                    </div>
                    <span class="badge badge-green" style="font-size: 0.7rem;">عمليات سريعة</span>
                </div>

                <div class="shortcuts-list" style="gap: 0.5rem;">
                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("sales")' title="انقر لفتح سجل المبيعات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-receipt" style="color: var(--accent-blue);"></i>
                            <span>سجل المبيعات (Sales List)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>L</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("purchases")' title="انقر لفتح شاشة المشتريات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-truck-field" style="color: var(--accent-emerald);"></i>
                            <span>شاشة المشتريات (Purchases)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>U</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("expenses")' title="انقر لفتح المصروفات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-wallet" style="color: var(--accent-red);"></i>
                            <span>شاشة المصروفات (Expenses)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>E</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("returns/purchases")' title="انقر لفتح مرتجع المشتريات">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-truck-arrow-right" style="color: var(--accent-blue);"></i>
                            <span>مرتجع المشتريات (Purchase Returns)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>T</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("debts")' title="انقر لفتح فواتير الديون">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-hand-holding-dollar" style="color: var(--accent-red);"></i>
                            <span>فواتير الديون والتحصيل (Debts)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>D</kbd></div>
                    </div>

                    <div class="shortcut-item" style="padding: 0.45rem 0.75rem; cursor: pointer;" @onclick='() => Nav.NavigateTo("home")' title="انقر للعودة للرئيسية">
                        <div class="shortcut-desc" style="font-size: 0.85rem;">
                            <i class="fa-solid fa-house" style="color: var(--text-secondary);"></i>
                            <span>العودة للرئيسية (Home)</span>
                        </div>
                        <div class="shortcut-keys"><kbd>Alt</kbd><span class="shortcut-plus">+</span><kbd>H</kbd></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private System.Threading.Timer? _clockTimer;
    private DateTime _now = DateTime.Now;

    private static readonly CultureInfo ArabicCulture = new("ar-EG");

    private string ClockHoursMinutes => _now.ToString("hh:mm", ArabicCulture);
    private string ClockSeconds => _now.ToString("ss", CultureInfo.InvariantCulture);
    private string ClockAmPm => _now.ToString("tt", ArabicCulture);
    private string FormattedArabicDate => _now.ToString("dddd، d MMMM yyyy", ArabicCulture);

    private string GreetingTitle => _now.Hour switch
    {
        >= 5 and < 12 => "صباح الخير",
        >= 12 and < 17 => "مساء الخير",
        >= 17 and < 23 => "مساء الخير",
        _ => "أهلاً بك"
    };

    private string GreetingIcon => _now.Hour switch
    {
        >= 5 and < 17 => "fa-sun",
        _ => "fa-moon"
    };

    private bool IsAdminOrManager =>
        string.Equals(AuthState.UserRole, "Admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Manager", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(AuthState.UserRole, "Administrator", StringComparison.OrdinalIgnoreCase);

    private string ShiftButtonClass => ShiftState.IsShiftOpen ? "btn btn-secondary" : "btn btn-primary";

    protected override void OnInitialized()
    {
        ShiftState.OnShiftStateChanged += OnShiftChanged;

        // Initialize 1-second live clock ticker
        _clockTimer = new System.Threading.Timer(_ =>
        {
            _now = DateTime.Now;
            _ = InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private async void OnShiftChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _clockTimer?.Dispose();
        ShiftState.OnShiftStateChanged -= OnShiftChanged;
    }
}
