@page "/price-check"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject IJSRuntime JS

<div class="price-check-container">
    <!-- Header -->
    <div class="price-check-header">
        <div class="header-icon">
            <i class="fa-solid fa-barcode"></i>
        </div>
        <div>
            <h2>شاشة الاستعلام الفوري عن سعر المنتج</h2>
            <p>ضع المنتج أمام قارئ الباركود أو ادخل كود المنتج يدوياً للاستعلام عن السعر والمخزون</p>
        </div>
    </div>

    <!-- Search / Scanner Input Box -->
    <div class="search-scanner-card">
        <div class="input-wrapper">
            <i class="fa-solid fa-barcode search-icon"></i>
            <input id="price-check-barcode-input"
                   @ref="barcodeInput"
                   type="text"
                   class="scanner-input"
                   placeholder="امسح الباركود باستخدام القارئ أو ادخل الكود هنا..."
                   @bind="barcodeQuery"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp"
                   autocomplete="off" />
            
            @if (!string.IsNullOrWhiteSpace(barcodeQuery))
            {
                <button class="clear-btn" @onclick="ClearSearch" title="مسح">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            }
        </div>

        <div class="action-buttons">
            <button class="btn btn-search" @onclick="PerformSearchAsync" disabled="@(isLoading || string.IsNullOrWhiteSpace(barcodeQuery))">
                <i class="fa-solid fa-magnifying-glass"></i> استعلام (Enter)
            </button>
            <button class="btn btn-reset" @onclick="ClearSearch">
                <i class="fa-solid fa-rotate-left"></i> مسح الخانات
            </button>
        </div>
    </div>

    <!-- Main Results Area -->
    @if (isLoading)
    {
        <div class="state-card loading-state">
            <i class="fa-solid fa-circle-notch fa-spin fa-3x text-accent"></i>
            <p>جاري البحث واسترجاع تفاصيل المنتج والسعر...</p>
        </div>
    }
    else if (product is not null)
    {
        <div class="product-result-card">
            <!-- Left Side: Product Image & Badges -->
            <div class="product-media-column">
                <div class="image-container">
                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="@ApiClient.GetImageFullUrl(product.ImageUrl)" alt="@product.NameAr" class="product-img" onerror="this.onerror=null; this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                        <div class="no-image-placeholder" style="display:none;">
                            <i class="fa-solid fa-box-open fa-3x"></i>
                            <span>منتج بدون صورة</span>
                        </div>
                    }
                    else
                    {
                        <div class="no-image-placeholder">
                            <i class="fa-solid fa-box-open fa-3x"></i>
                            <span>منتج بدون صورة</span>
                        </div>
                    }
                </div>

                <div class="product-media-stock-text">
                    @if (product.QuantityInStock > 0)
                    {
                        <span class="stock-text-available">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            <span>متوفر بالمخزن: <strong>@product.QuantityInStock.ToString("N0") @(product.UnitSymbol ?? "قطعة")</strong></span>
                        </span>
                    }
                    else
                    {
                        <span class="stock-text-out">
                            <i class="fa-solid fa-circle-xmark"></i>
                            <span>غير متوفر بالمخزن (0)</span>
                        </span>
                    }
                </div>
            </div>

            <!-- Right Side: Details & High Impact Price Tag -->
            <div class="product-details-column">
                <!-- Price Display Hero Box -->
                <div class="price-hero-card">
                    <div class="price-hero-header">
                        <span><i class="fa-solid fa-tag"></i> سعر البيع النهائي</span>
                        <span class="tax-badge">
                            @(product.TaxRate > 0 ? $"شامل ضريبة {product.TaxRate}%" : "معفى من الضريبة")
                        </span>
                    </div>

                    <div class="price-main-display">
                        <span class="price-amount">@product.SellingPrice.ToString("N2")</span>
                        <span class="price-currency">ج.م</span>
                    </div>

                    <div class="price-sub-details">
                        @if (product.WholesalePrice > 0)
                        {
                            <span class="sub-detail-item">
                                <i class="fa-solid fa-boxes-packing"></i> سعر الجملة: <strong>@product.WholesalePrice.ToString("N2") ج.م</strong>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(product.UnitSymbol))
                        {
                            <span class="sub-detail-item">
                                <i class="fa-solid fa-scale-unbalanced"></i> وحدة البيع: <strong>@product.UnitSymbol</strong>
                            </span>
                        }
                    </div>
                </div>

                <!-- Product Attributes -->
                <div class="attributes-grid">
                    <div class="attr-box">
                        <span class="attr-label">اسم المنتج بالعربية</span>
                        <span class="attr-val font-title">@product.NameAr</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(product.NameEn))
                    {
                        <div class="attr-box">
                            <span class="attr-label">اسم المنتج بالإنجليزية</span>
                            <span class="attr-val">@product.NameEn</span>
                        </div>
                    }

                    <div class="attr-box">
                        <span class="attr-label">كود الباركود</span>
                        <span class="attr-val barcode-font"><i class="fa-solid fa-barcode"></i> @product.Barcode</span>
                    </div>

                    <div class="attr-box">
                        <span class="attr-label">الكمية المتوفرة بالمخزن</span>
                        <span class="attr-val" style="color: @(product.QuantityInStock > 0 ? "var(--accent-green)" : "var(--accent-red)"); font-weight: 800;">
                            <i class="fa-solid @(product.QuantityInStock > 0 ? "fa-cubes" : "fa-circle-xmark") me-1"></i>
                            @product.QuantityInStock.ToString("N0") @(product.UnitSymbol ?? "قطعة")
                        </span>
                    </div>

                    <div class="attr-box">
                        <span class="attr-label">التصنيف</span>
                        <span class="attr-val">@(product.CategoryName ?? "غير محدد")</span>
                    </div>

                    <div class="attr-box">
                        <span class="attr-label">حالة التوفر</span>
                        <span class="attr-val">
                            @if (product.QuantityInStock > 0)
                            {
                                <span style="color: var(--accent-green); font-weight: 700;"><i class="fa-solid fa-check-circle me-1"></i>متوفر للبيع</span>
                            }
                            else
                            {
                                <span style="color: var(--accent-red); font-weight: 700;"><i class="fa-solid fa-circle-xmark me-1"></i>غير متوفر بالمخزن</span>
                            }
                        </span>
                    </div>
                </div>

                <!-- Tags / Attributes Flags -->
                <div class="flags-container">
                    @if (product.IsWeighable)
                    {
                        <span class="flag-chip chip-amber"><i class="fa-solid fa-scale-balanced"></i> منتج بميزان</span>
                    }
                    @if (product.TrackExpiry)
                    {
                        <span class="flag-chip chip-blue"><i class="fa-solid fa-calendar-check"></i> مُتتبع بتاريخ الانتهاء</span>
                    }
                    @if (product.IsActive)
                    {
                        <span class="flag-chip chip-green"><i class="fa-solid fa-check"></i> منتج نشط بالسيستم</span>
                    }
                </div>

                <!-- Action Footer -->
                <div class="result-action-footer">
                    <button class="btn btn-scan-next" @onclick="ClearAndFocus">
                        <i class="fa-solid fa-barcode"></i> استعلام عن منتج آخر (مسح جديد)
                    </button>
                </div>
            </div>
        </div>
    }
    else if (hasSearched)
    {
        <div class="state-card not-found-state">
            <div class="not-found-icon">
                <i class="fa-solid fa-face-frown fa-4x text-red"></i>
            </div>
            <h3>لم يتم العثور على منتج بهذا الباركود!</h3>
            <p>تأكد من صحة كود الباركود المدخل أو جرب المسح مرة أخرى</p>

            <button class="btn btn-scan-next" @onclick="ClearAndFocus" style="margin-top: 1rem;">
                <i class="fa-solid fa-rotate-left"></i> المحاولة مرة أخرى
            </button>
        </div>
    }
    else
    {
        <!-- Initial Standby Kiosk Screen -->
        <div class="state-card standby-state">
            <div class="standby-icon">
                <i class="fa-solid fa-qrcode fa-5x text-indigo"></i>
            </div>
            <h3>الشاشة جاهزة للاستعلام</h3>
            <p>وجه القارئ الضوئي نحو الباركود أو قم بكتابة الكود للبدء</p>
        </div>
    }
</div>

<style>
    .price-check-container {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 2rem;
    }

    .price-check-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 1.25rem 1.5rem;
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
    }

    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
        flex-shrink: 0;
    }

    .price-check-header h2 {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0;
    }

    .price-check-header p {
        font-size: 0.88rem;
        color: var(--text-secondary);
        margin-top: 0.2rem;
    }

    /* Search & Scanner Input Card */
    .search-scanner-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: var(--shadow-md);
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        right: 1.25rem;
        font-size: 1.3rem;
        color: var(--accent-indigo);
    }

    .scanner-input {
        width: 100%;
        background: var(--bg-secondary);
        border: 2px solid var(--accent-indigo);
        color: var(--text-primary);
        padding: 1rem 3.2rem 1rem 3rem;
        border-radius: 12px;
        font-size: 1.25rem;
        font-weight: 700;
        font-family: var(--font-family);
        outline: none;
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
        transition: all 0.2s ease;
    }

    .scanner-input:focus {
        border-color: var(--accent-blue);
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
    }

    .clear-btn {
        position: absolute;
        left: 1rem;
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0.3rem;
    }
    .clear-btn:hover { color: var(--accent-red); }

    .action-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-search {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-reset {
        background: var(--bg-secondary);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
        padding: 0.75rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* States */
    .state-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 4rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
    }

    .standby-state h3, .not-found-state h3 {
        font-size: 1.4rem;
        font-weight: 800;
    }

    .standby-state p, .not-found-state p {
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    /* Product Result Card */
    .product-result-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 1.75rem;
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 2rem;
        box-shadow: var(--shadow-lg);
    }

    .product-media-column {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        align-items: center;
    }

    .image-container {
        width: 100%;
        height: 240px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .no-image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 600;
        width: 100%;
        height: 100%;
    }

    .product-media-stock-text {
        width: 100%;
        text-align: center;
        padding: 0.65rem 0.85rem;
        border-radius: 12px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stock-text-available {
        color: var(--accent-green);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
    }

    .stock-text-available strong {
        font-weight: 800;
        font-size: 1.05rem;
    }

    .stock-text-out {
        color: var(--accent-red);
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-weight: 700;
    }

    .product-details-column {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* Price Hero Card */
    .price-hero-card {
        background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(56, 189, 248, 0.12));
        border: 2px solid var(--accent-indigo);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.15);
    }

    .price-hero-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent-indigo);
    }

    .tax-badge {
        background: var(--bg-card);
        color: var(--text-secondary);
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-size: 0.75rem;
        border: 1px solid var(--border-color);
    }

    .price-main-display {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .price-amount {
        font-size: 3rem;
        font-weight: 900;
        color: var(--accent-emerald);
        letter-spacing: -1px;
        line-height: 1;
    }

    .price-currency {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-secondary);
    }

    .price-sub-details {
        display: flex;
        gap: 1.5rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
        border-top: 1px dashed var(--border-color);
        padding-top: 0.6rem;
    }

    .attributes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .attr-box {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        background: var(--bg-secondary);
        padding: 0.85rem;
        border-radius: 10px;
        border: 1px solid var(--border-color);
    }

    .attr-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-weight: 600;
    }

    .attr-val {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .font-title { font-size: 1.15rem; font-weight: 800; color: var(--accent-blue); }
    .barcode-font { font-family: monospace; font-size: 1rem; color: var(--accent-amber); }

    .flags-container {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .flag-chip {
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .chip-amber { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); }
    .chip-blue { background: rgba(56, 189, 248, 0.15); color: var(--accent-blue); }
    .chip-green { background: rgba(16, 185, 129, 0.15); color: var(--accent-green); }

    .result-action-footer {
        margin-top: 0.5rem;
    }

    .btn-scan-next {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: white;
        border: none;
        padding: 0.85rem 1.75rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }

    .text-red { color: var(--accent-red); }
    .text-indigo { color: var(--accent-indigo); }
    .text-accent { color: var(--accent-blue); }

    @@media (max-width: 768px) {
        .product-result-card {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private ElementReference barcodeInput;
    private string barcodeQuery = string.Empty;
    private bool isLoading = false;
    private bool hasSearched = false;
    private ProductDto? product;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusBarcodeScannerAsync(50, true);
        }
    }

    private async Task FocusBarcodeScannerAsync(int delay = 0, bool select = true)
    {
        try
        {
            await JS.InvokeVoidAsync("focusElementById", "price-check-barcode-input", delay, select);
        }
        catch
        {
            try { await barcodeInput.FocusAsync(); } catch { }
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearchAsync();
        }
    }

    private async Task PerformSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(barcodeQuery)) return;

        isLoading = true;
        hasSearched = true;
        product = null;
        StateHasChanged();

        var query = barcodeQuery.Trim();

        // 1. Try exact barcode match first
        product = await ApiClient.GetProductByBarcodeAsync(query);

        // 2. Fallback: Search in product catalog list if barcode exact lookup returned null
        if (product is null)
        {
            var searchResults = await ApiClient.GetProductsAsync(query);
            product = searchResults.FirstOrDefault(p => 
                string.Equals(p.Barcode, query, StringComparison.OrdinalIgnoreCase) ||
                p.NameAr.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        isLoading = false;
        StateHasChanged();
        await FocusBarcodeScannerAsync(50, true);
    }

    private async Task ClearSearch()
    {
        barcodeQuery = string.Empty;
        product = null;
        hasSearched = false;
        await FocusBarcodeScannerAsync(0, true);
    }

    private async Task ClearAndFocus()
    {
        await ClearSearch();
    }
}
