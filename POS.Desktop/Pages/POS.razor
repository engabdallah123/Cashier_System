@page "/pos"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@using global::POS.Desktop.Services.State
@using global::POS.Desktop.Services.Printing
@attribute [Authorize]
@implements IDisposable
@inject PosApiClient ApiClient
@inject CartStateContainer Cart
@inject ShiftStateContainer Shift
@inject CustomAuthStateProvider AuthState
@inject IInvoicePrinterService Printer
@inject StoreStateContainer StoreState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject global::POS.Desktop.Services.Sync.ICloudSyncService CloudSync

<div class="pos-layout">
    <!-- Live Floating Alerts Container (Stock Alerts) -->
    @if (activeAlerts.Any())
    {
        <div class="stock-alerts-floating-container" style="z-index: 10050;">
            @foreach (var alert in activeAlerts)
            {
                <div class="stock-alert-toast @(alert.AlertType == "danger" ? "alert-danger" : "alert-warning")" @key="alert.Id">
                    <div class="alert-icon">
                        <i class="fa-solid @alert.Icon"></i>
                    </div>
                    <div class="alert-content">
                        <div class="alert-title">@alert.Title</div>
                        <div class="alert-msg">@((MarkupString)alert.Message)</div>
                    </div>
                    <button class="alert-close-btn" @onclick="() => DismissAlert(alert.Id)" title="إغلاق التنبيه">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            }
        </div>
    }

    <!-- Left Panel: Catalog & Search -->
    <div class="catalog-panel">
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <!-- Barcode Scanner HID Input -->
            <div class="search-box" style="flex: 2; min-width: 220px;">
                <i class="fa-solid fa-barcode"></i>
                <input id="pos-barcode-input"
                       @ref="barcodeInputRef" 
                       @bind="scannedBarcode" 
                       @bind:event="oninput" 
                       @onkeyup="HandleBarcodeKeyUp"
                       placeholder="امسح الباركود أو أدخله يدوياً... [F2 / Enter]" 
                       style="border-color: var(--accent-blue);" />
            </div>

            <!-- Product Search Input -->
            <div class="search-box" style="flex: 2; min-width: 200px;">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input @bind="searchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="SearchProducts" 
                       placeholder="ابحث عن منتج بالاسم... [F1]" />
            </div>


        </div>

        <!-- Categories Bar & Low Stock Indicator -->
        <div class="category-bar">
            <button class="cat-btn @(selectedCategoryId == null ? "active" : "")" @onclick="() => FilterByCategory(null)">
                جميع التصنيفات
            </button>
            @foreach (var cat in categories)
            {
                <button class="cat-btn @(selectedCategoryId == cat.Id ? "active" : "")" @onclick="() => FilterByCategory(cat.Id)">
                    @cat.NameAr
                </button>
            }
            @if (LowStockCount > 0)
            {
                <button class="cat-btn cat-btn-warning" @onclick="OpenLowStockModal" title="عرض كافة الأصناف التي وصلت لحد الطلب أو نفذت">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <span>النواقص (@LowStockCount)</span>
                </button>
            }
        </div>

        <!-- Products Grid -->
        <div class="products-grid">
            @if (isLoadingProducts)
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 2rem;">
                    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                    <p style="margin-top: 0.5rem; color: var(--text-secondary);">جاري تحميل الكتالوج...</p>
                </div>
            }
            else if (!filteredProducts.Any())
            {
                <div style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: var(--text-secondary);">
                    <i class="fa-solid fa-box-open fa-2x"></i>
                    <p style="margin-top: 0.5rem;">لا توجد منتجات مطابقة</p>
                </div>
            }
            else
            {
                @foreach (var prod in PagedProducts)
                {
                    <div class="product-card" @onclick="() => AddToCart(prod)">
                        <div class="product-card-img-container" style="position: relative;">
                            @if (prod.QuantityInStock <= 0)
                            {
                                <div class="stock-badge badge-out-of-stock">نفذ المخزون</div>
                            }
                            else if (prod.QuantityInStock <= prod.ReorderLevel)
                            {
                                <div class="stock-badge badge-low-stock">تحت حد الطلب (@prod.QuantityInStock.ToString("N0"))</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(prod.ImageUrl))
                            {
                                var resolvedUrl = ApiClient.GetImageFullUrl(prod.ImageUrl);
                                <img src="@resolvedUrl" class="product-card-img" alt="@prod.NameAr" onerror="this.onerror=null; this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <div class="product-card-img-placeholder" style="display:none;">
                                    <i class="fa-solid fa-box"></i>
                                </div>
                            }
                            else
                            {
                                <div class="product-card-img-placeholder">
                                    <i class="fa-solid fa-box"></i>
                                </div>
                            }
                        </div>
                        <div class="product-card-body">
                            <div class="product-title" title="@prod.NameAr">@prod.NameAr</div>
                            <div class="product-stock" style="color: @(prod.QuantityInStock <= 0 ? "var(--accent-red)" : prod.QuantityInStock <= prod.ReorderLevel ? "var(--accent-amber)" : "var(--text-secondary)"); font-weight: @(prod.QuantityInStock <= prod.ReorderLevel ? "700" : "400");">
                                المخزون: @PackagingUnitHelper.FormatStockBreakdown(prod.QuantityInStock, prod.Description, prod.UnitSymbol ?? "قطعة")
                                @if (prod.QuantityInStock <= prod.ReorderLevel && prod.QuantityInStock > 0)
                                {
                                    <i class="fa-solid fa-triangle-exclamation ms-1"></i>
                                }
                            </div>
                        </div>
                        <div class="product-card-footer" style="display: flex; justify-content: space-between; align-items: center; gap: 0.25rem;">
                            <span class="product-price">
                                @prod.SellingPrice.ToString("N2") ج.م
                                @if (prod.IsWeighable)
                                {
                                    <span style="font-size: 0.72rem; color: var(--accent-emerald); font-weight: 600;">/كجم</span>
                                }
                            </span>
                            <div style="display: flex; align-items: center; gap: 0.25rem;">
                                @if (prod.IsWeighable)
                                {
                                    <button type="button" 
                                            class="btn" 
                                            style="padding: 0.12rem 0.45rem; font-size: 0.68rem; font-weight: 700; background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 4px;" 
                                            @onclick:stopPropagation="true" 
                                            @onclick="() => OpenManualWeightModal(prod)" 
                                            title="وزن الصنف وإضافته للسلة">
                                        <i class="fa-solid fa-scale-balanced me-1"></i> وزن
                                    </button>
                                }
                                else if (prod.ConversionFactor > 1 || (!string.IsNullOrWhiteSpace(prod.Description) && prod.Description.Contains("[UNITS:")))
                                {
                                    int cartonSize = prod.ConversionFactor > 1 ? prod.ConversionFactor : PackagingUnitHelper.Parse(prod.Description).TotalPiecesPerCarton;
                                    <button type="button" 
                                            class="btn" 
                                            style="padding: 0.12rem 0.4rem; font-size: 0.68rem; font-weight: 700; background: rgba(99, 102, 241, 0.15); color: var(--accent-indigo); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 4px;" 
                                            @onclick:stopPropagation="true" 
                                            @onclick="() => AddCartonToCart(prod)" 
                                            title="إضافة كرتونة مباشرة (@cartonSize قطعة)">
                                        <i class="fa-solid fa-box-archive me-1"></i> كرتونة
                                    </button>
                                }
                                <i class="fa-solid fa-plus-circle"></i>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Pagination Controls Bar -->
        <Pagination CurrentPage="@currentPage" 
                    TotalItems="@filteredProducts.Count" 
                    PageSize="@pageSize" 
                    PageSizeOptions="@(new int[] { 6, 10, 12, 18, 24, 36, 48, 72, 100 })"
                    OnPageChanged="@(p => GoToPage(p))" 
                    OnPageSizeChanged="@(s => OnPageSizeChanged(s))" />
    </div>


    <!-- Right Panel: Cart & Actions -->
    <div class="cart-panel">
        <div class="cart-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.65rem; margin-bottom: 0.75rem;">
            <div>
                <h3 style="font-size: 1.05rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; margin: 0;">
                    <span>سلة المبيعات</span>
                    <span style="font-size: 0.75rem; background: var(--accent-indigo); color: white; padding: 0.15rem 0.5rem; border-radius: 1rem; font-weight: 600;">@Cart.Items.Count</span>
                </h3>
                <span style="font-size: 0.8rem; color: var(--text-secondary); display: block; margin-top: 0.2rem;">العميل: @(Cart.CustomerName == "Walk-in Customer" ? "عميل نقدي" : Cart.CustomerName)</span>
            </div>
            <div style="display: flex; gap: 0.45rem; align-items: center; flex-wrap: wrap;">
                <button class="btn @(StoreState.AutoPrintInvoiceAfterSale ? "btn-emerald" : "btn-secondary")" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; display: flex; align-items: center; gap: 0.35rem; white-space: nowrap;" @onclick="TogglePrinter" title="@(StoreState.AutoPrintInvoiceAfterSale ? "الطباعة التلقائية مفعلة" : "الطباعة معطلة")">
                    <i class="fa-solid @(StoreState.AutoPrintInvoiceAfterSale ? "fa-print" : "fa-ban")"></i>
                    <span>@(StoreState.AutoPrintInvoiceAfterSale ? "طابعة: مفعلة" : "طابعة: معطلة")</span>
                </button>
                <button class="btn" style="padding: 0.35rem 0.7rem; font-size: 0.82rem; font-weight: 700; background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #ffffff !important; border: 1px solid #a78bfa; border-radius: 0.45rem; display: flex; align-items: center; gap: 0.35rem; white-space: nowrap; box-shadow: 0 2px 6px rgba(139, 92, 246, 0.35);" @onclick='() => Nav.NavigateTo("returns/sales?new=true")' title="تسجيل مرتجع مبيعات جديد [Alt + R]">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>مرتجع</span>
                </button>
                <button class="btn btn-amber" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; white-space: nowrap;" @onclick="OpenCustomerModal">
                    <i class="fa-solid fa-user me-1"></i> العميل [F2]
                </button>
            </div>
        </div>

        <!-- Cart Items List -->
        <div class="cart-items">
            @if (!Cart.Items.Any())
            {
                <div style="text-align: center; margin: auto; color: var(--text-secondary); padding: 3rem 0;">
                    <i class="fa-solid fa-cart-shopping fa-3x" style="opacity: 0.3;"></i>
                    <p style="margin-top: 0.5rem;">السلة فارغة. قم بمسح أو اختيار المنتجات.</p>
                </div>
            }
            else
            {
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th style="width: 24px; text-align: center;">#</th>
                            <th style="text-align: right;">المنتج والوحدة</th>
                            <th style="width: 48px; text-align: center;" title="تفعيل البيع بسعر الجملة">جملة</th>
                            <th style="width: 105px; text-align: center;">الكمية</th>
                            <th style="width: 90px; text-align: left;">الإجمالي</th>
                            <th style="width: 28px; text-align: center;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var item in Cart.Items)
                        {
                            var currentIndex = idx++;
                            <tr>
                                <td style="text-align: center; color: var(--text-muted); font-size: 0.75rem;">@currentIndex</td>
                                <td>
                                    <div style="font-weight: 700; color: var(--text-primary); font-size: 0.85rem; line-height: 1.2; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                                        <span>@item.ProductName</span>
                                        @if (item.IsWeighable)
                                        {
                                            <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.65rem; padding: 0.1rem 0.35rem; border-radius: 4px;">
                                                <i class="fa-solid fa-scale-balanced me-1"></i> ميزان
                                            </span>
                                        }
                                    </div>
                                    <div style="font-size: 0.74rem; color: var(--text-secondary); display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.15rem;">
                                        @if (item.SelectedUnit == "Carton")
                                        {
                                            <span style="font-weight: 700; color: var(--accent-indigo); font-size: 0.78rem;">
                                                الكرتونة: @item.CartonUnitPrice.ToString("N2") ج.م
                                            </span>
                                            <span style="font-size: 0.68rem; color: var(--text-muted);">
                                                (@item.UnitPrice.ToString("N2") ج.م/@item.BaseUnit × @item.CartonPieces)
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="font-weight: 600; color: var(--accent-emerald); font-size: 0.78rem;">
                                                @item.UnitPrice.ToString("N2") ج.م/@item.BaseUnit
                                            </span>
                                            @if (item.HasCarton)
                                            {
                                                <span style="font-size: 0.68rem; color: var(--text-muted);" title="سعر الكرتونة">
                                                    (كرتونة: @item.CartonUnitPrice.ToString("N2") ج.م)
                                                </span>
                                            }
                                        }

                                        <!-- Unit Selection Buttons (Hidden for weighable items) -->
                                        @if (!item.IsWeighable)
                                        {
                                            <div style="display: inline-flex; border: 1px solid var(--border-color); border-radius: 4px; overflow: hidden; font-size: 0.68rem;">
                                                <button type="button" 
                                                        class="btn @(item.SelectedUnit == "Piece" ? "btn-primary" : "btn-secondary")" 
                                                        style="padding: 0.05rem 0.35rem; border-radius: 0; font-size: 0.68rem;" 
                                                        @onclick='() => SetItemUnit(item.ProductId, "Piece")'>
                                                    @item.BaseUnit
                                                </button>
                                                @if (item.PiecesPerBox > 1)
                                                {
                                                    <button type="button" 
                                                            class="btn @(item.SelectedUnit == "Box" ? "btn-primary" : "btn-secondary")" 
                                                            style="padding: 0.05rem 0.35rem; border-radius: 0; font-size: 0.68rem;" 
                                                            @onclick='() => SetItemUnit(item.ProductId, "Box")'>
                                                        علبة (@item.PiecesPerBox)
                                                    </button>
                                                }
                                                @if (item.HasCarton)
                                                {
                                                    <button type="button" 
                                                            class="btn @(item.SelectedUnit == "Carton" ? "btn-primary" : "btn-secondary")" 
                                                            style="padding: 0.05rem 0.35rem; border-radius: 0; font-size: 0.68rem;" 
                                                            @onclick='() => SetItemUnit(item.ProductId, "Carton")'
                                                            title="البيع بالكرتونة (@item.CartonPieces @item.BaseUnit)">
                                                        @item.ParentUnit (@item.CartonPieces)
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" 
                                                            class="btn btn-secondary" 
                                                            style="padding: 0.05rem 0.35rem; border-radius: 0; font-size: 0.68rem; opacity: 0.85;" 
                                                            @onclick='() => PromptCartonSize(item.ProductId)'
                                                            title="تحديد معامل الكرتونة للبيع">
                                                        + كرتونة
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td style="text-align: center;">
                                    <button type="button" 
                                            class="btn" 
                                            style="padding: 0.15rem 0.35rem; font-size: 0.68rem; font-weight: 700; border-radius: 4px; border: 1px solid @(item.IsWholesale ? "rgba(245, 158, 11, 0.5)" : "var(--border-color)"); background: @(item.IsWholesale ? "rgba(245, 158, 11, 0.18)" : "var(--bg-secondary)"); color: @(item.IsWholesale ? "var(--accent-amber)" : "var(--text-secondary)");"
                                            @onclick="() => OnToggleWholesale(item.ProductId, !item.IsWholesale)"
                                            title="@(item.IsWholesale ? "محدد بيع بسعر الجملة (اضغط للتبديل لقطاعي)" : "محدد بيع بسعر قطاعي (اضغط للتبديل لجملة)")">
                                        @(item.IsWholesale ? "جملة" : "قطاعي")
                                    </button>
                                </td>
                                <td style="text-align: center;">
                                    <div class="qty-controls" style="display: inline-flex; align-items: center; gap: 0.15rem;">
                                        <button class="qty-btn" @onclick="() => Cart.UpdateQuantity(item.ProductId, Math.Max(0.001m, item.UnitQuantity - (item.IsWeighable ? 0.050m : 1m)))" title="@(item.IsWeighable ? "إنقاص 50 جرام" : "إنقاص واحد")">-</button>
                                        <input type="number"
                                               min="0.001"
                                               step="0.001"
                                               class="qty-input"
                                               value="@(item.IsWeighable ? item.UnitQuantity.ToString("0.000") : item.UnitQuantity.ToString("G29"))"
                                               @onchange="(e) => OnQuantityInputChanged(item.ProductId, e.Value)"
                                               title="انقر للتعديل المباشر للوزن أو الكمية"
                                               style="width: @(item.IsWeighable ? "62px" : "44px"); text-align: center; font-weight: 700; font-size: 0.85rem; color: var(--accent-amber); background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; padding: 0.1rem; outline: none;" />
                                        <button class="qty-btn" @onclick="() => Cart.UpdateQuantity(item.ProductId, item.UnitQuantity + (item.IsWeighable ? 0.050m : 1m))" title="@(item.IsWeighable ? "زيادة 50 جرام" : "زيادة واحد")">+</button>
                                    </div>
                                    @if (item.IsWeighable)
                                    {
                                        <div style="font-size: 0.65rem; color: var(--accent-emerald); font-weight: 700; margin-top: 0.1rem;">
                                            @item.Quantity.ToString("0.000") @item.BaseUnit
                                        </div>
                                    }
                                    else if (item.SelectedUnit == "Carton")
                                    {
                                        <div style="font-size: 0.65rem; color: var(--accent-indigo); font-weight: 600; margin-top: 0.1rem;">
                                            (@item.Quantity.ToString("N0") قطعة)
                                        </div>
                                    }
                                </td>
                                <td style="text-align: left; font-weight: 700; color: var(--accent-emerald); font-size: 0.86rem;">
                                    @item.LineTotal.ToString("N2")
                                </td>
                                <td style="text-align: center;">
                                    <button class="qty-btn" style="background: rgba(239, 68, 68, 0.15); color: var(--accent-red); border-color: rgba(239, 68, 68, 0.3);" @onclick="() => Cart.RemoveItem(item.ProductId)" title="حذف">
                                        <i class="fa-solid fa-xmark" style="font-size: 0.75rem;"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Cart Totals Summary -->
        <div class="cart-summary">
            <div class="summary-row">
                <span>المجموع الفرعي</span>
                <span style="font-weight: 600;">@Cart.SubTotal.ToString("N2") ج.م</span>
            </div>
            @if (Cart.TotalDiscount > 0)
            {
                <div class="summary-row" style="color: var(--accent-amber);">
                    <span>إجمالي الخصم</span>
                    <span>-@Cart.TotalDiscount.ToString("N2") ج.م</span>
                </div>
            }
            @if (Cart.TotalTax > 0)
            {
                <div class="summary-row" style="color: var(--accent-blue);">
                    <span>إجمالي الضريبة</span>
                    <span>+@Cart.TotalTax.ToString("N2") ج.م</span>
                </div>
            }
            <div class="summary-row total">
                <span>الإجمالي الكلي</span>
                <span style="color: var(--accent-emerald);">@Cart.GrandTotal.ToString("N2") ج.م</span>
            </div>
        </div>

        <!-- Action Buttons Grid -->
        <div class="pos-actions">
            <button class="btn btn-danger" @onclick="() => Cart.Clear()">
                <i class="fa-solid fa-xmark me-1"></i> إلغاء الفاتورة [Esc]
            </button>
            <button class="btn btn-success" disabled="@(!Cart.Items.Any() || isProcessingSale)" @onclick="OpenPaymentModal">
                <i class="fa-solid fa-money-bill-wave me-1"></i> إتمام الدفع [Enter]
            </button>
        </div>
    </div>
</div>

<!-- Checkout Payment Modal -->
@if (showPaymentModal)
{
    <div class="modal-overlay" @onclick="ClosePaymentModal">
        <div class="modal-card" style="width: 840px; max-width: 96vw; max-height: 92vh; display: flex; flex-direction: column; overflow: hidden; padding: 0;" @onclick:stopPropagation="true">
            <div class="modal-header" style="padding: 0.65rem 1.25rem; border-bottom: 1px solid var(--border-color);">
                <h3 class="modal-title" style="font-size: 1.15rem; font-weight: 700;">
                    <i class="fa-solid fa-cash-register me-2" style="color: var(--accent-emerald);"></i>
                    الدفع وإنهاء الفاتورة
                </h3>
                <button class="btn btn-secondary" style="padding: 0.25rem 0.55rem;" @onclick="ClosePaymentModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="padding: 0.85rem 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; overflow: hidden;">
                @if (!string.IsNullOrEmpty(saleError))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.5rem 0.85rem; border-radius: 0.4rem; font-size: 0.82rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @saleError
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; align-items: start;">
                    <!-- RIGHT COLUMN: Invoice Info, Customer, Discount, Method & Print Type -->
                    <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                        <!-- Required Amount Display -->
                        <div style="background: var(--bg-card); padding: 0.65rem 0.9rem; border-radius: 0.55rem; border: 1.5px solid var(--accent-emerald); display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.95rem; font-weight: 700; color: var(--text-secondary);">المبلغ المطلوب:</span>
                            <span style="font-size: 1.55rem; font-weight: 900; color: var(--accent-emerald); letter-spacing: -0.5px;">@Cart.GrandTotal.ToString("N2") <span style="font-size: 0.95rem;">ج.م</span></span>
                        </div>

                        <!-- Customer & Items Bar -->
                        <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 0.45rem 0.75rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem;">
                            <div style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;" @onclick="ToggleProductReview" title="انقر لعرض الأصناف">
                                <i class="fa-solid fa-cart-shopping text-primary"></i>
                                <span>عدد الأصناف: <strong style="color: var(--accent-blue);">@Cart.Items.Count</strong></span>
                                <i class="fa-solid @(isProductReviewExpanded ? "fa-chevron-up" : "fa-chevron-down")" style="font-size: 0.7rem; color: var(--text-muted);"></i>
                            </div>
                            <div style="display: flex; align-items: center; gap: 0.35rem;">
                                <span style="color: var(--text-secondary);"><i class="fa-solid fa-user me-1"></i>@(Cart.CustomerName == "Walk-in Customer" ? "عميل نقدي" : Cart.CustomerName)</span>
                                @if (Cart.CustomerId == null)
                                {
                                    <button type="button" class="btn btn-xs btn-outline-primary" style="padding: 0.15rem 0.4rem; font-size: 0.7rem;" @onclick="OpenCustomerModal">تحديد</button>
                                }
                            </div>
                        </div>

                        @if (isProductReviewExpanded)
                        {
                            <div style="max-height: 110px; overflow-y: auto; background: var(--bg-primary); border: 1px solid var(--border-color-light); border-radius: 0.4rem; padding: 0.35rem 0.5rem; font-size: 0.78rem;">
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tbody>
                                        @foreach (var item in Cart.Items)
                                        {
                                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                                <td style="padding: 0.2rem 0;">@item.ProductName</td>
                                                <td style="padding: 0.2rem; text-align: center; color: var(--accent-amber);">×@item.Quantity.ToString("N0")</td>
                                                <td style="padding: 0.2rem 0; text-align: left; font-weight: 700; color: var(--accent-emerald);">@item.LineTotal.ToString("N2")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <!-- Discount Controls -->
                        <div style="background: rgba(255,255,255,0.02); border: 1px dashed var(--border-color); border-radius: 0.5rem; padding: 0.55rem 0.75rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
                                <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-amber);">
                                    <i class="fa-solid fa-percent me-1"></i> خصم على الفاتورة (%):
                                </span>
                                @if (Cart.OverallDiscount > 0)
                                {
                                    <span style="font-size: 0.75rem; color: #f87171; font-weight: 700;">
                                        -@Cart.OverallDiscount.ToString("N2") ج.م
                                    </span>
                                }
                            </div>

                            <div style="display: flex; gap: 0.3rem; align-items: center;">
                                <div style="display: flex; gap: 0.2rem; width: 75px;">
                                    <input type="number" min="0" max="100" step="any" class="form-control"
                                           value="@discountPercentage"
                                           @oninput="OnDiscountPercentInput"
                                           style="text-align: center; font-weight: 700; font-size: 0.88rem; color: var(--accent-amber); height: 32px; padding: 0.2rem;"
                                           placeholder="%" />
                                </div>
                                <div style="display: flex; gap: 0.2rem; flex: 1;">
                                    <button type="button" class="btn @(discountPercentage == 5 ? "btn-amber" : "btn-secondary")" style="flex: 1; padding: 0.2rem 0.25rem; font-size: 0.75rem; font-weight: 700;" @onclick="() => ApplyDiscountPercent(5)">5%</button>
                                    <button type="button" class="btn @(discountPercentage == 10 ? "btn-amber" : "btn-secondary")" style="flex: 1; padding: 0.2rem 0.25rem; font-size: 0.75rem; font-weight: 700;" @onclick="() => ApplyDiscountPercent(10)">10%</button>
                                    <button type="button" class="btn @(discountPercentage == 15 ? "btn-amber" : "btn-secondary")" style="flex: 1; padding: 0.2rem 0.25rem; font-size: 0.75rem; font-weight: 700;" @onclick="() => ApplyDiscountPercent(15)">15%</button>
                                    <button type="button" class="btn @(discountPercentage == 20 ? "btn-amber" : "btn-secondary")" style="flex: 1; padding: 0.2rem 0.25rem; font-size: 0.75rem; font-weight: 700;" @onclick="() => ApplyDiscountPercent(20)">20%</button>
                                    @if (discountPercentage > 0 || Cart.OverallDiscount > 0)
                                    {
                                        <button type="button" class="btn btn-secondary" style="padding: 0.2rem 0.4rem; font-size: 0.75rem; color: #f87171;" @onclick="ClearDiscount" title="إلغاء الخصم">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method & Print Type Row -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                            <div class="form-group" style="margin: 0;">
                                <label style="font-size: 0.78rem; font-weight: 600; margin-bottom: 0.25rem; display: block;">طريقة الدفع</label>
                                <select class="form-select" style="padding: 0.3rem 0.5rem; font-size: 0.82rem; height: 34px;" value="@Cart.PaymentMethod" @onchange="OnPaymentMethodChanged">
                                    <option value="Cash">نقداً (كاش)</option>
                                    <option value="Visa">بطاقة (فيزا / كارت)</option>
                                    <option value="Credit">آجل (ديون)</option>
                                </select>
                            </div>

                            <div class="form-group" style="margin: 0;">
                                <label style="font-size: 0.78rem; font-weight: 600; margin-bottom: 0.25rem; display: block;"><i class="fa-solid fa-print me-1"></i> نوع الطباعة</label>
                                <select class="form-select" style="padding: 0.3rem 0.5rem; font-size: 0.82rem; height: 34px;" @bind="selectedPrintType">
                                    <option value="thermal">🧾 حرارية (80mm)</option>
                                    <option value="a4">📄 عادية (A4)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- LEFT COLUMN: Paid Amount Input, Quick Denominations, Change/Debt Display -->
                    <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                        <!-- Cash Received Section -->
                        <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 0.55rem; padding: 0.75rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                <label style="margin: 0; font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem;">
                                    <i class="fa-solid fa-money-bills" style="color: var(--accent-emerald);"></i>
                                    <span>المبلغ المستلم (كاش)</span>
                                </label>
                                <span style="font-size: 0.72rem; color: var(--text-muted);">[Enter للحفظ]</span>
                            </div>

                            <input id="pos-paid-amount-input" type="number" step="any" class="form-control"
                                   @bind="paidAmount" @bind:event="oninput" @onkeyup="HandlePaymentInputKeyUp"
                                   style="font-size: 1.45rem; font-weight: 800; text-align: center; color: var(--accent-blue); background: var(--bg-card); height: 44px; border-width: 2px;"
                                   placeholder="0.00" />

                            <!-- Quick Denominations -->
                            <div style="display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 0.35rem; margin-top: 0.45rem;">
                                <button type="button" class="btn btn-emerald" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; font-weight: 700;" @onclick="() => paidAmount = Cart.GrandTotal">
                                    كامل المبلغ
                                </button>
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; font-weight: 700;" @onclick="() => SetPaidDenomination(50)">
                                    50 ج
                                </button>
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; font-weight: 700;" @onclick="() => SetPaidDenomination(100)">
                                    100 ج
                                </button>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr 1.3fr; gap: 0.35rem; margin-top: 0.3rem;">
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; font-weight: 700;" @onclick="() => SetPaidDenomination(200)">
                                    200 ج
                                </button>
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; font-weight: 700;" @onclick="() => SetPaidDenomination(500)">
                                    500 ج
                                </button>
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.4rem; font-size: 0.8rem; color: #f87171;" @onclick="() => paidAmount = 0">
                                    آجل (0)
                                </button>
                            </div>
                        </div>

                        <!-- Change or Debt Calculation Box -->
                        @if (paidAmount >= Cart.GrandTotal)
                        {
                            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.05)); border: 1.5px solid var(--accent-emerald); padding: 0.7rem 0.9rem; border-radius: 0.55rem; text-align: center;">
                                <div style="font-size: 0.82rem; font-weight: 700; color: var(--accent-emerald); display: flex; align-items: center; justify-content: center; gap: 0.35rem; margin-bottom: 0.15rem;">
                                    <i class="fa-solid fa-coins"></i>
                                    <span>المبلغ المتبقي (الباقي للعميل):</span>
                                </div>
                                <div style="font-size: 1.85rem; font-weight: 900; color: #10b981; line-height: 1.2;">
                                    @((paidAmount - Cart.GrandTotal).ToString("N2")) <span style="font-size: 1rem; font-weight: 700;">ج.م</span>
                                </div>
                                @if (paidAmount > Cart.GrandTotal)
                                {
                                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.15rem;">
                                        استلمت @paidAmount.ToString("N2") ج.م - مطلوب @Cart.GrandTotal.ToString("N2") ج.م
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="background: rgba(239, 68, 68, 0.1); border: 1.5px solid rgba(239, 68, 68, 0.35); padding: 0.65rem 0.85rem; border-radius: 0.55rem; color: #f87171;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <span style="font-weight: 700; font-size: 0.85rem;">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> مديونية على العميل:
                                    </span>
                                    <span style="font-size: 1.4rem; font-weight: 900; color: #ef4444;">
                                        @((Cart.GrandTotal - paidAmount).ToString("N2")) <span style="font-size: 0.85rem; font-weight: 700;">ج.م</span>
                                    </span>
                                </div>
                                @if (Cart.CustomerId == null)
                                {
                                    <div style="font-size: 0.75rem; color: #fbbf24; display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed rgba(239, 68, 68, 0.2); padding-top: 0.35rem; margin-top: 0.35rem;">
                                        <span>⚠️ يلزم تحديد عميل لحفظ المديونية.</span>
                                        <button type="button" class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.7rem;" @onclick="OpenCustomerModal">
                                            <i class="fa-solid fa-user-plus me-1"></i> اختيار
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div style="font-size: 0.75rem; color: var(--text-secondary); border-top: 1px dashed rgba(239, 68, 68, 0.2); padding-top: 0.35rem; margin-top: 0.35rem;">
                                        العميل: <strong style="color: var(--text-primary);">@Cart.CustomerName</strong>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="padding: 0.65rem 1.25rem; border-top: 1px solid var(--border-color); display: flex; gap: 0.75rem;">
                <button class="btn btn-secondary" style="flex: 1; padding: 0.6rem;" @onclick="ClosePaymentModal">إلغاء [Esc]</button>
                <button id="payment-submit-btn" class="btn btn-success" style="flex: 2; padding: 0.6rem; font-weight: 700; font-size: 0.95rem;" disabled="@isProcessingSale" @onclick="SubmitSale">
                    @if (isProcessingSale)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check-circle me-1"></i> <span>تأكيد الدفع وطباعة الفاتورة [Enter]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Manual Weight Entry Modal (لأصناف الميزان والجبن واللانشون) -->
@if (showWeightModal && weightModalProduct != null)
{
    <div class="modal-overlay" @onclick="CloseWeightModal" style="z-index: 1050;">
        <div class="modal-card" style="width: 490px; border-top: 4px solid var(--accent-emerald);" @onclick:stopPropagation="true">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 class="modal-title" style="display: flex; align-items: center; gap: 0.5rem; color: var(--accent-emerald);">
                    <i class="fa-solid fa-scale-balanced"></i>
                    <span>تحديد وزن: @weightModalProduct.NameAr</span>
                </h3>
                <button class="btn btn-secondary" style="padding: 0.25rem 0.5rem;" @onclick="CloseWeightModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="padding: 1.25rem 1rem;">
                <!-- Product Info Badge -->
                <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.65rem; padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 0.8rem; color: var(--text-secondary);">سعر بيع الكيلو:</div>
                        <div style="font-size: 1.25rem; font-weight: 800; color: var(--accent-emerald);">
                            @weightModalProduct.SellingPrice.ToString("N2") <span style="font-size: 0.85rem;">ج.م / @(weightModalProduct.BaseUnit ?? "كجم")</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(weightModalProduct.Barcode))
                    {
                        <div style="text-align: left;">
                            <div style="font-size: 0.75rem; color: var(--text-muted);">كود الميزان (PLU):</div>
                            <code style="font-size: 0.95rem; font-weight: 700; color: #a7f3d0; background: rgba(0,0,0,0.3); padding: 0.2rem 0.5rem; border-radius: 4px;">@weightModalProduct.Barcode</code>
                        </div>
                    }
                </div>

                <!-- Weight Input Field -->
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label style="font-weight: 700; font-size: 0.92rem; margin-bottom: 0.4rem; display: flex; justify-content: space-between;">
                        <span>الوزن المطلوب (@(weightModalProduct.BaseUnit ?? "كيلوجرام")):</span>
                        <span style="font-size: 0.8rem; color: var(--accent-emerald); font-weight: 600;">(بالكسور: 0.250 = ربع كيلو)</span>
                    </label>
                    <div style="position: relative;">
                        <input id="manual-weight-input"
                               type="number"
                               step="0.001"
                               min="0.001"
                               class="form-control"
                               @bind="enteredWeightString"
                               @bind:event="oninput"
                               @onkeyup="HandleWeightModalKeyUp"
                               style="font-size: 1.6rem; font-weight: 800; text-align: center; color: var(--accent-emerald); background: var(--bg-secondary); border: 2px solid var(--accent-emerald); border-radius: 0.6rem; padding: 0.6rem;" />
                        <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); font-weight: 700; color: var(--text-muted); font-size: 1rem;">
                            @(weightModalProduct.BaseUnit ?? "كجم")
                        </span>
                    </div>
                </div>

                <!-- Quick Weight Preset Buttons -->
                <div style="margin-bottom: 1.25rem;">
                    <label style="font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 0.35rem; display: block;">أوزان شائعة سريعة:</label>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.45rem;">
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(0.125m)">
                            1/8 كجم (125 جم)
                        </button>
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(0.250m)">
                            1/4 كجم (250 جم)
                        </button>
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(0.500m)">
                            1/2 كجم (500 جم)
                        </button>
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(0.750m)">
                            3/4 كجم (750 جم)
                        </button>
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(1.000m)">
                            1 كجم (1000 جم)
                        </button>
                        <button type="button" class="btn btn-secondary" style="font-size: 0.82rem; font-weight: 700; padding: 0.45rem;" @onclick="() => SetQuickWeight(2.000m)">
                            2 كجم
                        </button>
                    </div>
                </div>

                <!-- Live Calculated Total -->
                @{
                    decimal currentParsedWeight = decimal.TryParse(enteredWeightString, out var pw) ? pw : 0m;
                    decimal calculatedSubtotal = currentParsedWeight * weightModalProduct.SellingPrice;
                }
                <div style="background: var(--bg-secondary); border-radius: 0.6rem; padding: 0.85rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center; border: 1px dashed var(--border-color);">
                    <span style="font-size: 0.9rem; color: var(--text-secondary);">الإجمالي المحسوب:</span>
                    <strong style="font-size: 1.35rem; color: var(--accent-amber);">
                        @calculatedSubtotal.ToString("N2") <span style="font-size: 0.85rem;">ج.م</span>
                    </strong>
                </div>

                <!-- Modal Actions -->
                <div style="display: flex; gap: 0.75rem;">
                    <button type="button" class="btn btn-primary" style="flex: 2; padding: 0.65rem; font-size: 0.95rem; font-weight: 700; background: var(--accent-emerald); border-color: var(--accent-emerald);" @onclick="ConfirmWeightModal">
                        <i class="fa-solid fa-plus-circle me-1"></i> إضافة للسلة [Enter]
                    </button>
                    <button type="button" class="btn btn-secondary" style="flex: 1; padding: 0.65rem;" @onclick="CloseWeightModal">
                        إلغاء [Esc]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Customer Selection Modal -->
@if (showCustomerModal)
{
    <div class="modal-overlay" @onclick="CloseCustomerModal">
        <div class="modal-card" style="width: 580px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-user-tag me-2" style="color: var(--accent-amber);"></i>
                    اختيار أو إضافة عميل
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseCustomerModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(customerError))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @customerError
                    </div>
                }

                <!-- Toggle: Select Existing / Add New -->
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem;">
                    <button class="btn @(customerTab == "select" ? "btn-primary" : "btn-secondary")" style="flex: 1;" @onclick='() => customerTab = "select"'>
                        <i class="fa-solid fa-search me-1"></i> اختيار عميل موجود
                    </button>
                    <button class="btn @(customerTab == "new" ? "btn-primary" : "btn-secondary")" style="flex: 1;" @onclick='() => customerTab = "new"'>
                        <i class="fa-solid fa-user-plus me-1"></i> عميل جديد
                    </button>
                </div>

                @if (customerTab == "select")
                {
                    <!-- Search Existing Customers -->
                    <div class="search-box" style="margin-bottom: 1rem;">
                        <i class="fa-solid fa-search"></i>
                        <input id="pos-customer-search-input" @bind="customerSearchQuery" @bind:event="oninput" @onkeyup="FilterCustomers" placeholder="ابحث بالاسم أو رقم الهاتف..." />
                    </div>

                    <!-- Walk-in Customer Option -->
                    <div style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--border-color-light); background: @(Cart.CustomerId == null ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)");"
                         @onclick="SelectWalkInCustomer">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-amber); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.85rem;">
                                <i class="fa-solid fa-walking"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 0.9rem;">عميل نقدي (Walk-in)</div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">بدون تسجيل بيانات عميل</div>
                            </div>
                        </div>
                        @if (Cart.CustomerId == null)
                        {
                            <i class="fa-solid fa-check-circle" style="color: var(--accent-indigo); font-size: 1.1rem;"></i>
                        }
                    </div>

                    <!-- Customer List -->
                    <div style="max-height: 250px; overflow-y: auto;">
                        @foreach (var cust in filteredCustomers)
                        {
                            <div style="cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1rem; border-radius: 0.5rem; margin-bottom: 0.5rem; border: 1px solid var(--border-color-light); background: @(Cart.CustomerId == cust.Id ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)"); transition: all 0.15s ease;"
                                 @onclick="() => SelectCustomer(cust)">
                                <div style="display: flex; align-items: center; gap: 0.75rem;">
                                    <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-indigo), #4f46e5); display: flex; align-items: center; justify-content: center; color: white; font-size: 0.85rem; font-weight: 700;">
                                        @cust.Name.Substring(0, 1)
                                    </div>
                                    <div>
