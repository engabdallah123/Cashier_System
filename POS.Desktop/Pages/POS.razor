            }
        }
    }

    [JSInvokable]
    public async Task OnPosShortcutPressed(string key)
    {
        if (key == "F2")
        {
            if (showCustomerModal)
            {
                CloseCustomerModal();
            }
            else
            {
                await OpenCustomerModal();
            }
        }
        else if (key == "Enter")
        {
            if (showPaymentModal && !isProcessingSale)
            {
                await SubmitSale();
            }
            else if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
            {
                OpenPaymentModal();
            }
        }
        else if (key == "F4" || key == "F8")
        {
            if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
            {
                OpenPaymentModal();
            }
        }
        else if (key == "F9")
        {
            if (Cart.Items.Any())
            {
                Cart.Clear();
            }
            await FocusBarcodeAsync();
        }
        else if (key == "Escape")
        {
            if (showPaymentModal)
            {
                ClosePaymentModal();
            }
            else if (showCustomerModal)
            {
                CloseCustomerModal();
            }
            else if (Cart.Items.Any())
            {
                Cart.Clear();
                await FocusBarcodeAsync();
            }
            else
            {
                await FocusBarcodeAsync();
            }
        }
        StateHasChanged();
    }

