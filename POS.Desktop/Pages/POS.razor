    private async Task PromptCartonSize(Guid productId)
    {
        var item = Cart.Items.FirstOrDefault(i => i.ProductId == productId);
        if (item == null) return;

        var input = await JS.InvokeAsync<string?>("prompt", "أدخل عدد القطع في الكرتونة:", "12");
        if (int.TryParse(input, out var size) && size > 1)
        {
            Cart.SetCustomCartonSize(productId, size);
            Cart.ChangeItemUnit(productId, "Carton");
        }
    }

