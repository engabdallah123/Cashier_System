    private void OpenPaymentModal()
    {
        if (Cart.SubTotal > 0 && Cart.OverallDiscount > 0)
        {
            discountPercentage = Math.Round((Cart.OverallDiscount / Cart.SubTotal) * 100m, 1);
        }
        else
        {
            discountPercentage = 0;
        }

        paidAmount = Cart.GrandTotal;
        saleError = null;
        showPaymentModal = true;
        _ = FocusPaymentInputAsync();
    }

    private void ApplyDiscountPercent(decimal percent)
    {
        discountPercentage = Math.Clamp(percent, 0, 100);
        decimal discountAmount = Math.Round(Cart.SubTotal * (discountPercentage / 100m), 2);
        Cart.OverallDiscount = discountAmount;
        paidAmount = Cart.GrandTotal;
    }

    private void OnDiscountPercentInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var pct))
        {
            ApplyDiscountPercent(pct);
        }
        else
        {
            discountPercentage = 0;
            Cart.OverallDiscount = 0;
            paidAmount = Cart.GrandTotal;
        }
    }

    private void ClearDiscount()
    {
        discountPercentage = 0;
        Cart.OverallDiscount = 0;
        paidAmount = Cart.GrandTotal;
    }

