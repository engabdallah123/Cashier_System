    private void OnQuantityInputChanged(Guid productId, object? value)
    {
        if (value is not null && decimal.TryParse(value.ToString(), out var qty) && qty > 0)
        {
            var item = Cart.Items.FirstOrDefault(i => i.ProductId == productId);
            var prod = products.FirstOrDefault(p => p.Id == productId);
            if (prod != null && item != null)
            {
                decimal multiplier = item.SelectedUnit switch
                {
                    "Box" => item.PiecesPerBox > 1 ? item.PiecesPerBox : 1m,
                    "Carton" => item.CartonPieces > 1 ? item.CartonPieces : 1m,
                    _ => 1m
                };
                CheckAndTriggerStockAlert(prod, qty * multiplier);
            }
            Cart.UpdateQuantity(productId, qty);
        }
    }

