@code {
    public class PosAlertNotification
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string AlertType { get; set; } = "warning"; // "danger" or "warning"
        public string Icon { get; set; } = "fa-triangle-exclamation";
        public string DedupKey { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }

    private List<PosAlertNotification> activeAlerts = new();
    private bool showLowStockModal = false;
    private string lowStockSearch = string.Empty;

    // Depleted batches alert modal state
    public class DepletedBatchUiItem
    {
        public DepletedBatchDto Batch { get; set; } = default!;
        public decimal EnteredRemainingQty { get; set; } = 0;
        public bool IsReplenishing { get; set; } = false;
        public bool IsReplenished { get; set; } = false;
        public string? ErrorMessage { get; set; }
        public string? SuccessMessage { get; set; }
    }

    private bool showDepletedBatchesModal = false;
    private List<DepletedBatchUiItem> depletedBatchesList = new();

    private void ShowDepletedBatchesModal(IEnumerable<DepletedBatchDto> batches)
    {
        depletedBatchesList = batches.Select(b => new DepletedBatchUiItem
        {
            Batch = b,
            EnteredRemainingQty = 0
        }).ToList();
        showDepletedBatchesModal = true;
        StateHasChanged();
    }

    private void CloseDepletedBatchesModal()
    {
        showDepletedBatchesModal = false;
        depletedBatchesList.Clear();
        StateHasChanged();
    }

    private async Task ReplenishBatchItemAsync(DepletedBatchUiItem item)
    {
        if (item.EnteredRemainingQty <= 0)
        {
            item.ErrorMessage = "يرجى إدخال كمية متبقية أكبر من الصفر للتجديد.";
            return;
        }

        item.IsReplenishing = true;
        item.ErrorMessage = null;
        try
        {
            var (success, error) = await ApiClient.ReplenishBatchAsync(
                item.Batch.BatchId,
                item.EnteredRemainingQty,
                $"تجديد رصيد دفعة بعد الجرد الفعلي أثناء البيع (الكمية الأصلية: {item.Batch.OriginalQuantity})");

            if (success)
            {
                item.IsReplenished = true;
                item.SuccessMessage = $"تم تجديد رصيد الدفعة بنجاح (+{item.EnteredRemainingQty:G29} {item.Batch.OriginalUnit}). تم تعديل رصيد المخزن تلقائياً.";
                await LoadCatalogAsync();
            }
            else
            {
                item.ErrorMessage = error ?? "فشل تجديد رصيد الدفعة.";
            }
        }
        catch (Exception ex)
        {
            item.ErrorMessage = $"حدث خطأ: {ex.Message}";
        }
        finally
        {
            item.IsReplenishing = false;
            StateHasChanged();
        }
    }

    private int LowStockCount => products.Count(p => p.IsActive && p.QuantityInStock <= p.ReorderLevel);
    private IEnumerable<ProductDto> LowStockProductsList => products.Where(p => p.IsActive && p.QuantityInStock <= p.ReorderLevel);

    private IEnumerable<ProductDto> FilteredLowStockProducts =>
        LowStockProductsList.Where(p =>
            string.IsNullOrWhiteSpace(lowStockSearch) ||
            p.NameAr.Contains(lowStockSearch, StringComparison.OrdinalIgnoreCase) ||
            (p.Barcode != null && p.Barcode.Contains(lowStockSearch)));

    private void TriggerAlert(string title, string message, string alertType, string icon, string dedupKey)
    {
        if (!string.IsNullOrEmpty(dedupKey))
        {
            activeAlerts.RemoveAll(a => a.DedupKey == dedupKey);
        }

        var alert = new PosAlertNotification
        {
            Title = title,
            Message = message,
            AlertType = alertType,
            Icon = icon,
            DedupKey = dedupKey
        };

        activeAlerts.Insert(0, alert);
        if (activeAlerts.Count > 4)
        {
            activeAlerts.RemoveAt(activeAlerts.Count - 1);
        }
        StateHasChanged();

        // Auto-dismiss after 6.5 seconds
        _ = Task.Run(async () =>
        {
            await Task.Delay(6500);
            await InvokeAsync(() =>
            {
                activeAlerts.RemoveAll(a => a.Id == alert.Id);
                StateHasChanged();
            });
        });
    }

    private void DismissAlert(Guid id)
    {
        activeAlerts.RemoveAll(a => a.Id == id);
    }

    private void CheckAndTriggerStockAlert(ProductDto prod, decimal nextCartQty)
    {
        var remaining = prod.QuantityInStock - nextCartQty;
        if (remaining <= 0)
        {
            TriggerAlert(
                title: "⚠️ تحذير: نفاذ المخزون بالكامل!",
                message: $"المنتج: <strong style='color: #fff;'>{prod.NameAr}</strong><br />المتبقي بالمخزن: <strong style='color: #fecaca; font-size: 0.9rem;'>{remaining:N0}</strong> قطع (نفذ الرصيد تماماً)",
                alertType: "danger",
                icon: "fa-circle-xmark",
                dedupKey: $"stock_{prod.Id}");
        }
        else if (remaining <= prod.ReorderLevel)
        {
            TriggerAlert(
                title: "⚠️ تنبيه: الصنف وصل لحد الطلب!",
                message: $"المنتج: <strong style='color: #fff;'>{prod.NameAr}</strong><br />المتبقي بالمخزن: <strong style='color: #fef08a; font-size: 0.9rem;'>{remaining:N0}</strong> قطع (حد الطلب: {prod.ReorderLevel:N0})",
                alertType: "warning",
                icon: "fa-triangle-exclamation",
                dedupKey: $"stock_{prod.Id}");
        }
    }

    private void OpenLowStockModal()
    {
        showLowStockModal = true;
        lowStockSearch = string.Empty;
    }

    private void CloseLowStockModal()
    {
        showLowStockModal = false;
        lowStockSearch = string.Empty;
    }
    private ElementReference barcodeInputRef;
    private string scannedBarcode = string.Empty;
    private string searchTerm = string.Empty;

    private List<ProductDto> products = new();
    private List<ProductDto> filteredProducts = new();
    private List<CategoryDto> categories = new();
    private Guid? selectedCategoryId;

    private int currentPage = 1;
    private int pageSize = 36;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredProducts.Count / pageSize));

    private bool showWeightModal = false;
    private ProductDto? weightModalProduct;
    private string enteredWeightString = "0.250";

    private IEnumerable<ProductDto> PagedProducts =>
        filteredProducts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
            StateHasChanged();
        }
    }

    private void OnPageSizeChanged(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        StateHasChanged();
    }

    private bool isLoadingProducts = true;
    private bool showPaymentModal = false;
    private bool isProcessingSale = false;
    private string selectedPrintType = "thermal";
    private decimal paidAmount = 0;
    private decimal discountPercentage = 0;
    private string? saleError;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnCartChanged += StateHasChanged;
        if (AuthState.UserId != Guid.Empty && !Shift.IsShiftOpen)
        {
            var activeShift = await ApiClient.GetCurrentShiftAsync(AuthState.UserId);
            if (activeShift != null && activeShift.Status == "Open")
            {
                Shift.SetActiveShift(activeShift.Id, activeShift.OpenedAt, activeShift.OpeningCash);
            }
        }
        if (!StoreState.IsLoaded)
        {
            await StoreState.LoadSettingsAsync(ApiClient, JS);
        }
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        isLoadingProducts = true;
        try
        {
            var pTask = ApiClient.GetProductsAsync();
            var cTask = ApiClient.GetCategoriesAsync();

            await Task.WhenAll(pTask, cTask);

            products = (await pTask).Where(p => p.IsActive).ToList();
            categories = await cTask;
            SearchProducts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading catalog: {ex.Message}");
        }
        finally
        {
            isLoadingProducts = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FocusBarcodeAsync(int delay = 0)
    {
        try
        {
            await JS.InvokeVoidAsync("focusElementById", "pos-barcode-input", delay);
        }
        catch
        {
            // Ignore if component disposed or JS not ready
        }
    }

    private async Task HandleBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!string.IsNullOrWhiteSpace(scannedBarcode))
            {
                var code = scannedBarcode.Trim();
                scannedBarcode = string.Empty;

                // 1. Electronic Barcode Scale (EAN-13: e.g. 20 0101 00350 4)
                if (ScaleBarcodeHelper.IsScaleBarcode(code))
                {
                    var scaleResult = ScaleBarcodeHelper.Parse(code);
                    if (scaleResult.IsScaleBarcode)
                    {
                        ProductDto? scaleProd = null;

                        // Check in local loaded products first with candidate codes
                        foreach (var cand in scaleResult.CandidateCodes)
                        {
                            scaleProd = products.FirstOrDefault(p =>
                                p.IsWeighable &&
                                !string.IsNullOrWhiteSpace(p.Barcode) &&
                                string.Equals(p.Barcode.Trim(), cand, StringComparison.OrdinalIgnoreCase));
                            if (scaleProd != null) break;
                        }

                        // Try matching without leading zeros (e.g. 101 matching 0101)
                        if (scaleProd == null)
                        {
                            scaleProd = products.FirstOrDefault(p =>
                                p.IsWeighable &&
                                !string.IsNullOrWhiteSpace(p.Barcode) &&
                                (p.Barcode.Trim().TrimStart('0') == scaleResult.PluCode ||
                                 scaleResult.PluCode.TrimStart('0') == p.Barcode.Trim().TrimStart('0')));
                        }

                        // Try via API if not found locally
                        if (scaleProd == null)
                        {
                            foreach (var cand in scaleResult.CandidateCodes)
                            {
                                var p = await ApiClient.GetProductByBarcodeAsync(cand);
                                if (p != null && p.IsWeighable)
                                {
                                    scaleProd = p;
                                    break;
                                }
                            }
                        }

                        if (scaleProd != null)
                        {
                            AddWeighedProductToCart(scaleProd, scaleResult.WeightInKg);
                            await FocusBarcodeAsync();
                            return;
                        }
                        else
                        {
                            saleError = $"تمت قراءة استيكر ميزان بكود صنف ({scaleResult.PluCode}) ووزن ({scaleResult.WeightInKg:N3} كجم) لكن لم يتم العثور على صنف بالوزن مطابق في النظام. يرجى التأكد من تسجيل كود الصنف بالميزان.";
                            await FocusBarcodeAsync();
                            return;
                        }
                    }
                }

                // 2. Standard product barcode lookup
                var prod = await ApiClient.GetProductByBarcodeAsync(code);
                if (prod is not null)
                {
                    if (!prod.IsActive)
                    {
                        saleError = $"المنتج '{prod.NameAr}' غير نشط وموقوف عن البيع.";
                    }
                    else
                    {
                        AddToCart(prod);
                    }
                }
                else
                {
                    saleError = $"المنتج بالباركود '{code}' غير موجود.";
                }
                await FocusBarcodeAsync();
            }
            else
            {
                // Barcode is empty and user hit Enter -> Open payment checkout modal if cart has items!
                if (Cart.Items.Any() && !showPaymentModal && !showCustomerModal)
                {
                    OpenPaymentModal();
                }
            }
        }
    }

    private void AddToCart(ProductDto prod, string initialUnit = "Piece", bool initialWholesale = false)
    {
        if (!prod.IsActive)
        {
            saleError = $"المنتج '{prod.NameAr}' غير نشط وموقوف عن البيع.";
            return;
        }

        if (prod.IsWeighable)
        {
            OpenManualWeightModal(prod);
            return;
        }
        saleError = null;
        var existingInCart = Cart.Items.FirstOrDefault(i => i.ProductId == prod.Id);
        var nextQty = (existingInCart?.Quantity ?? 0) + 1;
        CheckAndTriggerStockAlert(prod, nextQty);
        var pkg = PackagingUnitHelper.Parse(prod.Description);
        int conversionFactor = prod.ConversionFactor > 1 
            ? prod.ConversionFactor 
            : (pkg.TotalPiecesPerCarton > 1 ? pkg.TotalPiecesPerCarton : 1);
        int ppb = pkg.PiecesPerBox;
        int bpc = conversionFactor > 1 ? conversionFactor : pkg.BoxesPerCarton;

        Cart.AddOrIncrementProduct(
            prod.Id, 
            prod.Barcode, 
            prod.NameAr, 
            prod.SellingPrice, 
            prod.WholesalePrice, 
            prod.TaxRate, 
            ppb, 
            bpc,
            conversionFactor,
            prod.BaseUnit,
            prod.ParentUnit ?? "كرتونة",
            initialUnit,
            initialWholesale);

        _ = FocusBarcodeAsync();
    }

    private void AddWeighedProductToCart(ProductDto prod, decimal weightInKg, bool initialWholesale = false)
    {
        if (!prod.IsActive)
        {
            saleError = $"صنف الميزان '{prod.NameAr}' غير نشط وموقوف عن البيع.";
            return;
        }
        saleError = null;
        var existingInCart = Cart.Items.FirstOrDefault(i => i.ProductId == prod.Id);
        var nextQty = (existingInCart?.Quantity ?? 0) + weightInKg;
        CheckAndTriggerStockAlert(prod, nextQty);

        Cart.AddOrIncrementWeighedProduct(
            prod.Id,
            prod.Barcode,
            prod.NameAr,
            prod.SellingPrice,
            prod.WholesalePrice,
            weightInKg,
            string.IsNullOrWhiteSpace(prod.BaseUnit) ? "كجم" : prod.BaseUnit,
            prod.TaxRate,
            initialWholesale);

        TriggerAlert(
            title: "⚖️ صنف بالميزان",
            message: $"تمت إضافة <strong style='color: #fff;'>{prod.NameAr}</strong><br />الوزن: <strong style='color: #34d399; font-size: 0.95rem;'>{weightInKg:N3}</strong> {prod.BaseUnit ?? "كجم"}",
            alertType: "success",
            icon: "fa-scale-balanced",
            dedupKey: $"weighed_{prod.Id}");

        _ = FocusBarcodeAsync();
    }

