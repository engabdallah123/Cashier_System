                <button type="button" class="btn btn-secondary" @onclick="CloseBatchDetailsModal">
                    إغلاق
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Persistent state across navigation & sessions
    private static int _savedPageSize = 10;
    private static string _savedStatusFilter = "all";
    private static string _savedActiveTab = "expiry";

    private string activeTab = _savedActiveTab; // expiry, waste

    // Batch Details Modal State
    private bool showBatchDetailsModal = false;
    private ExpiringProductDto? selectedBatchDetail;
    private List<WasteItemDto> selectedBatchWasteItems = new();
    private bool isLoadingBatchDetails = false;

    // Expiry Tab State
    private List<ExpiringProductDto> expiringProducts = new();
    private List<ExpiringProductDto> filteredList = new();
    private string searchQuery = string.Empty;
    private string statusFilter = _savedStatusFilter;
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = _savedPageSize;
    private IEnumerable<ExpiringProductDto> PagedItems =>
        filteredList.Skip((currentPage - 1) * pageSize).Take(pageSize);

    // Waste Report Tab State
    private WasteReportResponse? wasteReport;
    private bool isLoadingWaste = false;
    private string wasteSearchQuery = string.Empty;
    private string wasteReasonFilter = string.Empty;
    private int wasteCurrentPage = 1;

    private IEnumerable<WasteItemDto> FilteredWasteItems =>
        wasteReport?.Items.Where(w =>
            string.IsNullOrWhiteSpace(wasteSearchQuery) ||
            (w.ProductName?.Contains(wasteSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (w.ProductBarcode?.Contains(wasteSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (w.BatchNumber?.Contains(wasteSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
        ?? Enumerable.Empty<WasteItemDto>();

    private IEnumerable<WasteItemDto> PagedWasteItems =>
        FilteredWasteItems.Skip((wasteCurrentPage - 1) * pageSize).Take(pageSize);

    // Manual Waste Modal State
    private bool showManualWasteModal = false;
    private string wasteBarcodeQuery = string.Empty;
    private List<ProductDto> allProducts = new();
    private string selectedWasteProductId = string.Empty;
    private ProductDto? selectedWasteProduct;
    private List<ProductBatchDto> productBatches = new();
    private bool isLoadingBatches = false;
    private string selectedWasteBatchId = string.Empty;
    private ProductBatchDto? selectedWasteBatch;
    private string wasteSelectedUnit = "piece";
    private decimal wasteInputQuantity = 1;
    private string wasteModalReason = "انتهاء صلاحية";
    private string wasteModalNotes = string.Empty;
    private bool isSubmittingManualWaste = false;
    private string? manualWasteError = null;

    private decimal CalculatedLossAmount
    {
        get
        {
            if (selectedWasteBatch == null || wasteInputQuantity <= 0) return 0;
            decimal baseQty = wasteSelectedUnit == "carton" && selectedWasteProduct != null && selectedWasteProduct.ConversionFactor > 0
                ? wasteInputQuantity * selectedWasteProduct.ConversionFactor
                : wasteInputQuantity;
            return baseQty * selectedWasteBatch.UnitCost;
        }
    }

    private bool CanSubmitManualWaste =>
        selectedWasteProduct != null &&
        selectedWasteBatch != null &&
        wasteInputQuantity > 0 &&
        CalculatedPieces <= selectedWasteBatch.RemainingQuantity;

    private decimal CalculatedPieces =>
        wasteSelectedUnit == "carton" && selectedWasteProduct != null && selectedWasteProduct.ConversionFactor > 0
            ? wasteInputQuantity * selectedWasteProduct.ConversionFactor
            : wasteInputQuantity;

    protected override async Task OnInitializedAsync()
    {
        activeTab = _savedActiveTab;
        pageSize = _savedPageSize;
        statusFilter = _savedStatusFilter;

        await LoadData();
        await LoadAllProductsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string>("getPosSetting", "expiry_pageSize", _savedPageSize.ToString());
                if (int.TryParse(stored, out var ps) && ps > 0 && ps != pageSize)
                {
                    pageSize = ps;
                    _savedPageSize = ps;
                    EnsureValidPage();
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        pageSize = newSize;
        _savedPageSize = newSize;
        currentPage = 1;
        EnsureValidPage();
        try
        {
            await JS.InvokeVoidAsync("setPosSetting", "expiry_pageSize", newSize.ToString());
        }
        catch { }
    }

    private async Task HandleWastePageSizeChanged(int newSize)
    {
        pageSize = newSize;
        _savedPageSize = newSize;
        wasteCurrentPage = 1;
        EnsureValidWastePage();
        try
        {
            await JS.InvokeVoidAsync("setPosSetting", "expiry_pageSize", newSize.ToString());
        }
        catch { }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        _savedActiveTab = tab;
        if (tab == "waste" && wasteReport == null)
        {
            await LoadWasteReportAsync();
        }
    }

    private async Task RefreshActiveTab()
    {
        if (activeTab == "expiry")
            await LoadData();
        else
            await LoadWasteReportAsync();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            expiringProducts = await ApiClient.GetExpiringProductsAsync(null);
            FilterData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading expiring products: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadWasteReportAsync()
    {
        isLoadingWaste = true;
        try
        {
            wasteReport = await ApiClient.GetWasteReportAsync(reason: string.IsNullOrWhiteSpace(wasteReasonFilter) ? null : wasteReasonFilter);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading waste report: {ex.Message}");
        }
        finally
        {
            isLoadingWaste = false;
        }
    }

    private async Task LoadAllProductsAsync()
    {
        try
        {
            allProducts = await ApiClient.GetProductsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
    }

    private void SetFilter(string filter)
    {
        statusFilter = filter;
        _savedStatusFilter = filter;
        FilterData();
    }

    private void FilterData()
    {
        currentPage = 1;
        var query = expiringProducts.AsEnumerable();

        if (statusFilter == "expired")
        {
            query = query.Where(p => p.DaysRemaining < 0 && !p.IsDepleted && p.BatchRemainingQuantity > 0);
        }
        else if (statusFilter == "soon")
        {
            query = query.Where(p => p.DaysRemaining >= 0 && p.DaysRemaining <= 30 && !p.IsDepleted && p.BatchRemainingQuantity > 0);
        }
        else if (statusFilter == "valid")
        {
            query = query.Where(p => p.DaysRemaining > 30 && !p.IsDepleted && p.BatchRemainingQuantity > 0);
        }
        else if (statusFilter == "depleted")
        {
            query = query.Where(p => p.IsDepleted || p.BatchRemainingQuantity <= 0);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(p =>
                (p.ProductName != null && p.ProductName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (p.Barcode != null && p.Barcode.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (p.BatchNumber != null && p.BatchNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (p.SupplierName != null && p.SupplierName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (p.InvoiceNumber != null && p.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            );
        }

        filteredList = query.OrderBy(p => p.DaysRemaining).ToList();
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredList.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private void EnsureValidWastePage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)FilteredWasteItems.Count() / pageSize));
        if (wasteCurrentPage > maxPage) wasteCurrentPage = maxPage;
    }

    private async Task OpenManualWasteModal()
    {
        manualWasteError = null;
        wasteBarcodeQuery = string.Empty;
        selectedWasteProductId = string.Empty;
        selectedWasteProduct = null;
        productBatches.Clear();
        selectedWasteBatchId = string.Empty;
        selectedWasteBatch = null;
        wasteInputQuantity = 1;
        wasteSelectedUnit = "piece";
        wasteModalReason = "انتهاء صلاحية";
        wasteModalNotes = string.Empty;
        showManualWasteModal = true;
        if (!allProducts.Any()) await LoadAllProductsAsync();

        StateHasChanged();
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("focusElementById", "waste-barcode-input", 120);
        }
        catch { }
    }

    private async Task HandleWasteBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchProductByBarcodeAsync();
        }
    }

    private async Task SearchProductByBarcodeAsync()
    {
        var barcode = wasteBarcodeQuery?.Trim();
        if (string.IsNullOrWhiteSpace(barcode)) return;

        if (!allProducts.Any()) await LoadAllProductsAsync();

        var prod = allProducts.FirstOrDefault(p => string.Equals(p.Barcode, barcode, StringComparison.OrdinalIgnoreCase));
        if (prod == null)
        {
            try
            {
                prod = await ApiClient.GetProductByBarcodeAsync(barcode);
                if (prod != null && !allProducts.Any(p => p.Id == prod.Id))
                {
                    allProducts.Add(prod);
                }
            }
            catch { }
        }

        if (prod != null)
        {
            manualWasteError = null;
            selectedWasteProductId = prod.Id.ToString();
            await HandleProductSelection(prod.Id);
            wasteBarcodeQuery = string.Empty;
        }
        else
        {
            manualWasteError = $"لم يتم العثور على أي منتج بالباركود: {barcode}";
        }
    }

    private async Task PreselectBatchForWaste(ExpiringProductDto item)
    {
        if (item.IsDepleted || item.BatchRemainingQuantity <= 0)
        {
            await OpenBatchDetailsModal(item);
            return;
        }

        await OpenManualWasteModal();
        selectedWasteProductId = item.ProductId.ToString();
        await HandleProductSelection(item.ProductId);

        // Pre-select the exact batch
        if (item.BatchId != Guid.Empty)
        {
            var targetBatch = productBatches.FirstOrDefault(b => b.Id == item.BatchId);
            if (targetBatch != null)
            {
                selectedWasteBatch = targetBatch;
                selectedWasteBatchId = targetBatch.Id.ToString();
            }
        }
        else if (!string.IsNullOrWhiteSpace(item.BatchNumber))
        {
            var targetBatch = productBatches.FirstOrDefault(b => string.Equals(b.BatchNumber, item.BatchNumber, StringComparison.OrdinalIgnoreCase));
            if (targetBatch != null)
            {
                selectedWasteBatch = targetBatch;
                selectedWasteBatchId = targetBatch.Id.ToString();
            }
        }

        if (selectedWasteBatch != null)
        {
            wasteInputQuantity = selectedWasteBatch.RemainingQuantity;
        }
        else
        {
            wasteInputQuantity = item.BatchRemainingQuantity;
        }

        wasteSelectedUnit = "piece";
        wasteModalReason = item.DaysRemaining < 0 ? "انتهاء صلاحية" : "تلف سوء تخزين";
        wasteModalNotes = $"إهلاك من جدول متابعة الصلاحية - تشغيلة رقم: {item.BatchNumber}";
        StateHasChanged();
    }

    private async Task OpenBatchDetailsModal(ExpiringProductDto item)
    {
        selectedBatchDetail = item;
        showBatchDetailsModal = true;
        isLoadingBatchDetails = true;
        selectedBatchWasteItems.Clear();
        StateHasChanged();

        try
        {
            if (wasteReport == null)
            {
                await LoadWasteReportAsync();
            }

            if (wasteReport?.Items != null)
            {
                selectedBatchWasteItems = wasteReport.Items.Where(w =>
                    (item.BatchId != Guid.Empty && w.InventoryBatchId == item.BatchId) ||
                    (!string.IsNullOrWhiteSpace(item.BatchNumber) && string.Equals(w.BatchNumber, item.BatchNumber, StringComparison.OrdinalIgnoreCase)) ||
                    (w.ProductId == item.ProductId && item.WastedQuantity > 0 && Math.Abs(w.Quantity - item.WastedQuantity) < 0.01m)
                ).OrderByDescending(w => w.CreatedAt).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading batch details: {ex.Message}");
        }
        finally
        {
            isLoadingBatchDetails = false;
            StateHasChanged();
        }
    }

    private void CloseBatchDetailsModal()
    {
        showBatchDetailsModal = false;
        selectedBatchDetail = null;
        selectedBatchWasteItems.Clear();
    }

    private void CloseManualWasteModal()
    {
        showManualWasteModal = false;
        manualWasteError = null;
        wasteBarcodeQuery = string.Empty;
    }

    private async Task OnWasteProductSelected(ChangeEventArgs e)
    {
        var idStr = e.Value?.ToString();
        selectedWasteProductId = idStr ?? string.Empty;
        if (Guid.TryParse(idStr, out var prodId))
        {
            await HandleProductSelection(prodId);
        }
        else
        {
            selectedWasteProduct = null;
            productBatches.Clear();
            selectedWasteBatch = null;
        }
    }

    private async Task HandleProductSelection(Guid prodId)
    {
        selectedWasteProduct = allProducts.FirstOrDefault(p => p.Id == prodId);
        selectedWasteBatchId = string.Empty;
        selectedWasteBatch = null;
        isLoadingBatches = true;
        StateHasChanged();

        try
        {
            var batches = await ApiClient.GetProductBatchesAsync(prodId);
            productBatches = batches.Where(b => b.RemainingQuantity > 0).ToList();
            if (productBatches.Any())
            {
                // Auto select first batch
                selectedWasteBatch = productBatches.First();
                selectedWasteBatchId = selectedWasteBatch.Id.ToString();
            }
        }
        catch (Exception ex)
        {
            manualWasteError = $"فشل تحميل دفعات المنتج: {ex.Message}";
        }
        finally
        {
            isLoadingBatches = false;
            StateHasChanged();
        }
    }

    private void OnWasteBatchSelected(ChangeEventArgs e)
    {
        var batchIdStr = e.Value?.ToString();
        selectedWasteBatchId = batchIdStr ?? string.Empty;
        if (Guid.TryParse(batchIdStr, out var batchId))
        {
            selectedWasteBatch = productBatches.FirstOrDefault(b => b.Id == batchId);
        }
        else
        {
            selectedWasteBatch = null;
        }
    }

    private async Task SubmitManualWaste()
    {
        if (!CanSubmitManualWaste || selectedWasteProduct == null || selectedWasteBatch == null)
        {
            manualWasteError = "يرجى استيفاء كافة الحقول والتأكد من أن الكمية المدخلة لا تتجاوز الرصيد المتبقي بالدفعة.";
            return;
        }

        isSubmittingManualWaste = true;
        manualWasteError = null;

        try
        {
            var req = new RecordWasteRequest(
                selectedWasteProduct.Id,
                selectedWasteBatch.Id,
                wasteInputQuantity,
                wasteSelectedUnit,
                wasteModalReason,
                wasteModalNotes,
                Source: "Manual"
            );

            var (success, _, error) = await ApiClient.RecordWasteAsync(req);
            if (success)
            {
                CloseManualWasteModal();
                await LoadData();
                await LoadWasteReportAsync();
            }
            else
            {
                manualWasteError = error ?? "فشل تسجيل الهالك.";
            }
        }
        catch (Exception ex)
        {
            manualWasteError = $"حدث خطأ غير متوقع: {ex.Message}";
        }
        finally
        {
            isSubmittingManualWaste = false;
            StateHasChanged();
        }
    }
}
