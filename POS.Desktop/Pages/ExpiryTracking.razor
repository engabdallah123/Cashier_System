                        </div>
                    </div>
                    <div class="card" style="padding: 0.85rem; background: var(--bg-card); text-align: center; border-radius: 8px;">
                        <div style="font-size: 0.78rem; color: var(--text-secondary);">المتبقي بالدفعة</div>
                        <div style="font-size: 1.3rem; font-weight: 800; color: @(selectedBatchDetail.BatchRemainingQuantity <= 0 ? "#ef4444" : "#10b981"); margin-top: 0.2rem;">
                            @selectedBatchDetail.BatchRemainingQuantity.ToString("N0") <small style="font-size: 0.75rem;">قطعة</small>
                        </div>
                    </div>
                    <div class="card" style="padding: 0.85rem; background: var(--bg-card); text-align: center; border-radius: 8px;">
                        <div style="font-size: 0.78rem; color: var(--text-secondary);">إجمالي رصيد المخزن</div>
                        <div style="font-size: 1.3rem; font-weight: 800; color: var(--accent-indigo); margin-top: 0.2rem;">
                            @selectedBatchDetail.TotalProductStock.ToString("N0") <small style="font-size: 0.75rem;">قطعة</small>
                        </div>
                    </div>
                    <div class="card" style="padding: 0.85rem; background: var(--bg-card); text-align: center; border-radius: 8px;">
                        <div style="font-size: 0.78rem; color: var(--text-secondary);">إجمالي الهالك المسجل</div>
                        <div style="font-size: 1.3rem; font-weight: 800; color: var(--accent-red); margin-top: 0.2rem;">
                            @selectedBatchDetail.WastedQuantity.ToString("N0") <small style="font-size: 0.75rem;">قطعة</small>
                        </div>
                    </div>
                </div>

                <!-- Batch Details Info List -->
                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; margin-bottom: 1.25rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem;">
                        <div>
                            <span style="color: var(--text-secondary);">رقم التشغيلة (Batch):</span>
                            <strong style="color: var(--text-primary); margin-right: 0.4rem;">
                                <code>@(string.IsNullOrWhiteSpace(selectedBatchDetail.BatchNumber) ? "افتراضي" : selectedBatchDetail.BatchNumber)</code>
                            </strong>
                        </div>
                        <div>
                            <span style="color: var(--text-secondary);">تكلفة الشراء (للقطعة):</span>
                            <strong style="color: var(--accent-blue); margin-right: 0.4rem;">@selectedBatchDetail.UnitCost.ToString("N2") ج.م</strong>
                        </div>
                        <div>
                            <span style="color: var(--text-secondary);">تاريخ انتهاء الصلاحية:</span>
                            <strong style="color: var(--text-primary); margin-right: 0.4rem;">
                                @selectedBatchDetail.ExpiryDate.ToString("yyyy-MM-dd")
                            </strong>
                            <small style="color: @(selectedBatchDetail.DaysRemaining < 0 ? "var(--accent-red)" : "var(--accent-amber)");">
                                (@(selectedBatchDetail.DaysRemaining < 0 ? $"منتهية منذ {Math.Abs(selectedBatchDetail.DaysRemaining)} يوم" : $"متبقي {selectedBatchDetail.DaysRemaining} يوم"))
