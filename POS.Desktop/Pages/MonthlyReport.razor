@code {
    private int selectedYear = DateTime.Today.Year;
    private int selectedMonth = DateTime.Today.Month;
    private string selectedDisplayMetric = "Sales";
    private string selectedPaymentMethod = "All";
    private Guid? selectedCashierId = null;

    private bool isLoading = true;
    private MonthlySalesCalendarDto? calendarData;
    private List<UserManagementDto> users = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        await LoadReportAsync();
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            users = await ApiClient.GetUsersAsync();
        }
        catch
        {
            users = new();
        }
    }

    private async Task LoadReportAsync()
    {
        isLoading = true;
        try
        {
            calendarData = await ApiClient.GetMonthlySalesCalendarAsync(selectedYear, selectedMonth, selectedPaymentMethod, selectedCashierId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading monthly calendar: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
        {
            selectedMonth = m;
            await LoadReportAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            selectedYear = y;
            await LoadReportAsync();
        }
    }

    private async Task OnPaymentMethodChanged(ChangeEventArgs e)
    {
        selectedPaymentMethod = e.Value?.ToString() ?? "All";
        await LoadReportAsync();
    }

    private async Task OnCashierChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var cid) && cid != Guid.Empty)
        {
            selectedCashierId = cid;
        }
        else
        {
            selectedCashierId = null;
        }
        await LoadReportAsync();
    }

    private async Task PreviousMonth()
    {
        if (selectedMonth == 1)
        {
            selectedMonth = 12;
            selectedYear--;
        }
        else
        {
            selectedMonth--;
        }
        await LoadReportAsync();
    }

    private async Task NextMonth()
    {
        if (selectedMonth == 12)
        {
            selectedMonth = 1;
            selectedYear++;
        }
        else
        {
            selectedMonth++;
        }
        await LoadReportAsync();
    }

    private async Task GoToCurrentMonth()
    {
        selectedYear = DateTime.Today.Year;
        selectedMonth = DateTime.Today.Month;
        await LoadReportAsync();
    }

    private decimal GetMetricValue(MonthlyDaySalesDto day)
    {
        return selectedDisplayMetric switch
        {
            "Sales" => day.TotalSales,
            "NetSales" => day.NetSales,
            "Collected" => day.TotalPaid,
            "Credit" => day.CreditSales,
            "Invoices" => day.InvoiceCount,
            "Expenses" => day.TotalExpenses,
            "Purchases" => day.TotalPurchases,
            _ => day.NetSales
        };
    }

    private string FormatMetricDisplay(decimal val)
    {
        if (val <= 0) return string.Empty;
        if (selectedDisplayMetric == "Invoices") return $"{val:N0}";
        return $"{val:N2}";
    }

    private void OnDayClicked(MonthlyDaySalesDto day)
    {
        Nav.NavigateTo($"sales?date={day.Date:yyyy-MM-dd}");
    }

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportCsv()
    {
        if (calendarData is null || !calendarData.Days.Any()) return;

        var csv = new System.Text.StringBuilder();
        csv.AppendLine("اليوم,التاريخ,يوم الأسبوع,إجمالي المبيعات,عدد الفواتير,المرتجعات,صافي المبيعات,المبالغ المحصلة,المصروفات,المشتريات");

        foreach (var d in calendarData.Days)
        {
            csv.AppendLine($"{d.DayNumber},{d.Date:yyyy-MM-dd},{d.DayNameAr},{d.TotalSales},{d.InvoiceCount},{d.TotalReturns},{d.NetSales},{d.TotalPaid},{d.TotalExpenses},{d.TotalPurchases}");
        }

        csv.AppendLine();
        csv.AppendLine($"المجموع الشهري,,,{calendarData.TotalMonthlySales},{calendarData.TotalMonthlyInvoices},{calendarData.TotalMonthlyReturns},{calendarData.NetMonthlySales},,{calendarData.TotalMonthlyExpenses},{calendarData.TotalMonthlyPurchases}");
        csv.AppendLine($"متوسط المبيعات اليومية,,,{calendarData.DailyAverageSales}");

        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"Monthly_Sales_Report_{selectedYear}_{selectedMonth:D2}.csv";
        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv;charset=utf-8", base64);
    }

    private void GoBack()
    {
        Nav.NavigateTo("home");
    }

    private static string GetArabicMonthName(int month)
    {
        return month switch
        {
            1 => "يناير",
            2 => "فبراير",
            3 => "مارس",
            4 => "أبريل",
            5 => "مايو",
            6 => "يونيو",
            7 => "يوليو",
            8 => "أغسطس",
            9 => "سبتمبر",
            10 => "أكتوبر",
            11 => "نوفمبر",
            12 => "ديسمبر",
            _ => $"شهر {month}"
        };
    }
}
