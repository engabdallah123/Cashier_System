@page "/monthly-report"
@page "/monthly-sales"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Printing
@attribute [Authorize(Roles = "Admin,Manager,Administrator")]
@inject PosApiClient ApiClient
@inject IInvoicePrinterService Printer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CustomAuthStateProvider AuthState

<div>
    <!-- Standard Page Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title">تقرير المبيعات الشهري</h2>
            <p class="page-subtitle">استعراض نتيجة ومبيعات كل يوم ومتوسط الدخل الشهري</p>
        </div>
        <div class="header-actions no-print" style="display: flex; gap: 0.6rem; align-items: center;">
            <button type="button" class="btn btn-secondary" @onclick="LoadReportAsync" disabled="@isLoading" title="تحديث البيانات">
                <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "") me-1"></i>
                <span>تحديث</span>
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ExportCsv" title="تصدير إكسل CSV">
                <i class="fa-solid fa-file-excel me-1 text-green"></i>
                <span>تصدير CSV</span>
            </button>
            <button type="button" class="btn btn-primary" @onclick="PrintReport" title="طباعة التقرير الشهري">
                <i class="fa-solid fa-print me-1"></i>
                <span>طباعة</span>
            </button>
        </div>
    </div>

    <!-- Filter Controls Bar -->
    <div class="monthly-filters-card no-print">
        <div class="filters-grid">
            <!-- 1. الشهر -->
            <div class="filter-item">
                <label class="filter-label"><i class="fa-regular fa-calendar"></i> شهر</label>
                <div class="month-selector-group">
                    <button type="button" class="btn-nav-month" @onclick="PreviousMonth" title="الشهر السابق">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                    <select class="form-select filter-select" value="@selectedMonth" @onchange="OnMonthChanged">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@GetArabicMonthName(m)</option>
                        }
                    </select>
                    <button type="button" class="btn-nav-month" @onclick="NextMonth" title="الشهر القادم">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                </div>
            </div>

            <!-- 2. السنة -->
            <div class="filter-item">
                <label class="filter-label"><i class="fa-solid fa-calendar-check"></i> سنة</label>
                <select class="form-select filter-select" value="@selectedYear" @onchange="OnYearChanged">
                    @for (int y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 3; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>

            <!-- 3. نوع العرض -->
            <div class="filter-item">
                <label class="filter-label"><i class="fa-solid fa-chart-pie"></i> نوع العرض</label>
                <select class="form-select filter-select" @bind="selectedDisplayMetric">
                    <option value="Sales">إجمالي المبيعات (نقدي + آجل)</option>
                    <option value="NetSales">صافي المبيعات (بعد المرتجع)</option>
                    <option value="Collected">المبالغ المحصلة فعلياً (كاش + تحصيل)</option>
                    <option value="Credit">المبيعات الآجلة (ديون)</option>
                    <option value="Invoices">عدد الفواتير</option>
                    <option value="Expenses">المصروفات اليومية</option>
                    <option value="Purchases">المشتريات اليومية</option>
                </select>
            </div>

            <!-- 4. نوع البيع -->
            <div class="filter-item">
                <label class="filter-label"><i class="fa-solid fa-money-bill-wave"></i> نوع البيع</label>
                <select class="form-select filter-select" value="@selectedPaymentMethod" @onchange="OnPaymentMethodChanged">
                    <option value="All">كل انواع المبيعات</option>
                    <option value="Cash">نقدي (كاش)</option>
                    <option value="Credit">آجل (ذمم)</option>
                    <option value="Visa">فيزا / بطاقة</option>
                </select>
            </div>

            <!-- 5. الكاشير (اختياري) -->
            @if (users.Any())
            {
                <div class="filter-item">
                    <label class="filter-label"><i class="fa-solid fa-user-tag"></i> الكاشير</label>
                    <select class="form-select filter-select" value="@selectedCashierId" @onchange="OnCashierChanged">
                        <option value="">كل الكاشير</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.FullName</option>
                        }
                    </select>
                </div>
            }

            <div class="filter-item current-month-btn-wrapper">
                <button type="button" class="btn btn-current-month" @onclick="GoToCurrentMonth">
                    <i class="fa-solid fa-clock-rotate-left"></i> الشهر الحالي
                </button>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards Row -->
    @if (calendarData is not null)
    {
        <div class="quick-stats-row no-print">
            <!-- 1. صافي المبيعات -->
            <div class="stat-mini-card card-accent-green">
                <div class="stat-mini-header">
                    <div class="stat-mini-icon text-green-bg"><i class="fa-solid fa-sack-dollar"></i></div>
                    <span class="stat-mini-title">صافي المبيعات (شامل النقدي والآجل)</span>
                </div>
                <div class="stat-mini-val text-green">@calendarData.NetMonthlySales.ToString("N2") <small class="currency-label">ج.م</small></div>
                <div class="stat-mini-tags">
                    <span class="stat-mini-tag tag-cash"><i class="fa-solid fa-money-bill-wave"></i> نقدي: @calendarData.TotalMonthlyCashSales.ToString("N0")</span>
                    <span class="stat-mini-tag tag-credit"><i class="fa-solid fa-clock"></i> آجل: @calendarData.TotalMonthlyCreditSales.ToString("N0")</span>
                </div>
            </div>

            <!-- 2. المقبوض والمحصل الفعلي -->
            <div class="stat-mini-card card-accent-blue">
                <div class="stat-mini-header">
                    <div class="stat-mini-icon text-blue-bg"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                    <span class="stat-mini-title">المقبوض والمحصل الفعلي (كاش)</span>
                </div>
                <div class="stat-mini-val text-blue">@calendarData.TotalMonthlyCollected.ToString("N2") <small class="currency-label">ج.م</small></div>
                <div class="stat-mini-tags">
                    <span class="stat-mini-tag tag-cash">مبيعات: @calendarData.TotalMonthlyCashSales.ToString("N0")</span>
                    <span class="stat-mini-tag tag-collected">تحصيلات: @calendarData.TotalMonthlyDebtCollections.ToString("N0")</span>
                </div>
            </div>

            <!-- 3. الديون الآجلة الجديدة -->
            <div class="stat-mini-card card-accent-amber">
                <div class="stat-mini-header">
                    <div class="stat-mini-icon text-amber-bg"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <span class="stat-mini-title">الديون الآجلة الجديدة</span>
                </div>
                <div class="stat-mini-val text-amber">@calendarData.TotalMonthlyCreditSales.ToString("N2") <small class="currency-label">ج.م</small></div>
                <div class="stat-mini-tags">
                    <span class="stat-mini-tag tag-credit"><i class="fa-solid fa-triangle-exclamation"></i> ذمم معلقة على فواتير الشهر</span>
                </div>
            </div>

            <!-- 4. إجمالي المرتجعات -->
            <div class="stat-mini-card card-accent-red">
                <div class="stat-mini-header" title="إجمالي المرتجعات">
                    <div class="stat-mini-icon text-red-bg"><i class="fa-solid fa-rotate-left"></i></div>
                    <span class="stat-mini-title">إجمالي المرتجعات</span>
                </div>
                <div class="stat-mini-val text-red">@calendarData.TotalMonthlyReturns.ToString("N2") <small class="currency-label">ج.م</small></div>
                <div class="stat-mini-tags">
                    @if (calendarData.TotalMonthlyReturns > 0)
                    {
                        <span class="stat-mini-tag tag-returns"><i class="fa-solid fa-arrow-right-arrow-left"></i> مستردات للعملاء</span>
                    }
                    else
                    {
                        <span class="stat-mini-tag tag-returns" style="opacity: 0.75;"><i class="fa-solid fa-check"></i> لا توجد مرتجعات</span>
                    }
                </div>
            </div>

            <!-- 5. عدد الفواتير -->
            <div class="stat-mini-card card-accent-purple">
                <div class="stat-mini-header" title="عدد الفواتير">
                    <div class="stat-mini-icon text-purple-bg"><i class="fa-solid fa-receipt"></i></div>
                    <span class="stat-mini-title">عدد الفواتير</span>
                </div>
                <div class="stat-mini-val text-purple">@calendarData.TotalMonthlyInvoices <small class="unit-label">فاتورة</small></div>
                <div class="stat-mini-tags">
                    <span class="stat-mini-tag tag-purple"><i class="fa-solid fa-basket-shopping"></i> إجمالي العمليات</span>
                </div>
            </div>

            <!-- 6. أيام العمل والنشاط -->
            <div class="stat-mini-card card-accent-indigo">
                <div class="stat-mini-header" title="أيام العمل والنشاط">
                    <div class="stat-mini-icon text-indigo-bg"><i class="fa-solid fa-calendar-check"></i></div>
                    <span class="stat-mini-title">أيام العمل والنشاط</span>
                </div>
                <div class="stat-mini-val text-indigo">
                    <span>@calendarData.ActiveDaysCount</span>
                    <span class="active-days-total">/ @calendarData.DaysInMonth</span>
                    <small class="unit-label">يوم</small>
                </div>
                <div class="stat-mini-tags">
                    <span class="stat-mini-tag tag-indigo"><i class="fa-solid fa-chart-line"></i> أيام فيها حركة بيع</span>
                </div>
            </div>
        </div>
    }

    <!-- Main Calendar Area (Modern Advanced Clean Style) -->
    <div class="calendar-container-card">
        @if (isLoading)
        {
            <div class="calendar-loading-state">
                <i class="fa-solid fa-circle-notch fa-spin fa-3x text-blue"></i>
                <p>جاري تحميل وحساب مبيعات شهر @GetArabicMonthName(selectedMonth) @selectedYear...</p>
            </div>
        }
        else if (calendarData is not null)
        {
            <!-- Print Only Header -->
            <div class="print-header-section print-only">
                <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 15px;">
                    <h2 style="font-size: 20pt; font-weight: 800; margin: 0;">تقرير المبيعات الشهرية</h2>
                    <h3 style="font-size: 14pt; margin: 5px 0;">شهر: @calendarData.MonthNameAr @calendarData.Year</h3>
                    <p style="font-size: 10pt; color: #444; margin: 0;">تاريخ الطباعة: @DateTime.Now.ToString("yyyy/MM/dd HH:mm")</p>
                </div>
            </div>

            <div class="calendar-grid-table">
                <!-- Days of Week Header Row (RTL: السبت -> الجمعة) -->
                <div class="calendar-week-header">
                    <div class="week-header-cell">السبت</div>
                    <div class="week-header-cell">الأحد</div>
                    <div class="week-header-cell">الإثنين</div>
                    <div class="week-header-cell">الثلاثاء</div>
                    <div class="week-header-cell">الأربعاء</div>
                    <div class="week-header-cell">الخميس</div>
                    <div class="week-header-cell">الجمعة</div>
                </div>

                <!-- Calendar Days Cells Grid -->
                <div class="calendar-days-grid">
                    <!-- 1. Leading Empty Cells (Offset before 1st of month) -->
                    @for (int emptyIdx = 0; emptyIdx < calendarData.FirstDayDayOfWeek; emptyIdx++)
                    {
                        <div class="day-cell day-cell-empty">
                            <span class="empty-pattern"></span>
                        </div>
                    }

                    <!-- 2. Active Month Days -->
                    @foreach (var day in calendarData.Days)
                    {
                        bool isPeak = calendarData.HighestSalesDay == day.DayNumber && day.TotalSales > 0;
                        decimal metricValue = GetMetricValue(day);
                        string metricText = FormatMetricDisplay(metricValue);

                        <div class="day-cell @(day.HasSales ? "has-sales" : "no-sales") @(day.IsToday ? "is-today" : "") @(isPeak ? "is-peak-day" : "")"
                             @onclick="() => OnDayClicked(day)"
                             title="اضغط لعرض وتفاصيل فواتير يوم @day.DayNumber @calendarData.MonthNameAr">

                            <div class="day-cell-top">
                                @if (isPeak)
                                {
                                    <span class="peak-badge" title="أعلى يوم مبيعات في الشهر"><i class="fa-solid fa-star"></i> أعلى يوم</span>
                                }
                                else if (day.IsToday)
                                {
                                    <span class="today-badge">اليوم</span>
                                }
                                else
                                {
                                    <span></span>
                                }

                                <span class="day-number-badge">@day.DayNumber</span>
                            </div>

                            <div class="day-cell-content">
                                @if (metricValue > 0)
                                {
                                    <div class="modern-metric-value">
                                        @metricText
                                    </div>
                                    <div class="day-sub-stat">
                                        @if (selectedDisplayMetric == "Invoices")
                                        {
                                            <span>@day.NetSales.ToString("N0") ج.م</span>
                                        }
                                        else
                                        {
                                            <span><i class="fa-solid fa-receipt me-1"></i>@day.InvoiceCount فاتورة</span>
                                            @if (day.TotalReturns > 0)
                                            {
                                                <span style="color: #ef4444; font-weight: 700; margin-right: 3px;" title="مرتجعات اليوم: @day.TotalReturns.ToString("N2") ج.م">(-@day.TotalReturns.ToString("N0"))</span>
                                            }
                                            @if (day.CreditSales > 0)
                                            {
                                                <span style="color: var(--accent-amber); font-weight: 700; margin-right: 2px;" title="مبيعات آجلة: @day.CreditSales.ToString("N2") ج.م">(آجل:@day.CreditSales.ToString("N0"))</span>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="modern-metric-value empty-metric">
                                        —
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3. Trailing Empty Cells to fill last row -->
                    @{
                        int totalRendered = calendarData.FirstDayDayOfWeek + calendarData.DaysInMonth;
                        int trailingCount = (7 - (totalRendered % 7)) % 7;
                    }
                    @for (int t = 0; t < trailingCount; t++)
                    {
                        <div class="day-cell day-cell-empty">
                            <span class="empty-pattern"></span>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom Summary & Action Bar (Modern Sleek Style) -->
            <div class="monthly-summary-footer">
                <div class="footer-left-actions no-print">
                    <button type="button" class="btn btn-secondary" @onclick="GoBack" title="العودة للرئيسية">
                        <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> خروج
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="ExportCsv" title="تصدير شيت إكسيل CSV">
                        <i class="fa-solid fa-file-excel me-1 text-green"></i> تصدير إكسيل
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="PrintReport" title="طباعة تقرير المبيعات الشهري A4">
                        <i class="fa-solid fa-print me-1"></i> طباعة التقرير
                    </button>
                </div>

                <div class="footer-metrics-display">
                    <!-- Daily Average Display Card -->
                    <div class="modern-footer-card">
                        <div class="footer-card-icon text-blue-bg">
                            <i class="fa-solid fa-calculator text-blue"></i>
                        </div>
                        <div class="footer-card-body">
                            <span class="footer-card-label">متوسط المبيعات اليومية</span>
                            <div class="footer-card-val text-blue">
                                @calendarData.DailyAverageSales.ToString("N2") <small class="currency-label">ج.م</small>
                            </div>
                            <span class="footer-card-sub"><i class="fa-solid fa-calendar-day"></i> لكل يوم عمل نشط</span>
                        </div>
                    </div>

                    <!-- Total Monthly Sales Display Card -->
                    <div class="modern-footer-card highlight-card">
                        <div class="footer-card-icon text-green-bg">
                            <i class="fa-solid fa-sack-dollar text-green"></i>
                        </div>
                        <div class="footer-card-body">
                            <span class="footer-card-label">صافي المبيعات الشهري الكلي (شامل النقدي والآجل)</span>
                            <div class="footer-card-val text-green">
                                @calendarData.NetMonthlySales.ToString("N2") <small class="currency-label">ج.م</small>
                            </div>
                            <div class="footer-card-tags">
                                <span class="footer-badge badge-cash"><i class="fa-solid fa-money-bill-wave"></i> نقدي: @calendarData.TotalMonthlyCashSales.ToString("N0")</span>
                                <span class="footer-badge badge-credit"><i class="fa-solid fa-clock"></i> آجل: @calendarData.TotalMonthlyCreditSales.ToString("N0")</span>
                                <span class="footer-badge badge-collected"><i class="fa-solid fa-vault"></i> محصل كلي: @calendarData.TotalMonthlyCollected.ToString("N0")</span>
                                @if (calendarData.TotalMonthlyReturns > 0)
                                {
                                    <span class="footer-badge badge-returns"><i class="fa-solid fa-rotate-left"></i> خصم مرتجعات: @calendarData.TotalMonthlyReturns.ToString("N2") ج.م</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Monthly Report Container */
    .monthly-filters-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.85rem 1.15rem;
        margin-bottom: 1.25rem;
        box-shadow: var(--shadow-sm);
    }
    .filters-grid {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .filter-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .filter-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--text-secondary);
        white-space: nowrap;
        margin: 0;
    }
    .filter-select {
        height: 38px;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        min-width: 140px;
    }
    .month-selector-group {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .btn-nav-month {
        width: 32px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color-light);
        border-radius: 8px;
        color: var(--text-primary);
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .btn-nav-month:hover {
        background: var(--accent-indigo);
        color: #fff;
    }
    .current-month-btn-wrapper {
        margin-right: auto;
    }
    .btn-current-month {
        height: 38px;
        background: rgba(99, 102, 241, 0.1);
        color: var(--accent-indigo);
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: 8px;
        padding: 0 0.9rem;
        font-size: 0.82rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s ease;
    }
    .btn-current-month:hover {
        background: var(--accent-indigo);
        color: #fff;
    }

    /* Quick Stats Mini Cards */
    .quick-stats-row {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        width: 100%;
    }
    @@media (max-width: 1280px) {
        .quick-stats-row {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.85rem;
        }
    }
    @@media (max-width: 768px) {
        .quick-stats-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.75rem;
        }
    }
    @@media (max-width: 480px) {
        .quick-stats-row {
            grid-template-columns: 1fr;
        }
    }

    .stat-mini-card {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 0.75rem 0.85rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.4rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
        transition: all 0.22s ease;
        min-height: 108px;
    }
    .stat-mini-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.22);
        border-color: rgba(255, 255, 255, 0.16);
    }
    .stat-mini-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        left: 0;
        height: 3px;
        background: transparent;
    }
    .card-accent-green::before { background: var(--accent-green, #10b981); }
    .card-accent-blue::before { background: var(--accent-blue, #38bdf8); }
    .card-accent-amber::before { background: var(--accent-amber, #f59e0b); }
    .card-accent-red::before { background: var(--accent-red, #ef4444); }
    .card-accent-purple::before { background: var(--accent-purple, #8b5cf6); }
    .card-accent-indigo::before { background: var(--accent-indigo, #6366f1); }

    .stat-mini-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }
    .stat-mini-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
    }
    .text-green-bg { background: rgba(16, 185, 129, 0.14); color: var(--accent-green, #10b981); }
    .text-blue-bg { background: rgba(56, 189, 248, 0.14); color: var(--accent-blue, #38bdf8); }
    .text-amber-bg { background: rgba(245, 158, 11, 0.14); color: var(--accent-amber, #f59e0b); }
    .text-red-bg { background: rgba(239, 68, 68, 0.14); color: var(--accent-red, #ef4444); }
    .text-purple-bg { background: rgba(139, 92, 246, 0.14); color: var(--accent-purple, #8b5cf6); }
    .text-indigo-bg { background: rgba(99, 102, 241, 0.14); color: var(--accent-indigo, #6366f1); }

    .stat-mini-title {
        font-size: 0.74rem;
        color: var(--text-secondary);
        font-weight: 700;
        line-height: 1.25;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .stat-mini-val {
