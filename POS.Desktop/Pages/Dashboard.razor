@code {
    private DashboardDataDto? data;
    private bool isLoading = true;
    private string selectedPreset = "today";

    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    private DateTime customFromDate = DateTime.Today;
    private DateTime customToDate = DateTime.Today;

    private bool showTopProductsModal = false;
    private string topProductsSearch = string.Empty;

    // Expiry Notifications and Waste Modal State
    private List<ExpiryNotificationDto> activeExpiryNotifications = new();
    private bool showWasteModal = false;
    private ExpiryNotificationDto? wasteNotificationTarget;
    private decimal wasteQuantity = 1;
    private string wasteReason = "انتهاء صلاحية";
    private string wasteNotes = string.Empty;
    private bool isSubmittingWaste = false;
    private string? wasteError = null;

    private void OpenTopProductsModal()
    {
        showTopProductsModal = true;
        topProductsSearch = string.Empty;
    }

    private void CloseTopProductsModal()
    {
        showTopProductsModal = false;
        topProductsSearch = string.Empty;
    }

    private IEnumerable<TopProductDto> FilteredTopProducts =>
        data?.TopSellingProducts?.Where(p =>
            string.IsNullOrWhiteSpace(topProductsSearch) ||
            (p.Name?.Contains(topProductsSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (p.Barcode?.Contains(topProductsSearch, StringComparison.OrdinalIgnoreCase) ?? false))
        ?? Enumerable.Empty<TopProductDto>();

    protected override async Task OnInitializedAsync()
    {
        await SetFilterPreset("today");
    }

    private async Task SetFilterPreset(string preset)
    {
        selectedPreset = preset;
        var now = DateTime.Now;

        switch (preset)
        {
            case "today":
                filterFromDate = now.Date;
                filterToDate = now.Date.AddDays(1).AddTicks(-1);
                break;
            case "month":
                filterFromDate = new DateTime(now.Year, now.Month, 1);
                filterToDate = filterFromDate.Value.AddMonths(1).AddTicks(-1);
                break;
            case "year":
                filterFromDate = new DateTime(now.Year, 1, 1);
                filterToDate = filterFromDate.Value.AddYears(1).AddTicks(-1);
                break;
            case "all":
                filterFromDate = null;
                filterToDate = null;
                break;
            case "custom":
                filterFromDate = customFromDate.Date;
                filterToDate = customToDate.Date.AddDays(1).AddTicks(-1);
                break;
        }

        await LoadDashboardDataAsync();
    }

    private async Task ApplyCustomDateFilter()
    {
        filterFromDate = customFromDate.Date;
        filterToDate = customToDate.Date.AddDays(1).AddTicks(-1);
        await LoadDashboardDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        isLoading = true;
        StateHasChanged();
        data = await ApiClient.GetDashboardAsync(filterFromDate, filterToDate);
        await LoadExpiryNotificationsAsync();
        isLoading = false;
        StateHasChanged();
    }

    private async Task LoadExpiryNotificationsAsync()
    {
        try
        {
            activeExpiryNotifications = await ApiClient.GetExpiryNotificationsAsync(includeSnoozed: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading expiry notifications: {ex.Message}");
            activeExpiryNotifications = new();
        }
    }

    private async Task ResolveNotification(ExpiryNotificationDto notification)
    {
        try
        {
            var (success, _) = await ApiClient.ResolveNotificationAsync(notification.Id);
            if (success)
            {
                activeExpiryNotifications.RemoveAll(n => n.Id == notification.Id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving notification: {ex.Message}");
        }
    }

    private async Task SnoozeNotification(ExpiryNotificationDto notification)
    {
        try
        {
            var (success, _) = await ApiClient.SnoozeNotificationAsync(notification.Id, 24);
            if (success)
            {
                activeExpiryNotifications.RemoveAll(n => n.Id == notification.Id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error snoozing notification: {ex.Message}");
        }
    }

    private void OpenWasteModal(ExpiryNotificationDto notification)
    {
        wasteNotificationTarget = notification;
        wasteQuantity = notification.RemainingQuantity;
        wasteReason = "انتهاء صلاحية";
        wasteNotes = $"تم التسجيل من تنبيه الصلاحية للدفعة {notification.BatchNumber}";
        wasteError = null;
        showWasteModal = true;
    }

    private void CloseWasteModal()
    {
        showWasteModal = false;
        wasteNotificationTarget = null;
        wasteError = null;
        isSubmittingWaste = false;
    }

    private async Task ExecuteRecordWaste()
    {
        if (wasteNotificationTarget == null || wasteQuantity <= 0 || wasteQuantity > wasteNotificationTarget.RemainingQuantity)
        {
            wasteError = "يرجى تحديد كمية صحيحة لا تتجاوز الكمية المتبقية بالدفعة.";
            return;
        }

        isSubmittingWaste = true;
        wasteError = null;
        StateHasChanged();

        try
        {
            var req = new RecordWasteRequest(
                wasteNotificationTarget.ProductId,
                wasteNotificationTarget.BatchId,
                wasteQuantity,
                "piece",
                wasteReason,
                wasteNotes
            );

            var (success, _, error) = await ApiClient.RecordWasteAsync(req);
            if (success)
            {
                // Auto resolve notification since waste action taken
                await ApiClient.ResolveNotificationAsync(wasteNotificationTarget.Id);
                CloseWasteModal();
                // Refresh dashboard to reflect new waste losses and updated notification list
                await LoadDashboardDataAsync();
            }
            else
            {
                wasteError = error ?? "تعذر تسجيل الهالك. يرجى المحاولة مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            wasteError = $"حدث خطأ غير متوقع: {ex.Message}";
        }
        finally
        {
            isSubmittingWaste = false;
            StateHasChanged();
        }
    }


    private string GetPeriodTitle()
    {
        return selectedPreset switch
        {
            "today" => "اليوم",
            "month" => "هذا الشهر",
            "year" => "هذه السنة",
            "all" => "كل الأوقات (التقرير الشامل)",
            "custom" => $"من {filterFromDate?.ToString("yyyy/MM/dd")} إلى {filterToDate?.ToString("yyyy/MM/dd")}",
            _ => "الفترة المحددة"
        };
    }

    private string GetPaymentName(string method) => method?.ToLower() switch
    {
        "cash" => "نقدي (Cash)",
        "card" or "visa" => "بطاقة / شبكة (Card)",
        "wallet" => "محفظة إلكترونية (Wallet)",
        "credit" => "آجل / حساب عميل (Credit)",
        _ => method ?? "نقدي"
    };

    private string GetPaymentIcon(string method) => method?.ToLower() switch
    {
        "cash" => "fa-solid fa-money-bill-wave text-green",
        "card" or "visa" => "fa-solid fa-credit-card text-blue",
        "wallet" => "fa-solid fa-mobile-screen-button text-purple",
        "credit" => "fa-solid fa-user-clock text-amber",
        _ => "fa-solid fa-coins text-indigo"
    };

    private string GetPaymentProgressColor(string method) => method?.ToLower() switch
    {
        "cash" => "pm-fill-cash",
        "card" or "visa" => "pm-fill-card",
        "wallet" => "pm-fill-wallet",
        "credit" => "pm-fill-credit",
        _ => "pm-fill-default"
    };
}
