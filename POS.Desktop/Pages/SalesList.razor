@page "/sales"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Printing
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject IInvoicePrinterService Printer
@inject NavigationManager Nav

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">سجل فواتير المبيعات</h2>
            <p class="page-subtitle">استعراض المبيعات والبحث بالتاريخ وطباعة الإيصالات</p>
        </div>
        <div>
            <NavLink href="monthly-report" class="btn btn-secondary" style="font-size: 0.85rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
                <i class="fa-solid fa-calendar-days text-amber"></i>
                <span>نتيجة المبيعات الشهرية</span>
            </NavLink>
        </div>
    </div>

    @if (filterDate.HasValue)
    {
        <div class="date-filter-banner" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(99, 102, 241, 0.1)); border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 12px; padding: 0.85rem 1.25rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.2); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
                <div>
                    <h4 style="margin: 0; font-size: 1.05rem; font-weight: 800; color: var(--text-primary);">
                        فواتير مبيعات يوم: @filterDate.Value.ToString("dddd، dd MMMM yyyy", ArabicCulture)
                    </h4>
                    <span style="font-size: 0.82rem; color: var(--text-secondary);">
                        إجمالي <strong style="color: var(--text-primary);">@filteredSales.Count</strong> فاتورة بإجمالي مبيعات: <strong style="color: var(--accent-emerald);">@filteredSales.Sum(s => s.TotalAmount).ToString("N2") ج.م</strong>
                    </span>
                </div>
            </div>

            <div style="display: flex; gap: 0.6rem; align-items: center;">
                <button type="button" class="btn btn-secondary" style="padding: 0.4rem 0.85rem; font-size: 0.82rem; font-weight: 700;" @onclick="ClearDateFilter">
                    <i class="fa-solid fa-xmark me-1 text-red"></i> عرض كل الفواتير
                </button>
                <NavLink href="monthly-report" class="btn btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.82rem; font-weight: 700;">
                    <i class="fa-solid fa-arrow-right me-1"></i> العودة للتقرير الشهري
                </NavLink>
            </div>
        </div>
    }

    <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: center; flex-wrap: wrap;">
        <div class="search-box" style="max-width: 380px; flex: 1;">
            <i class="fa-solid fa-search"></i>
            <input @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterSales" placeholder="ابحث برقم الفاتورة أو اسم الكاشير..." />
        </div>

        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <label style="font-size: 0.82rem; font-weight: 700; color: var(--text-secondary);">تاريخ محدد:</label>
            <input type="date" class="form-input" style="height: 38px; padding: 0.3rem 0.6rem; font-size: 0.85rem; border-radius: 8px;" value="@dateInputString" @onchange="OnCustomDateChanged" />
            @if (filterDate.HasValue)
            {
                <button type="button" class="btn btn-secondary" style="height: 38px; padding: 0 0.6rem; font-size: 0.8rem;" @onclick="ClearDateFilter" title="مسح التاريخ">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            }
        </div>

        <div style="font-size: 0.85rem; color: var(--text-secondary); margin-right: auto;">
            إجمالي الفواتير: <strong style="color: var(--text-primary);">@filteredSales.Count</strong>
        </div>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>التاريخ والوقت</th>
                    <th>الكاشير</th>
                    <th>طريقة الدفع</th>
                    <th>الخصم</th>
                    <th>الضريبة</th>
                    <th>المبلغ الإجمالي</th>
                    <th style="width: 130px; text-align: center;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                            <p style="margin-top: 0.5rem;">جاري تحميل سجل المبيعات...</p>
                        </td>
                    </tr>
                }
                else if (!filteredSales.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-receipt" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                            لا توجد فواتير مبيعات مطابقة.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sale in PagedSales)
                    {
                        <tr>
                            <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@sale.InvoiceNumber</code></td>
                            <td>@sale.SaleDate.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt", ArabicCulture)</td>
                            <td>@(string.IsNullOrWhiteSpace(sale.CashierName) ? "مستخدم كاشير" : sale.CashierName)</td>
                            <td>
                                <span class="badge @(sale.PaymentMethod == "Cash" ? "badge-green" : "badge-indigo")">
                                    @(sale.PaymentMethod == "Cash" ? "نقداً (كاش)" : sale.PaymentMethod)
                                </span>
                            </td>
                            <td style="color: var(--accent-amber);">@sale.DiscountAmount.ToString("N2") ج.م</td>
                            <td>@sale.TaxAmount.ToString("N2") ج.م</td>
                            <td style="color: @(sale.TotalAmount < 0 ? "var(--accent-red)" : "var(--accent-emerald)"); font-weight: 700;">
                                @(sale.TotalAmount < 0 ? $"-{Math.Abs(sale.TotalAmount):N2}" : sale.TotalAmount.ToString("N2")) ج.م
                            </td>
                            <td style="text-align: center;">
                                <div style="display: flex; gap: 0.35rem; justify-content: center;">
                                    <button class="btn btn-primary" style="padding: 0.35rem 0.65rem; font-size: 0.78rem;" @onclick="() => PrintPdf(sale.Id, isThermal: true)" title="طباعة فاتورة حرارية 80mm">
                                        <i class="fa-solid fa-receipt me-1"></i> حرارية
                                    </button>
                                    <button class="btn btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.78rem;" @onclick="() => PrintPdf(sale.Id, isThermal: false)" title="طباعة فاتورة A4">
                                        <i class="fa-solid fa-file-pdf me-1"></i> A4
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="@currentPage" TotalItems="@filteredSales.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; EnsureValidPage(); })" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "date")]
    public string? DateQueryParam { get; set; }

    private List<SaleDto> sales = new();
    private List<SaleDto> filteredSales = new();

    private DateTime? filterDate;
    private string dateInputString = string.Empty;

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<SaleDto> PagedSales => filteredSales.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private string searchQuery = string.Empty;
    private bool isLoading = true;

    private static readonly CultureInfo ArabicCulture = new("ar-EG");

    protected override async Task OnInitializedAsync()
    {
        await LoadSales();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(DateQueryParam) && DateTime.TryParse(DateQueryParam, out var parsedDate))
        {
            filterDate = parsedDate.Date;
            dateInputString = filterDate.Value.ToString("yyyy-MM-dd");
            FilterSales();
        }
    }

    private async Task LoadSales()
    {
        isLoading = true;
        sales = await ApiClient.GetSalesListAsync();
        
        if (!string.IsNullOrWhiteSpace(DateQueryParam) && DateTime.TryParse(DateQueryParam, out var parsedDate))
        {
            filterDate = parsedDate.Date;
            dateInputString = filterDate.Value.ToString("yyyy-MM-dd");
        }

        FilterSales();
        isLoading = false;
    }

    private void FilterSales()
    {
        currentPage = 1;
        var list = sales.AsEnumerable();

        if (filterDate.HasValue)
        {
            list = list.Where(s => s.SaleDate.ToLocalTime().Date == filterDate.Value.Date);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            list = list.Where(s =>
                s.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (s.CashierName != null && s.CashierName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));
        }

        filteredSales = list.ToList();
        EnsureValidPage();
    }

    private void OnCustomDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (DateTime.TryParse(val, out var dt))
        {
            filterDate = dt.Date;
            dateInputString = dt.ToString("yyyy-MM-dd");
        }
        else
        {
            filterDate = null;
            dateInputString = string.Empty;
        }
        FilterSales();
    }

    private void ClearDateFilter()
    {
        filterDate = null;
        dateInputString = string.Empty;
        FilterSales();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredSales.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private async Task PrintPdf(Guid saleId, bool isThermal = false)
    {
        try
        {
            await Printer.PrintInvoiceAsync(saleId, isThermal);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error printing invoice: {ex.Message}");
        }
    }
}
