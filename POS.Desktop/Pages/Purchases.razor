    private void CheckEnteredExpiryDate(DateTime dt)
    {
        var today = DateTime.Today;
        if (dt.Date <= today)
        {
            var daysPast = (today - dt.Date).Days;
            TriggerExpiryAlert(
                "⚠️ تحذير: تاريخ الصلاحية المدخل منتهي بالفعل!",
                $"تاريخ الصلاحية الذي أدخلته (<strong style='color:#fff;'>{dt:dd/MM/yyyy}</strong>) مضى عليه {daysPast} يوم! يرجى مراجعة صلاحية البضاعة.",
                isExpired: true);
        }
        else if (dt.Date <= today.AddDays(30))
        {
            var daysLeft = (dt.Date - today).Days;
            TriggerExpiryAlert(
                "⚠️ تنبيه: تاريخ الصلاحية المدخل يقترب من الانتهاء!",
                $"البضاعة الجديدة تنتهي بعد <strong style='color:#fff;'>{daysLeft} يوم فقط</strong> ({dt:dd/MM/yyyy})! انتبه لفترة تصريفها بالمخزن.",
                isExpired: false);
        }
    }

    private decimal baseProductPieceCost = 0;
    private decimal editBaseProductPieceCost = 0;

    private int ResolveProductCartonFactor(ProductDto? prod)
    {
        if (prod == null) return 12;
        if (prod.ConversionFactor > 1) return prod.ConversionFactor;
        var pkg = PackagingUnitHelper.Parse(prod.Description);
        if (pkg.TotalPiecesPerCarton > 1) return pkg.TotalPiecesPerCarton;
        return 12;
    }

    private void OnUnitTypeChanged(ChangeEventArgs e)
    {
        selectedUnitType = e.Value?.ToString() ?? "piece";
        UpdateAddItemCostByUnit();
    }

    private void UpdateAddItemCostByUnit()
    {
        if (baseProductPieceCost <= 0) return;

        decimal factor = (selectedUnitType == "carton")
            ? Math.Max(1, addItemCartonFactor)
            : 1m;

        addItemCost = Math.Round(baseProductPieceCost * factor, 2);
    }

    private void OnCartonFactorChanged()
    {
        if (addItemCartonFactor < 1) addItemCartonFactor = 1;
        if (baseProductPieceCost > 0)
        {
            addItemCost = Math.Round(baseProductPieceCost * addItemCartonFactor, 2);
        }
        else if (addItemCost > 0)
        {
            baseProductPieceCost = addItemCost / addItemCartonFactor;
        }
    }

    private void OnEditUnitTypeChanged(ChangeEventArgs e)
    {
        editSelectedUnitType = e.Value?.ToString() ?? "piece";
        UpdateEditAddItemCostByUnit();
    }

    private void UpdateEditAddItemCostByUnit()
    {
        if (editBaseProductPieceCost <= 0) return;

        decimal factor = (editSelectedUnitType == "carton")
            ? Math.Max(1, editAddItemCartonFactor)
            : 1m;

        editAddItemCost = Math.Round(editBaseProductPieceCost * factor, 2);
    }

    private void OnEditCartonFactorChanged()
    {
        if (editAddItemCartonFactor < 1) editAddItemCartonFactor = 1;
        if (editBaseProductPieceCost > 0)
        {
            editAddItemCost = Math.Round(editBaseProductPieceCost * editAddItemCartonFactor, 2);
        }
        else if (editAddItemCost > 0)
        {
            editBaseProductPieceCost = editAddItemCost / editAddItemCartonFactor;
        }
    }

    private void OnAddItemCostChanged()
    {
        decimal factor = (selectedUnitType == "carton")
            ? Math.Max(1, addItemCartonFactor)
            : 1m;

        if (factor > 0 && addItemCost > 0)
        {
            baseProductPieceCost = addItemCost / factor;
        }
    }

    private void OnEditAddItemCostChanged()
    {
        decimal factor = (editSelectedUnitType == "carton")
            ? Math.Max(1, editAddItemCartonFactor)
            : 1m;

        if (factor > 0 && editAddItemCost > 0)
        {
            editBaseProductPieceCost = editAddItemCost / factor;
        }
    }

