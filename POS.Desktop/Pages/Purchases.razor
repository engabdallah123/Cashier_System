    private async Task HandleEditBarcodeKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(editScannedBarcode))
        {
            var code = editScannedBarcode.Trim();
            editScannedBarcode = string.Empty;

            ProductDto? prod = null;
            decimal? parsedWeight = null;

            if (ScaleBarcodeHelper.IsScaleBarcode(code))
            {
                var scaleResult = ScaleBarcodeHelper.Parse(code);
                if (scaleResult.IsScaleBarcode && scaleResult.CandidateCodes != null && scaleResult.CandidateCodes.Any())
                {
                    prod = availableProducts.FirstOrDefault(p =>
                        p.IsWeighable &&
                        scaleResult.CandidateCodes.Any(c => string.Equals(p.Barcode, c, StringComparison.OrdinalIgnoreCase)));
                    if (prod != null)
                    {
                        parsedWeight = scaleResult.WeightInKg;
                    }
                }
            }

            if (prod is null)
            {
                prod = availableProducts.FirstOrDefault(p => string.Equals(p.Barcode, code, StringComparison.OrdinalIgnoreCase));
            }
            if (prod is null)
            {
                prod = await ApiClient.GetProductByBarcodeAsync(code);
            }

            if (prod is not null)
            {
                editSelectedProductIdString = prod.Id.ToString();
                editCurrentProductPackaging = PackagingUnitHelper.Parse(prod.Description);
                editAddItemCartonFactor = ResolveProductCartonFactor(prod);
                editSelectedUnitType = prod.IsWeighable ? "weight" : "piece";
                editBaseProductPieceCost = prod.PurchasePrice > 0 ? prod.PurchasePrice : prod.SellingPrice;
                editAddItemCost = editBaseProductPieceCost;
                if (parsedWeight.HasValue && parsedWeight.Value > 0)
                {
                    editAddItemQty = parsedWeight.Value;
                }
                else
                {
                    editAddItemQty = prod.IsWeighable ? 1.000m : 1m;
                }

                if (prod.TrackExpiry)
                {
                    editAddItemProductionDate ??= editPurchaseDate.Date;
                    editAddItemProductionDateStr = editAddItemProductionDate.Value.ToString("dd/MM/yyyy");
                    int days = prod.ShelfLifeDays > 0 ? prod.ShelfLifeDays : 365;
                    editAddItemExpiryDate = editAddItemProductionDate.Value.Date.AddDays(days);
                }
                else
                {
                    editAddItemProductionDate = null;
                    editAddItemProductionDateStr = string.Empty;
                    editAddItemExpiryDate = null;
                }
                errorMessage = string.Empty;
                CheckProductStockExpiry(prod);
            }
            else
            {
                errorMessage = $"المنتج بالباركود '{code}' غير موجود.";
            }
        }
    }

    private void AddEditPurchaseLineItem()
    {
        if (!Guid.TryParse(editSelectedProductIdString, out var pId) || pId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار المنتج أولاً.";
            return;
        }

        if (editAddItemQty <= 0 || editAddItemCost <= 0)
        {
            errorMessage = "الرجاء إدخال كمية وسعر شراء صحيحين.";
            return;
        }

        var prod = availableProducts.FirstOrDefault(p => p.Id == pId);
        string unitName = prod != null && prod.IsWeighable
            ? (string.IsNullOrWhiteSpace(prod.BaseUnit) ? "كجم" : prod.BaseUnit)
            : (editSelectedUnitType == "carton" ? (prod?.ParentUnit ?? "كرتونة") : (prod?.BaseUnit ?? "قطعة"));

        editPurchaseItems.Add(new CreatePurchaseItemRequest(
            pId,
            editAddItemQty,
            editAddItemCost,
            ExpiryDate: (prod != null && prod.TrackExpiry) ? editAddItemExpiryDate : null,
            BatchNumber: null,
            Unit: unitName));

        editAddItemQty = 1;
        editAddItemCost = 0;
        editBaseProductPieceCost = 0;
        editAddItemProductionDate = null;
        editAddItemProductionDateStr = string.Empty;
        editAddItemExpiryDate = null;
        editAddItemBatchNumber = null;
        editSelectedUnitType = "piece";
        editSelectedProductIdString = string.Empty;
        errorMessage = string.Empty;
    }


    private void UpdateEditItemQty(CreatePurchaseItemRequest item, object? val)
    {
        if (val != null && decimal.TryParse(val.ToString(), out var q) && q > 0)
        {
            var idx = editPurchaseItems.IndexOf(item);
            if (idx >= 0)
            {
                editPurchaseItems[idx] = item with { Quantity = q };
            }
        }
    }

    private void UpdateEditItemCost(CreatePurchaseItemRequest item, object? val)
    {
        if (val != null && decimal.TryParse(val.ToString(), out var c) && c >= 0)
        {
            var idx = editPurchaseItems.IndexOf(item);
            if (idx >= 0)
            {
                editPurchaseItems[idx] = item with { UnitCost = c };
            }
        }
    }

    private async Task SaveEditPurchase()
    {
        if (!editingPurchaseId.HasValue) return;

        if (!Guid.TryParse(editSupplierIdString, out var supId) || supId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار المورد.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editPurchaseInvoiceNumber))
        {
            errorMessage = "الرجاء إدخال رقم الفاتورة.";
            return;
        }

        if (!editPurchaseItems.Any())
        {
            errorMessage = "الرجاء إضافة صنف واحد على الأقل في فاتورة الشراء.";
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        var userId = AuthState.UserId != Guid.Empty ? AuthState.UserId : Guid.Parse("00000000-0000-0000-0000-000000000001");
        var req = new UpdatePurchaseRequest(
            Id: editingPurchaseId.Value,
            InvoiceNumber: editPurchaseInvoiceNumber,
            SupplierId: supId,
            UserId: userId,
            Items: editPurchaseItems,
            InternalNumber: null,
            DiscountAmount: 0,
            TaxAmount: 0,
            PaidAmount: editPurchasePaidAmount,
            PaymentMethod: 1,
            Notes: editPurchaseNotes,
            PurchaseDate: editPurchaseDate);

        var (success, error) = await ApiClient.UpdatePurchaseAsync(editingPurchaseId.Value, req);
        isSaving = false;

        if (success)
        {
            CloseModals();
            await LoadData();
        }
        else
        {
            errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل تعديل فاتورة الشراء.";
        }
    }

