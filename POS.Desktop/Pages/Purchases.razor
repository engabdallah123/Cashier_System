    private void SetExpiryFilter(string status)
    {
        expiryFilterStatus = status;
        FilterExpiringProducts();
    }

    private void FilterExpiringProducts()
    {
        expiryCurrentPage = 1;
        var q = expiringProducts.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchQueryExpiry))
        {
            q = q.Where(p => (p.ProductName != null && p.ProductName.Contains(searchQueryExpiry, StringComparison.OrdinalIgnoreCase))
                          || (p.Barcode != null && p.Barcode.Contains(searchQueryExpiry, StringComparison.OrdinalIgnoreCase)));
        }
        if (expiryFilterStatus == "expired")
        {
            q = q.Where(p => p.DaysRemaining < 0);
        }
        else if (expiryFilterStatus == "soon")
        {
            q = q.Where(p => p.DaysRemaining >= 0 && p.DaysRemaining <= 30);
        }
        else if (expiryFilterStatus == "valid")
        {
            q = q.Where(p => p.DaysRemaining > 30);
        }
        filteredExpiringProducts = q.ToList();
        EnsureValidExpiryPage();
    }

    private void EnsureValidExpiryPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredExpiringProducts.Count / pageSize));
        if (expiryCurrentPage > maxPage) expiryCurrentPage = maxPage;
    }

