@page "/purchases"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@using global::POS.Desktop.Services.State
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject CustomAuthStateProvider AuthState
@inject PurchaseDraftStateContainer DraftState
@inject IJSRuntime JS
@inject global::POS.Desktop.Services.Sync.ICloudSyncService CloudSync
@implements IDisposable

<div>
    <!-- Live Floating Expiry Alerts Container -->
    @if (activeExpiryAlerts.Any())
    {
        <div class="stock-alerts-floating-container" style="z-index: 10050;">
            @foreach (var alert in activeExpiryAlerts)
            {
                <div class="stock-alert-toast @(alert.IsExpired ? "alert-danger" : "alert-warning")" @key="alert.Id">
                    <div class="alert-icon">
                        <i class="fa-solid @(alert.IsExpired ? "fa-circle-xmark" : "fa-triangle-exclamation")"></i>
                    </div>
                    <div class="alert-content">
                        <div class="alert-title">@alert.Title</div>
                        <div class="alert-msg">@((MarkupString)alert.Message)</div>
                    </div>
                    <button class="alert-close-btn" @onclick="() => DismissExpiryAlert(alert.Id)" title="إغلاق التنبيه">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            }
        </div>
    }

    <div class="page-header">
        <div>
            <h2 class="page-title">إدارة المشتريات والموردين</h2>
            <p class="page-subtitle">تسجيل فواتير توريد البضائع وإدارة بيانات الموردين</p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button class="btn btn-secondary" style="font-weight: 700; display: inline-flex; align-items: center; gap: 0.45rem; background: rgba(56, 189, 248, 0.15); border: 1.5px solid #38bdf8; color: #38bdf8;" @onclick="TriggerCloudSync" disabled="@CloudSync.IsSyncing" title="مزامنة فواتير المشتريات المسجلة من تطبيق الموبايل">
                <i class="fa-solid fa-cloud-arrow-down @(CloudSync.IsSyncing ? "fa-spin" : "")"></i>
                <span>@(CloudSync.IsSyncing ? "جارِ المزامنة..." : "مزامنة السحاب ☁️")</span>
            </button>
            <NavLink href="expiry" class="btn btn-secondary" style="font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
                <i class="fa-solid fa-clock-rotate-left text-amber"></i>
                <span>متابعة صلاحية المنتجات</span>
            </NavLink>
            <button class="btn btn-secondary" @onclick="OpenAddSupplierModal">
                <i class="fa-solid fa-user-plus me-1"></i> إضافة مورد جديد
            </button>
            <button class="btn btn-primary" @onclick="OpenAddPurchaseModal">
                <i class="fa-solid fa-cart-plus me-1"></i> تسجيل فاتورة شراء
            </button>
        </div>
    </div>

    <!-- Cloud Sync Status Toast Alert -->
    @if (showSyncToast)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(14, 165, 233, 0.15); border: 1.5px solid #0284c7; color: #bae6fd; border-radius: 0.75rem; padding: 0.75rem 1.25rem; margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <i class="fa-solid fa-cloud-arrow-down" style="font-size: 1.2rem; color: #38bdf8;"></i>
                <span style="font-weight: 600;">@syncToastMessage</span>
            </div>
            <button type="button" style="background: none; border: none; color: #bae6fd; cursor: pointer; font-size: 1rem;" @onclick="() => showSyncToast = false">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- Draft Stock Invoice Recovery Alert Banner -->
    @if (DraftState.HasDraft && !showAddPurchaseModal)
    {
        <div class="draft-notice-banner" style="background: linear-gradient(90deg, rgba(245, 158, 11, 0.15), rgba(234, 88, 12, 0.1)); border: 1.5px solid #f59e0b; border-radius: 0.75rem; padding: 0.9rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);">
            <div style="display: flex; align-items: center; gap: 0.85rem;">
                <div style="width: 42px; height: 42px; border-radius: 50%; background: rgba(245, 158, 11, 0.2); display: flex; align-items: center; justify-content: center; color: #fbbf24; font-size: 1.25rem;">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <div style="font-weight: 700; color: #fef08a; font-size: 1rem;">
                        ⚠️ توجد مسودة فاتورة مخزون غير محفوظة مسبقاً!
                    </div>
                    <div style="font-size: 0.85rem; color: #cbd5e1; margin-top: 0.2rem;">
                        تحتوي سلة المخزون على <strong>@DraftState.ItemsCount صنف</strong> بإجمالي <strong style="color: #34d399;">@DraftState.TotalAmount.ToString("N2") ج.م</strong>. يمكنك استرجاعها لمتابعة إدخال البضائع أو حفظها.
                    </div>
                </div>
            </div>
            <div style="display: flex; gap: 0.6rem; align-items: center;">
                <button class="btn btn-primary" style="background: #10b981; border-color: #059669; font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;" @onclick="RestoreDraftInvoice">
                    <i class="fa-solid fa-folder-open"></i>
                    <span>استرجاع الفاتورة ومتابعة الإدخال</span>
                </button>
                <button class="btn btn-secondary" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; font-weight: 600; display: inline-flex; align-items: center; gap: 0.4rem;" @onclick="DiscardDraftInvoice">
                    <i class="fa-solid fa-trash"></i>
                    <span>حذف المسودة</span>
                </button>
            </div>
        </div>
    }

    <!-- Navigation Tabs & Search -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button class="btn @(activeTab == "purchases" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "purchases"'>
                <i class="fa-solid fa-truck-ramp-box me-1"></i> فواتير المشتريات (@filteredPurchases.Count)
            </button>
            <button class="btn @(activeTab == "suppliers" ? "btn-primary" : "btn-secondary")" @onclick='() => activeTab = "suppliers"'>
                <i class="fa-solid fa-users me-1"></i> قائمة الموردين (@filteredSuppliers.Count)
            </button>
        </div>
        @if (activeTab == "purchases")
        {
            <div class="search-box" style="max-width: 320px;">
                <i class="fa-solid fa-search"></i>
                <input @bind="searchQueryPurchases" @bind:event="oninput" @onkeyup="FilterPurchases" placeholder="بحث برقم الفاتورة أو المورد..." />
            </div>
        }
        else if (activeTab == "suppliers")
        {
            <div class="search-box" style="max-width: 320px;">
                <i class="fa-solid fa-search"></i>
                <input @bind="searchQuerySuppliers" @bind:event="oninput" @onkeyup="FilterSuppliers" placeholder="بحث باسم المورد أو الهاتف..." />
            </div>
        }
    </div>

    @if (activeTab == "purchases")
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ الشراء</th>
                        <th>المورد</th>
                        <th>المبلغ الإجمالي</th>
                        <th>المبلغ المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                        <th style="width: 130px; text-align: center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                                <p style="margin-top: 0.5rem;">جاري تحميل المشتريات...</p>
                            </td>
                        </tr>
                    }
                    else if (!filteredPurchases.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-truck-ramp-box" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                                لا توجد فواتير مشتريات مسجلة حالياً.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pur in PagedPurchases)
                        {
                            <tr>
                                <td>
                                    <code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@pur.InvoiceNumber</code>
                                    @if (pur.Notes?.Contains("وارد من تطبيق الموبايل") == true)
                                    {
                                        <span class="badge" style="background: rgba(14, 165, 233, 0.2); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.4); margin-right: 0.35rem; font-size: 0.72rem;">
                                            <i class="fa-solid fa-mobile-screen"></i> موبايل
                                        </span>
                                    }
                                </td>
                                <td>@pur.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="font-weight: 600;">@pur.SupplierName</td>
                                <td style="color: var(--accent-amber); font-weight: 700;">@pur.TotalAmount.ToString("N2") ج.م</td>
                                <td style="color: var(--accent-emerald);">@pur.PaidAmount.ToString("N2") ج.م</td>
                                <td style="color: var(--accent-red);">@pur.RemainingAmount.ToString("N2") ج.م</td>
                                <td>
                                    <span class="badge @(pur.Status == "Received" ? "badge-green" : (pur.Status == "Draft" ? "badge-amber" : "badge-indigo"))">
                                        @(pur.Status == "Received" ? "تم الاستلام" : (pur.Status == "Draft" ? "مسودة (غير مستلمة)" : pur.Status))
                                    </span>
                                </td>
                                <td style="text-align: center;">
                                    <div class="action-dropdown-container">
                                        <button class="action-dropdown-btn @(activeMenuPurchaseId == pur.Id ? "active" : "")" @onclick="() => TogglePurchaseMenu(pur.Id)">
                                            <i class="fa-solid fa-sliders"></i>
                                            <span>خيارات</span>
                                            <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i>
                                        </button>
                                        @if (activeMenuPurchaseId == pur.Id)
                                        {
                                            <div class="action-dropdown-backdrop" @onclick="ClosePurchaseMenu"></div>
                                            <div class="action-dropdown-menu" @onclick:stopPropagation="true">
                                                <button class="action-dropdown-item item-primary" @onclick="async () => { ClosePurchaseMenu(); await OpenDetailsModal(pur); }">
                                                    <i class="fa-solid fa-eye" style="color: var(--accent-blue);"></i>
                                                    <span>عرض التفاصيل</span>
                                                </button>
                                                <button class="action-dropdown-item item-primary" @onclick="async () => { ClosePurchaseMenu(); await OpenEditPurchaseModal(pur); }">
                                                    <i class="fa-solid fa-pen-to-square" style="color: var(--accent-amber);"></i>
                                                    <span>تعديل الفاتورة</span>
                                                </button>
                                                @if (pur.Status == "Draft")
                                                {
                                                    <button class="action-dropdown-item item-success" @onclick="async () => { ClosePurchaseMenu(); await ReceivePurchase(pur); }">
                                                        <i class="fa-solid fa-box-open" style="color: var(--accent-emerald);"></i>
                                                        <span>تأكيد استلام البضاعة</span>
                                                    </button>
                                                }
                                                @if (pur.RemainingAmount > 0)
                                                {
                                                    <button class="action-dropdown-item item-warning" @onclick="() => { ClosePurchaseMenu(); OpenPayModal(pur); }">
                                                        <i class="fa-solid fa-hand-holding-dollar" style="color: var(--accent-amber);"></i>
                                                        <span>سداد المتبقي (@pur.RemainingAmount.ToString("N2") ج.م)</span>
                                                    </button>
                                                }
                                                <div class="action-dropdown-divider"></div>
                                                <button class="action-dropdown-item item-danger" @onclick="() => { ClosePurchaseMenu(); ConfirmDeletePurchase(pur); }">
                                                    <i class="fa-solid fa-trash-can" style="color: var(--accent-red);"></i>
                                                    <span>حذف الفاتورة</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Pagination CurrentPage="@purchasesCurrentPage" TotalItems="@filteredPurchases.Count" PageSize="@pageSize" OnPageChanged="@(p => purchasesCurrentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; purchasesCurrentPage = 1; EnsureValidPurchasesPage(); })" />
    }
    else if (activeTab == "suppliers")
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>اسم المورد</th>
                        <th>رقم الهاتف</th>
                        <th>البريد الإلكتروني</th>
                        <th>العنوان</th>
                        <th>المسؤول</th>
                        <th style="width: 120px; text-align: center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                                <p style="margin-top: 0.5rem;">جاري تحميل الموردين...</p>
                            </td>
                        </tr>
                    }
                    else if (!filteredSuppliers.Any())
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-users" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                                لا يوجد موردين مسجلين حالياً.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var sup in PagedSuppliers)
                        {
                            <tr>
                                <td style="font-weight: 600;">@sup.Name</td>
                                <td><i class="fa-solid fa-phone me-1" style="font-size: 0.75rem; color: var(--accent-blue);"></i> @sup.Phone</td>
                                <td>@(string.IsNullOrWhiteSpace(sup.Email) ? "-" : sup.Email)</td>
                                <td>@(string.IsNullOrWhiteSpace(sup.Address) ? "-" : sup.Address)</td>
                                <td>@(string.IsNullOrWhiteSpace(sup.ContactPerson) ? "-" : sup.ContactPerson)</td>
                                <td style="text-align: center;">
                                    <button class="btn btn-sm btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" @onclick="() => OpenEditSupplierModal(sup)" title="تعديل بيانات المورد">
                                        <i class="fa-solid fa-pen-to-square me-1" style="color: var(--accent-amber);"></i> تعديل
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Pagination CurrentPage="@suppliersCurrentPage" TotalItems="@filteredSuppliers.Count" PageSize="@pageSize" OnPageChanged="@(p => suppliersCurrentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; suppliersCurrentPage = 1; EnsureValidSuppliersPage(); })" />
    }
</div>


<!-- Add Supplier Modal -->
@if (showAddSupplierModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-user-plus me-2" style="color: var(--accent-indigo);"></i>
                    إضافة مورد جديد
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div class="form-group">
                    <label>اسم المورد / الشركة <span style="color: var(--accent-red);">*</span></label>
                    <input class="form-control" @bind="newSupplier.Name" placeholder="مثال: شركة الجهينة للأغذية" />
                </div>

                <div class="form-group">
                    <label>رقم الهاتف <span style="color: var(--accent-red);">*</span></label>
                    <input class="form-control" @bind="newSupplier.Phone" placeholder="مثال: 01012345678" />
                </div>

                <div class="form-group">
                    <label>البريد الإلكتروني</label>
                    <input class="form-control" @bind="newSupplier.Email" placeholder="supplier@company.com" />
                </div>

                <div class="form-group">
                    <label>الشخص المسؤول للتواصل</label>
                    <input class="form-control" @bind="newSupplier.ContactPerson" placeholder="اسم مندوب الشركة" />
                </div>

                <div class="form-group">
                    <label>العنوان</label>
                    <input class="form-control" @bind="newSupplier.Address" placeholder="عنوان المقر الرئيسي" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء [Esc]</button>
                <button class="btn btn-primary" @onclick="SaveSupplier" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>حفظ المورد [Enter]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Supplier Modal -->
@if (showEditSupplierModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 520px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-pen-to-square me-2" style="color: var(--accent-amber);"></i>
                    تعديل بيانات المورد (@editSupplier.Name)
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div class="form-group">
                    <label>اسم المورد / الشركة <span style="color: var(--accent-red);">*</span></label>
                    <input class="form-control" @bind="editSupplier.Name" placeholder="مثال: شركة الجهينة للأغذية" />
                </div>

                <div class="form-group">
                    <label>رقم الهاتف <span style="color: var(--accent-red);">*</span></label>
                    <input class="form-control" @bind="editSupplier.Phone" placeholder="مثال: 01012345678" />
                </div>

                <div class="form-group">
                    <label>البريد الإلكتروني</label>
                    <input class="form-control" @bind="editSupplier.Email" placeholder="supplier@company.com" />
                </div>

                <div class="form-group">
                    <label>الشخص المسؤول للتواصل</label>
                    <input class="form-control" @bind="editSupplier.ContactPerson" placeholder="اسم مندوب الشركة" />
                </div>

                <div class="form-group">
                    <label>العنوان</label>
                    <input class="form-control" @bind="editSupplier.Address" placeholder="عنوان المقر الرئيسي" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء [Esc]</button>
                <button class="btn btn-primary" @onclick="SaveEditSupplier" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري التحديث...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>حفظ التعديل [Enter]</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Add Purchase Invoice Modal -->
@if (showAddPurchaseModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 1080px; max-width: 96vw; max-height: 92vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-cart-plus me-2" style="color: var(--accent-indigo);"></i>
                    تسجيل فاتورة شراء بضائع
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                @if (purchaseItems.Any())
                {
                    <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.5rem; padding: 0.55rem 0.85rem; margin-bottom: 0.85rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.82rem; flex-wrap: wrap; gap: 0.5rem;">
                        <span style="color: #34d399; font-weight: 600;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> يتم حفظ مسودة الفاتورة تلقائياً على هذا الجهاز لمنع ضياع الأصناف عند الخروج.
                        </span>
                        <button type="button" class="btn btn-sm btn-secondary" style="padding: 0.15rem 0.5rem; font-size: 0.75rem; color: #f87171; border-color: rgba(239, 68, 68, 0.3);" @onclick="StartNewBlankPurchaseInvoice">
                            <i class="fa-solid fa-trash me-1"></i> إفراغ سلة الأصناف
                        </button>
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600;">المورد <span style="color: var(--accent-red);">*</span></label>
                        <select class="form-select" @bind="selectedSupplierIdString">
                            <option value="">-- اختر المورد --</option>
                            @foreach (var s in suppliers)
                            {
                                <option value="@s.Id.ToString()">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600;">رقم فاتورة الشراء <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="purchaseInvoiceNumber" placeholder="مثال: PUR-10025" />
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600; display: flex; align-items: center; justify-content: space-between;">
                            <span>تاريخ الفاتورة <span style="color: var(--accent-red);">*</span></span>
                            <span style="font-size: 0.72rem; color: var(--text-secondary); font-weight: normal;">(dd/mm/yyyy)</span>
                        </label>
                        <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                            <input type="text"
                                   class="form-control"
                                   style="direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                   placeholder="dd/MM/yyyy"
                                   value="@purchaseInvoiceDateStr"
                                   @onchange="OnPurchaseInvoiceDateStrChanged" />
                            <label class="btn btn-secondary"
                                   style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.75rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                   title="اختر التاريخ من التقويم">
                                <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); pointer-events: none;"></i>
                                <input type="date"
                                       tabindex="-1"
                                       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                       value="@purchaseInvoiceDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnPurchaseInvoicePickerChanged" />
                            </label>
                        </div>
                    </div>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0.5rem 0;">
                    <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--accent-indigo); display: flex; align-items: center; gap: 0.4rem;">
                        <i class="fa-solid fa-boxes-stacked"></i> أصناف الفاتورة
                    </h4>
                    <div style="display: flex; gap: 0.35rem; align-items: center;">
                        <button type="button" 
                                class="btn btn-sm @(purchaseProductTypeFilter == "all" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.76rem; padding: 0.2rem 0.55rem;" 
                                @onclick="@(() => purchaseProductTypeFilter = "all")">
                            <i class="fa-solid fa-list me-1"></i> الكل
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(purchaseProductTypeFilter == "regular" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.76rem; padding: 0.2rem 0.55rem;" 
                                @onclick="@(() => purchaseProductTypeFilter = "regular")">
                            <i class="fa-solid fa-box me-1"></i> منتجات عادية
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(purchaseProductTypeFilter == "weighed" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.76rem; padding: 0.2rem 0.55rem; @(purchaseProductTypeFilter == "weighed" ? "background-color: #10b981; border-color: #059669;" : "")" 
                                @onclick="@(() => purchaseProductTypeFilter = "weighed")">
                            <i class="fa-solid fa-scale-balanced me-1"></i> منتجات بالوزن
                        </button>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
                    <div class="search-box" style="width: 100%;">
                        <i class="fa-solid fa-barcode"></i>
                        <input id="purchase-barcode-input"
                               @bind="scannedPurchaseBarcode" 
                               @bind:event="oninput" 
                               @onkeyup="HandlePurchaseBarcodeKeyUp" 
                               placeholder="مسح أو إدخال الباركود / باركود الميزان... [Enter]" 
                               class="form-control" />
                    </div>
                    <div class="search-box" style="width: 100%;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input @bind="searchProductByName" 
                               @bind:event="oninput" 
                               @onkeyup="HandleProductNameSearchKeyUp" 
                               placeholder="بحث عن الصنف بالاسم... [Enter]" 
                               class="form-control" />
                    </div>
                </div>

                <!-- Product Selection & Multi-Unit / Expiry Row -->
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.75rem; padding: 1rem; margin-bottom: 1rem;">
                    @if (SelectedProduct != null && SelectedProduct.IsWeighable)
                    {
                        <!-- Weighable Product Notification Banner -->
                        <div style="background: rgba(16, 185, 129, 0.08); border: 1.5px solid rgba(16, 185, 129, 0.35); border-radius: 0.5rem; padding: 0.55rem 0.85rem; margin-bottom: 0.85rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                            <div style="color: #10b981; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem;">
                                <i class="fa-solid fa-scale-balanced fa-lg"></i>
                                <span>صنف بالوزن (ميزان باركود / أجبان ومقطعات): @SelectedProduct.NameAr</span>
                            </div>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 600; font-size: 0.76rem; border: 1px solid rgba(16, 185, 129, 0.4);">
                                توريد بالكيلوجرام (كجم)
                            </span>
                        </div>

                        <!-- Row 1: Product Selection & Fixed Weight Unit -->
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">اسم الصنف / المنتج</label>
                                <select class="form-select" value="@selectedProductIdString" @onchange="OnProductSelected">
                                    <option value="">-- @(FilteredPurchaseProducts.Any() ? "اختر الصنف (" + FilteredPurchaseProducts.Count + ")" : "لا توجد نتائج مطابقة") --</option>
                                    @foreach (var p in FilteredPurchaseProducts)
                                    {
                                        <option value="@p.Id.ToString()">
                                            @(p.IsWeighable ? "⚖️ [وزن] " : "📦 [عادي] ") @p.NameAr (@(p.PurchasePrice > 0 ? p.PurchasePrice : p.SellingPrice) ج.م@(p.IsWeighable ? " / كجم" : ""))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">وحدة القياس</label>
                                <input type="text" class="form-control" value="@(SelectedProduct?.BaseUnit ?? "كيلوجرام (كجم)")" disabled style="background: rgba(255,255,255,0.04); font-weight: 600; color: #10b981;" />
                            </div>
                        </div>

                        <!-- Row 2: Weight Quantity, Price per Kg, Production Date -->
                        <div style="display: grid; grid-template-columns: @(SelectedProduct.TrackExpiry ? "1.2fr 1.3fr 1.3fr" : "1.2fr 1.3fr"); gap: 0.75rem; margin-bottom: 0.5rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: #10b981; margin-bottom: 0.25rem; font-weight: 700;">
                                    <i class="fa-solid fa-scale-balanced me-1"></i> الوزن المورّد (كجم)
                                </label>
                                <input type="number" step="0.001" min="0.001" class="form-control" @bind="addItemQty" placeholder="مثال: 12.500" style="font-weight: 700; border-color: rgba(16, 185, 129, 0.4);" />
                                <div style="display: flex; gap: 0.3rem; margin-top: 0.35rem; flex-wrap: wrap;">
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => addItemQty += 1m">+1 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => addItemQty += 5m">+5 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => addItemQty += 10m">+10 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => addItemQty += 25m">+25 كجم (شيكارة/قالب)</button>
                                </div>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">سعر شراء الكيلو (ج.م / كجم)</label>
                                <input type="number" step="0.01" class="form-control" @bind="addItemCost" @bind:after="OnAddItemCostChanged" placeholder="سعر الكيلو" min="0" />
                                <div style="font-size: 0.75rem; color: #10b981; margin-top: 0.35rem; font-weight: 600;">
                                    الإجمالي: @((addItemQty * addItemCost).ToString("N2")) ج.م
                                </div>
                            </div>
                            @if (SelectedProduct.TrackExpiry)
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: space-between;">
                                        <span><i class="fa-solid fa-calendar-day me-1"></i> تاريخ الإنتاج</span>
                                        <span style="font-size: 0.7rem; color: var(--accent-indigo);">(dd/mm/yyyy)</span>
                                    </label>
                                    <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                                        <input type="text"
                                               class="form-control"
                                               style="font-size: 0.85rem; direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                               placeholder="dd/MM/yyyy"
                                               value="@addItemProductionDateStr"
                                               @onchange="OnProductionDateStrChanged" />
                                        <label class="btn btn-secondary"
                                               style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.65rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                               title="اختر التاريخ من التقويم">
                                            <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); font-size: 0.85rem; pointer-events: none;"></i>
                                            <input type="date"
                                                   tabindex="-1"
                                                   style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                                   value="@(addItemProductionDate?.ToString("yyyy-MM-dd"))"
                                                   @onchange="OnProductionDatePickerChanged" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Regular Product Selection & Multi-Unit (Piece / Carton) -->
                        <!-- Row 1: Product Selection & Unit Type -->
                        <div style="display: grid; grid-template-columns: @(selectedUnitType == "carton" ? "2fr 1fr 1fr" : "2fr 1fr"); gap: 0.75rem; margin-bottom: 0.75rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">اسم الصنف / المنتج</label>
                                <select class="form-select" value="@selectedProductIdString" @onchange="OnProductSelected">
                                    <option value="">-- @(FilteredPurchaseProducts.Any() ? "اختر المنتج (" + FilteredPurchaseProducts.Count + ")" : "لا توجد نتائج مطابقة") --</option>
                                    @foreach (var p in FilteredPurchaseProducts)
                                    {
                                        <option value="@p.Id.ToString()">
                                            @(p.IsWeighable ? "⚖️ [وزن] " : "📦 [عادي] ") @p.NameAr (@(p.PurchasePrice > 0 ? p.PurchasePrice : p.SellingPrice) ج.م@(p.IsWeighable ? " / كجم" : ""))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">نوع الوحدة للتوريد</label>
                                <select class="form-select" value="@selectedUnitType" @onchange="OnUnitTypeChanged">
                                    <option value="piece">@(SelectedProduct?.BaseUnit ?? "قطعة") (الوحدة الصغرى)</option>
                                    <option value="carton">@(SelectedProduct?.ParentUnit ?? "كرتونة") (@addItemCartonFactor @(SelectedProduct?.BaseUnit ?? "قطعة"))</option>
                                </select>
                            </div>
                            @if (selectedUnitType == "carton")
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: #60a5fa; margin-bottom: 0.25rem; font-weight: 600;">قطع الكرتونة</label>
                                    <input type="number" class="form-control" style="border-color: #3b82f6; background: rgba(59,130,246,0.07);" @bind="addItemCartonFactor" @bind:after="OnCartonFactorChanged" min="1" title="عدد القطع في الكرتونة الواحدة" />
                                </div>
                            }
                        </div>

                        <!-- Row 2: Quantity, Unit Purchase Cost, Production Date (if TrackExpiry) -->
                        <div style="display: grid; grid-template-columns: @(SelectedProduct != null && SelectedProduct.TrackExpiry ? "1fr 1.3fr 1.3fr" : "1fr 1.3fr"); gap: 0.75rem; margin-bottom: 0.5rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">@(selectedUnitType == "carton" ? "عدد الكراتين" : "الكمية (بالقطعة)")</label>
                                <input type="number" class="form-control" @bind="addItemQty" placeholder="الكمية" min="1" />
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">سعر الشراء / @(selectedUnitType == "carton" ? (SelectedProduct?.ParentUnit ?? "الكرتونة") : (SelectedProduct?.BaseUnit ?? "القطعة"))</label>
                                <input type="number" step="0.01" class="form-control" @bind="addItemCost" @bind:after="OnAddItemCostChanged" placeholder="سعر الشراء" min="0" title="سعر شراء @(selectedUnitType == "carton" ? (SelectedProduct?.ParentUnit ?? "الكرتونة") : (SelectedProduct?.BaseUnit ?? "القطعة"))" />
                            </div>
                            @if (SelectedProduct != null && SelectedProduct.TrackExpiry)
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: space-between;">
                                        <span><i class="fa-solid fa-calendar-day me-1"></i> تاريخ الإنتاج</span>
                                        <span style="font-size: 0.7rem; color: var(--accent-indigo);">(dd/mm/yyyy)</span>
                                    </label>
                                    <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                                        <input type="text"
                                               class="form-control"
                                               style="font-size: 0.85rem; direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                               placeholder="dd/MM/yyyy"
                                               value="@addItemProductionDateStr"
                                               @onchange="OnProductionDateStrChanged" />
                                        <label class="btn btn-secondary"
                                               style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.65rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                               title="اختر التاريخ من التقويم">
                                            <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); font-size: 0.85rem; pointer-events: none;"></i>
                                            <input type="date"
                                                   tabindex="-1"
                                                   style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                                   value="@(addItemProductionDate?.ToString("yyyy-MM-dd"))"
                                                   @onchange="OnProductionDatePickerChanged" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (selectedUnitType == "carton")
                        {
                            var unitFactor = addItemCartonFactor > 0 ? addItemCartonFactor : 1;
                            <div style="margin-top: 0.6rem; padding: 0.55rem 0.85rem; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 0.4rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
                                <div style="color: var(--accent-amber); display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa-solid fa-calculator"></i>
                                    <span>توريد بالكرتونة: <strong>@addItemQty @(SelectedProduct?.ParentUnit ?? "كرتونة")</strong> (@unitFactor قطعة/كرتونة) = <strong style="color: #60a5fa;">@(addItemQty * unitFactor) @(SelectedProduct?.BaseUnit ?? "قطعة") في المخزون</strong></span>
                                </div>
                                <div>
                                    <span style="color: var(--text-secondary);">تكلفة القطعة المحسوبة: </span>
                                    <strong style="color: var(--accent-emerald); font-size: 0.95rem;">@(addItemCost > 0 ? (addItemCost / (decimal)unitFactor).ToString("N2") : "0.00") ج.م</strong>
                                </div>
                            </div>
                        }
                    }

                    @if (SelectedProduct != null && SelectedProduct.TrackExpiry && addItemExpiryDate.HasValue)
                    {
                        var today = DateTime.Today;
                        var expDate = addItemExpiryDate.Value.Date;
                        var daysLeft = (expDate - today).Days;
                        if (expDate <= today)
                        {
                            <div style="margin-top: 0.6rem; font-size: 0.82rem; color: #f87171; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 0.4rem; padding: 0.4rem 0.75rem;">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                <strong>تنبيه الصلاحية:</strong> هذا التاريخ منتهي الصلاحية بالفعل (مضى عليه @Math.Abs(daysLeft) يوم)!
                            </div>
                        }
                        else
                        {
                            <div style="margin-top: 0.6rem; font-size: 0.82rem; color: #34d399; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.4rem; padding: 0.4rem 0.75rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                                <div>
                                    <i class="fa-solid fa-calendar-check me-1"></i>
                                    <span>تاريخ الانتهاء المحسوب: <strong>@expDate.ToString("dd/MM/yyyy")</strong></span>
                                </div>
                                <div>
                                    <span style="color: #a7f3d0;">باقي على الصلاحية: </span>
                                    <strong style="color: #fbbf24;">@daysLeft يوم</strong>
                                    @if (SelectedProduct != null && SelectedProduct.ShelfLifeDays > 0)
                                    {
                                        <span style="color: var(--text-secondary); font-size: 0.75rem;"> (صلاحية المنتج: @SelectedProduct.ShelfLifeDays يوم)</span>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Add Line Item Button Row (تحت البيانات مباشرة) -->
                    <button class="btn btn-primary" type="button" @onclick="AddPurchaseLineItem" style="width: 100%; height: 42px; font-weight: 700; margin-top: 0.75rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.95rem; box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);">
                        <i class="fa-solid fa-plus-circle"></i>
                        <span>إضافة الصنف إلى الفاتورة</span>
                    </button>
                </div>

                <!-- Invoice Items Summary Chips & Table Filter -->
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.65rem;">
                    <!-- Metrics Summary Separating Regular and Weighed Items -->
                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; font-size: 0.82rem;">
                        <span style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 0.4rem; padding: 0.3rem 0.65rem; color: var(--accent-indigo); font-weight: 600;">
                            <i class="fa-solid fa-box me-1"></i> أصناف عادية: <strong>@RegularPurchaseItemsCount</strong> صنف (@RegularPurchaseItemsTotal.ToString("N2") ج.م)
                        </span>
                        <span style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.4rem; padding: 0.3rem 0.65rem; color: #10b981; font-weight: 600;">
                            <i class="fa-solid fa-scale-balanced me-1"></i> أصناف بالوزن: <strong>@WeighedPurchaseItemsCount</strong> صنف — <strong>@TotalWeighedKg.ToString("0.000") كجم</strong> (@WeighedPurchaseItemsTotal.ToString("N2") ج.م)
                        </span>
                    </div>

                    <!-- Table View Filter Tabs -->
                    <div style="display: flex; gap: 0.25rem; align-items: center;">
                        <span style="font-size: 0.75rem; color: var(--text-secondary); margin-left: 0.2rem;">عرض:</span>
                        <button type="button" 
                                class="btn btn-sm @(purchaseTableFilter == "all" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem;" 
                                @onclick="@(() => purchaseTableFilter = "all")">
                            الكل (@purchaseItems.Count)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(purchaseTableFilter == "regular" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem;" 
                                @onclick="@(() => purchaseTableFilter = "regular")">
                            <i class="fa-solid fa-box me-1"></i> عادية (@RegularPurchaseItemsCount)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(purchaseTableFilter == "weighed" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem; @(purchaseTableFilter == "weighed" ? "background-color: #10b981; border-color: #059669;" : "")" 
                                @onclick="@(() => purchaseTableFilter = "weighed")">
                            <i class="fa-solid fa-scale-balanced me-1"></i> بالوزن (@WeighedPurchaseItemsCount)
                        </button>
                    </div>
                </div>

                <div class="table-container" style="min-height: 250px; max-height: 380px; overflow-y: auto; margin-bottom: 0.75rem; border: 1px solid var(--border-color); border-radius: 8px;">
                    <table class="data-table">
                        <thead style="position: sticky; top: 0; background: var(--bg-card); z-index: 2; box-shadow: 0 1px 0 var(--border-color);">
                            <tr>
                                <th style="min-width: 200px;">المنتج</th>
                                <th style="min-width: 140px;">الكمية / الوزن</th>
                                <th style="min-width: 110px;">تاريخ الصلاحية</th>
                                <th style="min-width: 100px;">رقم التشغيلة</th>
                                <th style="min-width: 130px;">سعر التكلفة</th>
                                <th style="min-width: 110px;">الإجمالي</th>
                                <th style="min-width: 140px; text-align: center;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!purchaseItems.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                                        لم يتم إضافة أصناف حتى الآن.
                                    </td>
                                </tr>
                            }
                            else if (!DisplayedPurchaseItems.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                                        لا توجد أصناف مطابقة لفلتر العرض الحالي.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in DisplayedPurchaseItems)
                                {
                                    var prod = availableProducts.FirstOrDefault(p => p.Id == item.ProductId);
                                    var isWeighed = prod?.IsWeighable == true || (item.Unit != null && (item.Unit.Contains("كجم") || item.Unit.Contains("كيلو")));
                                    var factor = (prod != null && prod.ConversionFactor > 1) ? prod.ConversionFactor : 1;
                                    bool isCarton = !isWeighed && !string.IsNullOrWhiteSpace(item.Unit) &&
                                                    (string.Equals(item.Unit.Trim(), "كرتونة", StringComparison.OrdinalIgnoreCase) ||
                                                     (!string.IsNullOrWhiteSpace(prod?.ParentUnit) && string.Equals(item.Unit.Trim(), prod.ParentUnit.Trim(), StringComparison.OrdinalIgnoreCase)));
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 0.4rem;">
                                                @if (isWeighed)
                                                {
                                                    <span class="badge" style="background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-scale-balanced me-1"></i> بالوزن
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-box me-1"></i> عادي
                                                    </span>
                                                }
                                                <span style="font-weight: 600;">@(prod?.NameAr ?? "منتج")</span>
                                            </div>
                                        </td>
                                        <td>
                                            @if (isWeighed)
                                            {
                                                <div>
                                                    <strong style="color: #10b981; font-size: 0.95rem;">@item.Quantity.ToString("0.000") @(prod?.BaseUnit ?? "كجم")</strong>
                                                    <span style="font-size: 0.72rem; color: var(--text-secondary); display: block;">(وزن صافي)</span>
                                                </div>
                                            }
                                            else if (isCarton && factor > 1)
                                            {
                                                <div>
                                                    <strong style="color: var(--accent-blue);">@item.Quantity.ToString("G29") @(prod?.ParentUnit ?? "كرتونة")</strong>
                                                    <span style="font-size: 0.75rem; color: var(--text-secondary); display: block;">(@((item.Quantity * factor).ToString("N0")) @(prod?.BaseUnit ?? "قطعة"))</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    <strong>@item.Quantity.ToString("G29") @(prod?.BaseUnit ?? "قطعة")</strong>
                                                </div>
                                            }
                                        </td>
                                        <td style="color: @(item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.Today ? "var(--accent-red)" : "inherit"); font-weight: 600;">
                                            @(item.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(item.BatchNumber) ? "-" : item.BatchNumber)</td>
                                        <td>
                                            @if (isWeighed)
                                            {
                                                <div>
                                                    <strong style="color: #10b981;">@item.UnitCost.ToString("N2") ج.م</strong> / كجم
                                                </div>
                                            }
                                            else if (isCarton && factor > 1)
                                            {
                                                <div>
                                                    <strong style="color: var(--accent-amber);">@item.UnitCost.ToString("N2") ج.م</strong> / @(prod?.ParentUnit ?? "كرتونة")
                                                </div>
                                                <div style="font-size: 0.74rem; color: var(--accent-emerald);">
                                                    (@((item.UnitCost / factor).ToString("N2")) ج.م لـ @(prod?.BaseUnit ?? "القطعة"))
                                                </div>
                                            }
                                            else
                                            {
                                                <div>@item.UnitCost.ToString("N2") ج.م / @(prod?.BaseUnit ?? "قطعة")</div>
                                            }
                                        </td>
                                        <td style="color: var(--accent-emerald); font-weight: 700; font-size: 0.95rem;">@((item.Quantity * item.UnitCost).ToString("N2")) ج.م</td>
                                        <td style="white-space: nowrap; text-align: center;">
                                            @if (prod != null)
                                            {
                                                var pieceCost = isCarton && factor > 1 ? (item.UnitCost / factor) : item.UnitCost;
                                                <button type="button" class="btn btn-sm btn-secondary me-1" style="padding: 0.2rem 0.45rem; font-size: 0.72rem; color: var(--accent-emerald); border-color: rgba(16, 185, 129, 0.3);" title="تطبيق أسعار البيع مباشرة على هذا المنتج في الكتالوج" @onclick="() => OpenApplyPricesModal(prod, pieceCost)">
                                                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i> تطبيق الأسعار
                                                </button>
                                            }
                                            <button class="btn btn-danger" style="padding: 0.2rem 0.4rem; font-size: 0.75rem;" @onclick="() => RemovePurchaseItem(item)">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="grid-2" style="margin-top: 0.75rem; align-items: stretch;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <label style="margin-bottom: 0; font-weight: 700;">المبلغ المدفوع (جنيه)</label>
                            <div style="display: flex; gap: 0.35rem;">
                                <button type="button" class="btn btn-sm @(isFullPayment || (purchasePaidAmount == purchaseInvoiceTotal && purchaseInvoiceTotal > 0) ? "btn-primary" : "btn-secondary")" style="font-size: 0.72rem; padding: 0.15rem 0.45rem;" @onclick="SetFullPurchasePayment">
                                    <i class="fa-solid fa-check-double me-1"></i> سداد كامل نقدًا
                                </button>
                                <button type="button" class="btn btn-sm @(purchasePaidAmount == 0 ? "btn-primary" : "btn-secondary")" style="font-size: 0.72rem; padding: 0.15rem 0.45rem;" @onclick="SetZeroPurchasePayment">
                                    آجل (0)
                                </button>
                            </div>
                        </div>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="purchasePaidAmount" @bind:event="oninput" placeholder="0.00" style="font-size: 1.05rem; font-weight: 700; color: var(--accent-emerald);" />
                    </div>

                    <div style="background: var(--bg-card); padding: 0.75rem 1rem; border-radius: 0.5rem; border: 1px solid var(--border-color-light); display: flex; flex-direction: column; justify-content: center; gap: 0.25rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.85rem; color: var(--text-secondary);">إجمالي الفاتورة:</span>
                            <strong style="font-size: 1.15rem; color: var(--accent-amber);">@purchaseInvoiceTotal.ToString("N2") ج.م</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; border-top: 1px dashed var(--border-color-light); padding-top: 0.25rem;">
                            <span style="color: var(--text-secondary);">المتبقي (مديونية):</span>
                            <strong style="color: @(purchaseRemainingDebt > 0 ? "var(--accent-red)" : "var(--accent-emerald)"); font-size: 1rem;">
                                @purchaseRemainingDebt.ToString("N2") ج.م
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                    @if (purchaseItems.Any())
                    {
                        <button type="button" class="btn btn-secondary" style="color: #f87171; border-color: rgba(239, 68, 68, 0.35); font-size: 0.85rem;" @onclick="StartNewBlankPurchaseInvoice" disabled="@isSaving">
                            <i class="fa-solid fa-trash me-1"></i> إفراغ سلة الأصناف
                        </button>
                    }
                </div>
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">
                        <i class="fa-solid fa-xmark me-1"></i> إغلاق
                    </button>
                    @if (purchaseItems.Any())
                    {
                        <button class="btn btn-secondary" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.4); color: #34d399; font-weight: 600;" @onclick="() => { SyncDraftState(); CloseModals(); }" disabled="@isSaving" title="حفظ الأصناف الحالية كمسودة وإغلاق النافذة">
                            <i class="fa-solid fa-floppy-disk me-1"></i> حفظ كمسودة
                        </button>
                    }
                    <button class="btn btn-primary" @onclick="SavePurchase" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check me-1"></i> <span>حفظ وتسجيل الفاتورة في المخزون</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Pay Remaining Modal -->
@if (showPayModal && selectedPurchaseForPayment != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-hand-holding-dollar me-2" style="color: var(--accent-emerald);"></i>
                    سداد المتبقي لفاتورة الشراء
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1.25rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.9rem;">
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">رقم الفاتورة:</span>
                        <strong>@selectedPurchaseForPayment.InvoiceNumber</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">المورد:</span>
                        <strong>@selectedPurchaseForPayment.SupplierName</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">المبلغ الإجمالي:</span>
                        <span style="color: var(--accent-amber); font-weight: 700;">@selectedPurchaseForPayment.TotalAmount.ToString("N2") ج.م</span>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">المبلغ المدفوع سابقاً:</span>
                        <span style="color: var(--accent-emerald); font-weight: 700;">@selectedPurchaseForPayment.PaidAmount.ToString("N2") ج.م</span>
                    </div>
                </div>

                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600; color: #f87171;">المبلغ المتبقي حالياً:</span>
                    <strong style="font-size: 1.2rem; color: #f87171;">@selectedPurchaseForPayment.RemainingAmount.ToString("N2") ج.م</strong>
                </div>

                <div class="form-group">
                    <label>المبلغ المراد سداده <span style="color: var(--accent-red);">*</span></label>
                    <input type="number" step="0.01" class="form-control" @bind="payAmount" placeholder="0.00" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-primary" @onclick="SavePayment" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري السداد...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>تأكيد السداد</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Purchase Details Modal -->
@if (showDetailsModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 1200px; max-width: 96vw; height: 90vh; max-height: 880px; display: flex; flex-direction: column; overflow: hidden;" @onclick:stopPropagation="true">
            <div class="modal-header" style="flex-shrink: 0;">
                <h3 class="modal-title">
                    <i class="fa-solid fa-file-invoice me-2" style="color: var(--accent-blue);"></i>
                    تفاصيل ومحتويات فاتورة الشراء (@(selectedPurchaseDetail?.InvoiceNumber ?? "..."))
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; padding: 1.25rem 1.5rem; gap: 0.75rem;">
                @if (isLoadingDetails)
                {
                    <div style="text-align: center; padding: 3rem; color: var(--text-secondary); margin: auto;">
                        <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                        <p style="margin-top: 0.5rem;">جاري تحميل تفاصيل الفاتورة...</p>
                    </div>
                }
                else if (selectedPurchaseDetail != null)
                {
                    <div style="flex-shrink: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; background: rgba(255,255,255,0.03); padding: 0.65rem 1rem; border-radius: 0.5rem; border: 1px solid var(--border-color); font-size: 0.86rem;">
                        <div><span style="color: var(--text-secondary);">رقم الفاتورة:</span> <strong style="color: var(--accent-blue);">@selectedPurchaseDetail.InvoiceNumber</strong></div>
                        <div><span style="color: var(--text-secondary);">المورد:</span> <strong>@selectedPurchaseDetail.SupplierName</strong></div>
                        <div><span style="color: var(--text-secondary);">التاريخ:</span> <strong>@selectedPurchaseDetail.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div><span style="color: var(--text-secondary);">الحالة:</span> <span class="badge @(selectedPurchaseDetail.Status == "Received" ? "badge-green" : "badge-amber")">@(selectedPurchaseDetail.Status == "Received" ? "تم الاستلام" : selectedPurchaseDetail.Status)</span></div>
                        <div style="border-right: 1px solid var(--border-color); padding-right: 0.75rem;"><span style="color: var(--text-secondary);">الإجمالي:</span> <strong style="color: var(--accent-amber); font-size: 0.95rem;">@selectedPurchaseDetail.TotalAmount.ToString("N2") ج.م</strong></div>
                        <div><span style="color: var(--text-secondary);">المدفوع:</span> <strong style="color: var(--accent-emerald); font-size: 0.95rem;">@selectedPurchaseDetail.PaidAmount.ToString("N2") ج.م</strong></div>
                        <div><span style="color: var(--text-secondary);">المتبقي:</span> <strong style="color: var(--accent-red); font-size: 0.95rem;">@selectedPurchaseDetail.RemainingAmount.ToString("N2") ج.م</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(selectedPurchaseDetail.Notes))
                    {
                        <div style="flex-shrink: 0; font-size: 0.82rem; color: var(--text-secondary); background: rgba(255,255,255,0.02); padding: 0.35rem 0.75rem; border-radius: 0.35rem; border: 1px solid var(--border-color-light);">
                            <strong>ملاحظات:</strong> @selectedPurchaseDetail.Notes
                        </div>
                    }

                    <div style="flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;">
                        <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-primary);">
                            <i class="fa-solid fa-boxes-stacked me-1" style="color: var(--accent-blue);"></i> الأصناف في الفاتورة (@selectedPurchaseDetail.Items.Count صنف)
                        </h4>
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">عرض مريح لجميع سطور الفاتورة (5 أصناف وأكثر ظاهرة معاً)</span>
                    </div>

                    <div class="table-container" style="flex: 1; min-height: 340px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
                        <table class="data-table" style="width: 100%; font-size: 0.88rem;">
                            <thead style="position: sticky; top: 0; background: var(--bg-card); z-index: 2; box-shadow: 0 1px 0 var(--border-color);">
                                <tr>
                                    <th style="width: 45px; text-align: center; padding: 0.55rem 0.75rem;">#</th>
                                    <th style="min-width: 200px; padding: 0.55rem 0.75rem;">اسم الصنف</th>
                                    <th style="min-width: 120px; padding: 0.55rem 0.75rem;">الباركود</th>
                                    <th style="min-width: 100px; text-align: center; padding: 0.55rem 0.75rem;">الكمية</th>
                                    <th style="min-width: 120px; padding: 0.55rem 0.75rem;">تاريخ الصلاحية</th>
                                    <th style="min-width: 110px; padding: 0.55rem 0.75rem;">رقم التشغيلة</th>
                                    <th style="min-width: 110px; text-align: left; padding: 0.55rem 0.75rem;">سعر التكلفة</th>
                                    <th style="min-width: 110px; text-align: left; padding: 0.55rem 0.75rem;">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int idx = 1; }
                                @foreach (var item in selectedPurchaseDetail.Items)
                                {
                                    var pInfo = availableProducts.FirstOrDefault(p => p.Id == item.ProductId);
                                    var isWeighed = pInfo?.IsWeighable == true || (item.BaseUnit != null && (item.BaseUnit.Contains("كجم") || item.BaseUnit.Contains("كيلو")));
                                    <tr>
                                        <td style="text-align: center; color: var(--text-muted); font-size: 0.85rem; padding: 0.5rem 0.75rem;">@idx</td>
                                        <td style="font-weight: 600; padding: 0.5rem 0.75rem;">
                                            <div style="display: flex; align-items: center; gap: 0.4rem;">
                                                @if (isWeighed)
                                                {
                                                    <span class="badge" style="background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-scale-balanced me-1"></i> بالوزن
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-box me-1"></i> عادي
                                                    </span>
                                                }
                                                <span>@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td style="padding: 0.5rem 0.75rem;"><code>@(string.IsNullOrWhiteSpace(item.Barcode) ? "-" : item.Barcode)</code></td>
                                        <td style="text-align: center; font-weight: 700; color: var(--accent-blue); padding: 0.5rem 0.75rem;">
                                            @if (isWeighed)
                                            {
                                                <div>
                                                    <strong style="color: #10b981; font-size: 0.95rem;">@item.Quantity.ToString("0.000") @(pInfo?.BaseUnit ?? "كجم")</strong>
                                                    <span style="font-size: 0.72rem; color: var(--text-secondary); display: block;">(وزن صافي)</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span>@item.Quantity.ToString("G29") @(pInfo?.BaseUnit ?? "قطعة")</span>
                                                @if (pInfo != null && pInfo.ConversionFactor > 1 && item.Quantity >= pInfo.ConversionFactor)
                                                {
                                                    <div style="font-size: 0.72rem; color: var(--text-secondary); font-weight: normal;">
                                                        (@PackagingUnitHelper.FormatTwoTierStockBreakdown(item.Quantity, pInfo.ConversionFactor, pInfo.BaseUnit, pInfo.ParentUnit))
                                                    </div>
                                                }
                                            }
                                        </td>
                                        <td style="color: @(item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.Today ? "var(--accent-red)" : "inherit"); font-weight: 600; padding: 0.5rem 0.75rem;">
                                            @(item.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td style="padding: 0.5rem 0.75rem;">@(string.IsNullOrWhiteSpace(item.BatchNumber) ? "-" : item.BatchNumber)</td>
                                        <td style="text-align: left; padding: 0.5rem 0.75rem;">
                                            @item.UnitCost.ToString("N2") ج.م@(isWeighed ? " / كجم" : "")
                                        </td>
                                        <td style="text-align: left; font-weight: 700; color: var(--accent-amber); padding: 0.5rem 0.75rem;">@item.Total.ToString("N2") ج.م</td>
                                    </tr>
                                    idx++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer" style="flex-shrink: 0;">
                <button class="btn btn-secondary" @onclick="CloseModals">إغلاق</button>
            </div>
        </div>
    </div>
}

<!-- Edit Purchase Modal -->
@if (showEditPurchaseModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 1080px; max-width: 96vw; max-height: 92vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title">
                    <i class="fa-solid fa-pen-to-square me-2" style="color: var(--accent-amber);"></i>
                    تعديل فاتورة الشراء (@editPurchaseInvoiceNumber)
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div style="display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600;">رقم الفاتورة <span style="color: var(--accent-red);">*</span></label>
                        <input class="form-control" @bind="editPurchaseInvoiceNumber" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600;">المورد <span style="color: var(--accent-red);">*</span></label>
                        <select class="form-select" @bind="editSupplierIdString">
                            @foreach (var sup in suppliers)
                            {
                                <option value="@sup.Id">@sup.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-weight: 600; display: flex; align-items: center; justify-content: space-between;">
                            <span>تاريخ الفاتورة <span style="color: var(--accent-red);">*</span></span>
                            <span style="font-size: 0.72rem; color: var(--text-secondary); font-weight: normal;">(dd/mm/yyyy)</span>
                        </label>
                        <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                            <input type="text"
                                   class="form-control"
                                   style="direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                   placeholder="dd/MM/yyyy"
                                   value="@editPurchaseDateStr"
                                   @onchange="OnEditPurchaseDateStrChanged" />
                            <label class="btn btn-secondary"
                                   style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.75rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                   title="اختر التاريخ من التقويم">
                                <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); pointer-events: none;"></i>
                                <input type="date"
                                       tabindex="-1"
                                       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                       value="@editPurchaseDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnEditPurchasePickerChanged" />
                            </label>
                        </div>
                    </div>
                </div>

                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.6rem; padding: 0.9rem; margin-bottom: 1rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.6rem;">
                        <h4 style="font-size: 0.9rem; font-weight: 700; margin: 0; color: var(--accent-indigo);">
                            <i class="fa-solid fa-plus-circle me-1"></i> إضافة / مسح صنف في الفاتورة
                        </h4>
                        <div style="display: flex; gap: 0.35rem; align-items: center;">
                            <button type="button" 
                                    class="btn btn-sm @(editProductTypeFilter == "all" ? "btn-primary" : "btn-secondary")" 
                                    style="font-size: 0.74rem; padding: 0.18rem 0.5rem;" 
                                    @onclick="@(() => editProductTypeFilter = "all")">
                                <i class="fa-solid fa-list me-1"></i> الكل
                            </button>
                            <button type="button" 
                                    class="btn btn-sm @(editProductTypeFilter == "regular" ? "btn-primary" : "btn-secondary")" 
                                    style="font-size: 0.74rem; padding: 0.18rem 0.5rem;" 
                                    @onclick="@(() => editProductTypeFilter = "regular")">
                                <i class="fa-solid fa-box me-1"></i> منتجات عادية
                            </button>
                            <button type="button" 
                                    class="btn btn-sm @(editProductTypeFilter == "weighed" ? "btn-primary" : "btn-secondary")" 
                                    style="font-size: 0.74rem; padding: 0.18rem 0.5rem; @(editProductTypeFilter == "weighed" ? "background-color: #10b981; border-color: #059669;" : "")" 
                                    @onclick="@(() => editProductTypeFilter = "weighed")">
                                <i class="fa-solid fa-scale-balanced me-1"></i> منتجات بالوزن
                            </button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
                        <div class="search-box" style="width: 100%;">
                            <i class="fa-solid fa-barcode"></i>
                            <input class="form-control" @bind="editScannedBarcode" @bind:event="oninput" @onkeyup="HandleEditBarcodeKeyUp" placeholder="مسح أو إدخال الباركود / باركود الميزان..." />
                        </div>
                        <div class="search-box" style="width: 100%;">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input class="form-control" @bind="editSearchProductByName" @bind:event="oninput" @onkeyup="HandleEditProductNameSearchKeyUp" placeholder="بحث عن الصنف بالاسم..." />
                        </div>
                    </div>

                    @if (EditSelectedProduct != null && EditSelectedProduct.IsWeighable)
                    {
                        <!-- Weighable Product Notification Banner in Edit -->
                        <div style="background: rgba(16, 185, 129, 0.08); border: 1.5px solid rgba(16, 185, 129, 0.35); border-radius: 0.5rem; padding: 0.55rem 0.85rem; margin-bottom: 0.85rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                            <div style="color: #10b981; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem;">
                                <i class="fa-solid fa-scale-balanced fa-lg"></i>
                                <span>صنف بالوزن (ميزان باركود / أجبان ومقطعات): @EditSelectedProduct.NameAr</span>
                            </div>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 600; font-size: 0.76rem; border: 1px solid rgba(16, 185, 129, 0.4);">
                                توريد بالكيلوجرام (كجم)
                            </span>
                        </div>

                        <!-- Row 1: Product Selection & Fixed Weight Unit -->
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">اسم الصنف / المنتج</label>
                                <select class="form-select" value="@editSelectedProductIdString" @onchange="OnEditProductSelected">
                                    <option value="">-- @(FilteredEditPurchaseProducts.Any() ? "اختر صنف (" + FilteredEditPurchaseProducts.Count + ")" : "لا توجد نتائج") --</option>
                                    @foreach (var prod in FilteredEditPurchaseProducts)
                                    {
                                        <option value="@prod.Id">
                                            @(prod.IsWeighable ? "⚖️ [وزن] " : "📦 [عادي] ") @prod.NameAr (@(prod.PurchasePrice > 0 ? prod.PurchasePrice : prod.SellingPrice) ج.م@(prod.IsWeighable ? " / كجم" : ""))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">وحدة القياس</label>
                                <input type="text" class="form-control" value="@(EditSelectedProduct?.BaseUnit ?? "كيلوجرام (كجم)")" disabled style="background: rgba(255,255,255,0.04); font-weight: 600; color: #10b981;" />
                            </div>
                        </div>

                        <!-- Row 2: Weight Quantity, Price per Kg, Production Date -->
                        <div style="display: grid; grid-template-columns: @(EditSelectedProduct.TrackExpiry ? "1.2fr 1.3fr 1.3fr" : "1.2fr 1.3fr"); gap: 0.75rem; margin-bottom: 0.5rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: #10b981; margin-bottom: 0.25rem; font-weight: 700;">
                                    <i class="fa-solid fa-scale-balanced me-1"></i> الوزن المورّد (كجم)
                                </label>
                                <input type="number" step="0.001" min="0.001" class="form-control" @bind="editAddItemQty" placeholder="مثال: 12.500" style="font-weight: 700; border-color: rgba(16, 185, 129, 0.4);" />
                                <div style="display: flex; gap: 0.3rem; margin-top: 0.35rem; flex-wrap: wrap;">
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => editAddItemQty += 1m">+1 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => editAddItemQty += 5m">+5 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => editAddItemQty += 10m">+10 كجم</button>
                                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.4rem;" @onclick="() => editAddItemQty += 25m">+25 كجم (شيكارة/قالب)</button>
                                </div>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">سعر شراء الكيلو (ج.م / كجم)</label>
                                <input type="number" step="0.01" class="form-control" @bind="editAddItemCost" @bind:after="OnEditAddItemCostChanged" placeholder="سعر الكيلو" min="0" />
                                <div style="font-size: 0.75rem; color: #10b981; margin-top: 0.35rem; font-weight: 600;">
                                    الإجمالي: @((editAddItemQty * editAddItemCost).ToString("N2")) ج.م
                                </div>
                            </div>
                            @if (EditSelectedProduct.TrackExpiry)
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: space-between;">
                                        <span><i class="fa-solid fa-calendar-day me-1"></i> تاريخ الإنتاج</span>
                                        <span style="font-size: 0.7rem; color: var(--accent-indigo);">(dd/mm/yyyy)</span>
                                    </label>
                                    <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                                        <input type="text"
                                               class="form-control"
                                               style="font-size: 0.85rem; direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                               placeholder="dd/MM/yyyy"
                                               value="@editAddItemProductionDateStr"
                                               @onchange="OnEditProductionDateStrChanged" />
                                        <label class="btn btn-secondary"
                                               style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.65rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                               title="اختر التاريخ من التقويم">
                                            <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); font-size: 0.85rem; pointer-events: none;"></i>
                                            <input type="date"
                                                   tabindex="-1"
                                                   style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                                   value="@(editAddItemProductionDate?.ToString("yyyy-MM-dd"))"
                                                   @onchange="OnEditProductionDatePickerChanged" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Regular Product Selection & Multi-Unit in Edit -->
                        <!-- Row 1: Product Selection & Unit Type -->
                        <div style="display: grid; grid-template-columns: @(editSelectedUnitType == "carton" ? "2fr 1fr 1fr" : "2fr 1fr"); gap: 0.75rem; margin-bottom: 0.75rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">اسم الصنف / المنتج</label>
                                <select class="form-select" value="@editSelectedProductIdString" @onchange="OnEditProductSelected">
                                    <option value="">-- @(FilteredEditPurchaseProducts.Any() ? "اختر صنف (" + FilteredEditPurchaseProducts.Count + ")" : "لا توجد نتائج") --</option>
                                    @foreach (var prod in FilteredEditPurchaseProducts)
                                    {
                                        <option value="@prod.Id">
                                            @(prod.IsWeighable ? "⚖️ [وزن] " : "📦 [عادي] ") @prod.NameAr (@(prod.PurchasePrice > 0 ? prod.PurchasePrice : prod.SellingPrice) ج.م@(prod.IsWeighable ? " / كجم" : ""))
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">نوع الوحدة للتوريد</label>
                                <select class="form-select" value="@editSelectedUnitType" @onchange="OnEditUnitTypeChanged">
                                    <option value="piece">@(EditSelectedProduct?.BaseUnit ?? "قطعة") (الوحدة الصغرى)</option>
                                    <option value="carton">@(EditSelectedProduct?.ParentUnit ?? "كرتونة") (@editAddItemCartonFactor @(EditSelectedProduct?.BaseUnit ?? "قطعة"))</option>
                                </select>
                            </div>
                            @if (editSelectedUnitType == "carton")
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: #60a5fa; margin-bottom: 0.25rem; font-weight: 600;">قطع الكرتونة</label>
                                    <input type="number" class="form-control" style="border-color: #3b82f6; background: rgba(59,130,246,0.07);" @bind="editAddItemCartonFactor" @bind:after="OnEditCartonFactorChanged" min="1" title="عدد القطع في الكرتونة الواحدة" />
                                </div>
                            }
                        </div>

                        <!-- Row 2: Quantity, Unit Purchase Cost, Production Date (if TrackExpiry) -->
                        <div style="display: grid; grid-template-columns: @(EditSelectedProduct != null && EditSelectedProduct.TrackExpiry ? "1fr 1.3fr 1.3fr" : "1fr 1.3fr"); gap: 0.75rem; margin-bottom: 0.5rem; align-items: flex-end;">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">@(editSelectedUnitType == "carton" ? "عدد الكراتين" : "الكمية (بالقطعة)")</label>
                                <input type="number" step="1" class="form-control" @bind="editAddItemQty" placeholder="الكمية" min="1" />
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem;">سعر الشراء / @(editSelectedUnitType == "carton" ? (EditSelectedProduct?.ParentUnit ?? "الكرتونة") : (EditSelectedProduct?.BaseUnit ?? "القطعة"))</label>
                                <input type="number" step="0.01" class="form-control" @bind="editAddItemCost" @bind:after="OnEditAddItemCostChanged" placeholder="سعر الشراء" min="0" title="سعر شراء @(editSelectedUnitType == "carton" ? (EditSelectedProduct?.ParentUnit ?? "الكرتونة") : (EditSelectedProduct?.BaseUnit ?? "القطعة"))" />
                            </div>
                            @if (EditSelectedProduct != null && EditSelectedProduct.TrackExpiry)
                            {
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label style="font-size: 0.8rem; color: var(--text-secondary); margin-bottom: 0.25rem; display: flex; align-items: center; justify-content: space-between;">
                                        <span><i class="fa-solid fa-calendar-day me-1"></i> تاريخ الإنتاج</span>
                                        <span style="font-size: 0.7rem; color: var(--accent-indigo);">(dd/mm/yyyy)</span>
                                    </label>
                                    <div style="display: flex; align-items: stretch; direction: ltr; position: relative;">
                                        <input type="text"
                                               class="form-control"
                                               style="font-size: 0.85rem; direction: ltr; text-align: center; font-weight: 600; border-top-right-radius: 0; border-bottom-right-radius: 0;"
                                               placeholder="dd/MM/yyyy"
                                               value="@editAddItemProductionDateStr"
                                               @onchange="OnEditProductionDateStrChanged" />
                                        <label class="btn btn-secondary"
                                               style="border-top-left-radius: 0; border-bottom-left-radius: 0; margin: 0; padding: 0 0.65rem; display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; overflow: hidden; background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); border-left: none;"
                                               title="اختر التاريخ من التقويم">
                                            <i class="fa-solid fa-calendar-days" style="color: var(--accent-indigo); font-size: 0.85rem; pointer-events: none;"></i>
                                            <input type="date"
                                                   tabindex="-1"
                                                   style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;"
                                                   value="@(editAddItemProductionDate?.ToString("yyyy-MM-dd"))"
                                                   @onchange="OnEditProductionDatePickerChanged" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (editSelectedUnitType == "carton")
                        {
                            var editUnitFactor = editAddItemCartonFactor > 0 ? editAddItemCartonFactor : 1;
                            <div style="margin-top: 0.6rem; padding: 0.55rem 0.85rem; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 0.4rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem; flex-wrap: gap; gap: 0.5rem;">
                                <div style="color: var(--accent-amber); display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa-solid fa-calculator"></i>
                                    <span>توريد بالكرتونة: <strong>@editAddItemQty @(EditSelectedProduct?.ParentUnit ?? "كرتونة")</strong> (@editUnitFactor قطعة/كرتونة) = <strong style="color: #60a5fa;">@(editAddItemQty * editUnitFactor) @(EditSelectedProduct?.BaseUnit ?? "قطعة") في المخزون</strong></span>
                                </div>
                                <div>
                                    <span style="color: var(--text-secondary);">تكلفة القطعة المحسوبة: </span>
                                    <strong style="color: var(--accent-emerald); font-size: 0.95rem;">@(editAddItemCost > 0 ? (editAddItemCost / (decimal)editUnitFactor).ToString("N2") : "0.00") ج.م</strong>
                                </div>
                            </div>
                        }
                    }

                    @if (EditSelectedProduct != null && EditSelectedProduct.TrackExpiry && editAddItemExpiryDate.HasValue)
                    {
                        var today = DateTime.Today;
                        var expDate = editAddItemExpiryDate.Value.Date;
                        var daysLeft = (expDate - today).Days;
                        if (expDate <= today)
                        {
                            <div style="margin-top: 0.6rem; font-size: 0.82rem; color: #f87171; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 0.4rem; padding: 0.4rem 0.75rem;">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                <strong>تنبيه الصلاحية:</strong> هذا التاريخ منتهي الصلاحية بالفعل (مضى عليه @Math.Abs(daysLeft) يوم)!
                            </div>
                        }
                        else
                        {
                            <div style="margin-top: 0.6rem; font-size: 0.82rem; color: #34d399; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.4rem; padding: 0.4rem 0.75rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
                                <div>
                                    <i class="fa-solid fa-calendar-check me-1"></i>
                                    <span>تاريخ الانتهاء المحسوب: <strong>@expDate.ToString("dd/MM/yyyy")</strong></span>
                                </div>
                                <div>
                                    <span style="color: #a7f3d0;">باقي على الصلاحية: </span>
                                    <strong style="color: #fbbf24;">@daysLeft يوم</strong>
                                    @if (EditSelectedProduct != null && EditSelectedProduct.ShelfLifeDays > 0)
                                    {
                                        <span style="color: var(--text-secondary); font-size: 0.75rem;"> (صلاحية المنتج: @EditSelectedProduct.ShelfLifeDays يوم)</span>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Add Line Item Button Row (تحت البيانات مباشرة) -->
                    <button class="btn btn-primary" type="button" @onclick="AddEditPurchaseLineItem" style="width: 100%; height: 42px; font-weight: 700; margin-top: 0.75rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; font-size: 0.95rem; box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);">
                        <i class="fa-solid fa-plus-circle"></i>
                        <span>إضافة الصنف إلى الفاتورة</span>
                    </button>
                </div>

                <!-- Invoice Items Summary Chips & Table Filter in Edit -->
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0.65rem;">
                    <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; font-size: 0.82rem;">
                        <span style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 0.4rem; padding: 0.3rem 0.65rem; color: var(--accent-indigo); font-weight: 600;">
                            <i class="fa-solid fa-box me-1"></i> أصناف عادية: <strong>@EditRegularPurchaseItemsCount</strong> صنف (@EditRegularPurchaseItemsTotal.ToString("N2") ج.م)
                        </span>
                        <span style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 0.4rem; padding: 0.3rem 0.65rem; color: #10b981; font-weight: 600;">
                            <i class="fa-solid fa-scale-balanced me-1"></i> أصناف بالوزن: <strong>@EditWeighedPurchaseItemsCount</strong> صنف — <strong>@EditTotalWeighedKg.ToString("0.000") كجم</strong> (@EditWeighedPurchaseItemsTotal.ToString("N2") ج.م)
                        </span>
                    </div>

                    <div style="display: flex; gap: 0.25rem; align-items: center;">
                        <span style="font-size: 0.75rem; color: var(--text-secondary); margin-left: 0.2rem;">عرض:</span>
                        <button type="button" 
                                class="btn btn-sm @(editTableFilter == "all" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem;" 
                                @onclick="@(() => editTableFilter = "all")">
                            الكل (@editPurchaseItems.Count)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(editTableFilter == "regular" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem;" 
                                @onclick="@(() => editTableFilter = "regular")">
                            <i class="fa-solid fa-box me-1"></i> عادية (@EditRegularPurchaseItemsCount)
                        </button>
                        <button type="button" 
                                class="btn btn-sm @(editTableFilter == "weighed" ? "btn-primary" : "btn-secondary")" 
                                style="font-size: 0.74rem; padding: 0.15rem 0.5rem; @(editTableFilter == "weighed" ? "background-color: #10b981; border-color: #059669;" : "")" 
                                @onclick="@(() => editTableFilter = "weighed")">
                            <i class="fa-solid fa-scale-balanced me-1"></i> بالوزن (@EditWeighedPurchaseItemsCount)
                        </button>
                    </div>
                </div>

                <!-- Items Table in Edit -->
                <div class="table-container" style="min-height: 250px; max-height: 380px; overflow-y: auto; margin-bottom: 0.75rem; border: 1px solid var(--border-color); border-radius: 8px;">
                    <table class="data-table">
                        <thead style="position: sticky; top: 0; background: var(--bg-card); z-index: 2; box-shadow: 0 1px 0 var(--border-color);">
                            <tr>
                                <th style="min-width: 180px;">اسم الصنف</th>
                                <th style="min-width: 110px; text-align: center;">الكمية / الوزن</th>
                                <th>الصلاحية</th>
                                <th>التشغيلة</th>
                                <th style="width: 115px; text-align: left;">سعر التكلفة</th>
                                <th style="width: 105px; text-align: left;">الإجمالي</th>
                                <th style="width: 70px; text-align: center;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!editPurchaseItems.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                                        لم يتم إضافة أي أصناف بعد.
                                    </td>
                                </tr>
                            }
                            else if (!DisplayedEditPurchaseItems.Any())
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                                        لا توجد أصناف مطابقة لفلتر العرض الحالي.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in DisplayedEditPurchaseItems)
                                {
                                    var prod = availableProducts.FirstOrDefault(p => p.Id == item.ProductId);
                                    var isWeighed = prod?.IsWeighable == true || (item.Unit != null && (item.Unit.Contains("كجم") || item.Unit.Contains("كيلو")));
                                    var factor = (prod != null && prod.ConversionFactor > 1) ? prod.ConversionFactor : 1;
                                    bool isCarton = !isWeighed && !string.IsNullOrWhiteSpace(item.Unit) &&
                                                    (string.Equals(item.Unit.Trim(), "كرتونة", StringComparison.OrdinalIgnoreCase) ||
                                                     (!string.IsNullOrWhiteSpace(prod?.ParentUnit) && string.Equals(item.Unit.Trim(), prod.ParentUnit.Trim(), StringComparison.OrdinalIgnoreCase)));
                                    <tr>
                                        <td style="font-weight: 600;">
                                            <div style="display: flex; align-items: center; gap: 0.4rem;">
                                                @if (isWeighed)
                                                {
                                                    <span class="badge" style="background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-scale-balanced me-1"></i> بالوزن
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-size: 0.72rem; padding: 0.15rem 0.4rem;">
                                                        <i class="fa-solid fa-box me-1"></i> عادي
                                                    </span>
                                                }
                                                <span>@(prod?.NameAr ?? "صنف")</span>
                                            </div>
                                        </td>
                                        <td style="text-align: center;">
                                            @if (isWeighed)
                                            {
                                                <input type="number" step="0.001" min="0.001" class="form-control" style="width: 85px; padding: 0.2rem 0.4rem; text-align: center; margin: auto; font-weight: 700; color: #10b981;" value="@item.Quantity" @onchange="@(e => UpdateEditItemQty(item, e.Value))" />
                                                <div style="font-size: 0.72rem; color: #10b981; margin-top: 0.2rem; font-weight: 600;">
                                                    @(prod?.BaseUnit ?? "كجم") (صافي)
                                                </div>
                                            }
                                            else
                                            {
                                                <input type="number" step="1" min="1" class="form-control" style="width: 75px; padding: 0.2rem 0.4rem; text-align: center; margin: auto;" value="@item.Quantity" @onchange="@(e => UpdateEditItemQty(item, e.Value))" />
                                                @if (isCarton && factor > 1)
                                                {
                                                    <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                                        @(prod?.ParentUnit ?? "كرتونة") (@((item.Quantity * factor).ToString("N0")) @(prod?.BaseUnit ?? "قطعة"))
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                                        @(prod?.BaseUnit ?? "قطعة")
                                                    </div>
                                                }
                                            }
                                        </td>
                                        <td style="font-size: 0.82rem; color: @(item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.Today ? "var(--accent-red)" : "inherit");">
                                            @(item.ExpiryDate?.ToString("dd/MM/yyyy") ?? "-")
                                        </td>
                                        <td style="font-size: 0.82rem;">@(string.IsNullOrWhiteSpace(item.BatchNumber) ? "-" : item.BatchNumber)</td>
                                        <td style="text-align: left;">
                                            <input type="number" step="0.01" min="0" class="form-control" style="width: 85px; padding: 0.2rem 0.4rem; text-align: left;" value="@item.UnitCost" @onchange="@(e => UpdateEditItemCost(item, e.Value))" />
                                            @if (isWeighed)
                                            {
                                                <div style="font-size: 0.7rem; color: #10b981; margin-top: 0.2rem;">
                                                    (لكل كجم)
                                                </div>
                                            }
                                            else if (isCarton && factor > 1)
                                            {
                                                <div style="font-size: 0.7rem; color: var(--accent-emerald); margin-top: 0.2rem;">
                                                    (@((item.UnitCost / factor).ToString("N2")) ج.م للقطعة)
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="font-size: 0.7rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                                    (للقطعة)
                                                </div>
                                            }
                                        </td>
                                        <td style="text-align: left; font-weight: 700; color: var(--accent-amber);">@((item.Quantity * item.UnitCost).ToString("N2")) ج.م</td>
                                        <td style="text-align: center; white-space: nowrap;">
                                            @if (prod != null)
                                            {
                                                var pieceCost = isCarton && factor > 1 ? (item.UnitCost / factor) : item.UnitCost;
                                                <button type="button" class="btn btn-sm btn-secondary me-1" style="padding: 0.15rem 0.35rem; font-size: 0.7rem; color: var(--accent-emerald); border-color: rgba(16, 185, 129, 0.3);" title="تطبيق أسعار البيع مباشرة على هذا المنتج في الكتالوج" @onclick="() => OpenApplyPricesModal(prod, pieceCost)">
                                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-danger" style="padding: 0.2rem 0.4rem;" @onclick="() => editPurchaseItems.Remove(item)">
                                                <i class="fa-solid fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="grid-2" style="margin-top: 0.75rem; align-items: stretch;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <label style="margin-bottom: 0; font-weight: 700;">المبلغ المدفوع (ج.م)</label>
                            <div style="display: flex; gap: 0.35rem;">
                                <button type="button" class="btn btn-sm @(editPurchasePaidAmount == editPurchaseInvoiceTotal && editPurchaseInvoiceTotal > 0 ? "btn-primary" : "btn-secondary")" style="font-size: 0.72rem; padding: 0.15rem 0.45rem;" @onclick="SetFullEditPurchasePayment">
                                    <i class="fa-solid fa-check-double me-1"></i> سداد كامل
                                </button>
                                <button type="button" class="btn btn-sm @(editPurchasePaidAmount == 0 ? "btn-primary" : "btn-secondary")" style="font-size: 0.72rem; padding: 0.15rem 0.45rem;" @onclick="SetZeroEditPurchasePayment">
                                    آجل (0)
                                </button>
                            </div>
                        </div>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="editPurchasePaidAmount" @bind:event="oninput" style="font-size: 1.05rem; font-weight: 700; color: var(--accent-emerald);" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="margin-bottom: 0.35rem;">ملاحظات</label>
                        <input class="form-control" @bind="editPurchaseNotes" placeholder="ملاحظات الفاتورة..." />
                    </div>
                </div>

                <div style="background: var(--bg-card); padding: 0.75rem 1rem; border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color); margin-top: 0.75rem;">
                    <div>
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">إجمالي الفاتورة الجديد: </span>
                        <strong style="color: var(--accent-amber); font-size: 1.15rem;">@editPurchaseInvoiceTotal.ToString("N2") ج.م</strong>
                    </div>
                    <div>
                        <span style="font-size: 0.85rem; color: var(--text-secondary);">المتبقي (مديونية): </span>
                        <strong style="color: @(editPurchaseRemainingDebt > 0 ? "var(--accent-red)" : "var(--accent-emerald)"); font-size: 1rem;">@editPurchaseRemainingDebt.ToString("N2") ج.م</strong>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-primary" @onclick="SaveEditPurchase" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk me-1"></i> <span>حفظ التعديلات</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Purchase Confirmation Modal -->
@if (showDeletePurchaseModal && purchaseToDelete != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-card" style="width: 500px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #ef4444;">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> تأكيد حذف فاتورة الشراء
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.85rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @errorMessage
                    </div>
                }

                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1rem; margin-bottom: 1rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; font-size: 0.9rem;">
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">رقم الفاتورة:</span>
                        <strong style="color: var(--accent-blue);">@purchaseToDelete.InvoiceNumber</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">المورد:</span>
                        <strong>@purchaseToDelete.SupplierName</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">المبلغ الإجمالي:</span>
                        <strong style="color: var(--accent-amber);">@purchaseToDelete.TotalAmount.ToString("N2") ج.م</strong>
                    </div>
                    <div>
                        <span style="color: var(--text-secondary); display: block; font-size: 0.8rem;">تاريخ الشراء:</span>
                        <strong>@purchaseToDelete.PurchaseDate.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>

                <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; line-height: 1.5;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    <strong>تحذير الأثر المخزني:</strong> سيتم حذف هذه الفاتورة نهائياً، وسيتم تلقائياً خصم وإلغاء كافة الكميات التي وردت بها من رصيد المخزن الفعلي وتسجيل حركة تصحيحية (Adjustment) لكل صنف بالمخزن.
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-danger" @onclick="DeletePurchaseConfirmed" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-trash me-1"></i> <span>نعم، احذف الفاتورة</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Apply Product Prices Modal -->
@if (showApplyPricesModal && applyPricesProduct != null)
{
    <div class="modal-overlay" @onclick="CloseApplyPricesModal">
        <div class="modal-card" style="width: 490px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: var(--accent-emerald);">
                    <i class="fa-solid fa-wand-magic-sparkles me-2"></i> تطبيق الأسعار على المنتج
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseApplyPricesModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 0.75rem 1rem; margin-bottom: 1rem;">
                    <div style="font-weight: 700; font-size: 1rem; color: var(--text-primary);">@applyPricesProduct.NameAr</div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">
                        الوحدة الأساسية: @(applyPricesProduct.BaseUnit ?? "قطعة") | معامل الكرتونة: @applyPricesProduct.ConversionFactor
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(applyPricesError))
                {
                    <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.5rem 0.75rem; border-radius: 0.4rem; margin-bottom: 0.75rem; font-size: 0.82rem;">
                        <i class="fa-solid fa-circle-exclamation me-1"></i> @applyPricesError
                    </div>
                }

                <div class="grid-3" style="gap: 0.6rem; margin-bottom: 0.75rem;">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.8rem;">سعر الشراء / التكلفة</label>
                        <input type="number" step="0.01" class="form-control" @bind="applyPurchasePrice" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.8rem;">سعر بيع القطاعي <span style="color: var(--accent-red);">*</span></label>
                        <input type="number" step="0.01" class="form-control" @bind="applySellingPrice" />
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.8rem;">سعر بيع الجملة</label>
                        <input type="number" step="0.01" class="form-control" @bind="applyWholesalePrice" />
                    </div>
                </div>

                @if (applyPricesProduct.ConversionFactor > 1)
                {
                    <div style="background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 0.5rem; padding: 0.6rem 0.85rem; font-size: 0.8rem;">
                        <div style="font-weight: 700; color: var(--accent-emerald); margin-bottom: 0.25rem;">
                            معاينة أسعار الكرتونة المقابلة (@applyPricesProduct.ConversionFactor قطعة):
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span>تكلفة الكرتونة: <strong>@((applyPurchasePrice * applyPricesProduct.ConversionFactor).ToString("N2")) ج.م</strong></span>
                            <span>قطاعي: <strong>@((applySellingPrice * applyPricesProduct.ConversionFactor).ToString("N2")) ج.م</strong></span>
                            <span>جملة: <strong>@((applyWholesalePrice * applyPricesProduct.ConversionFactor).ToString("N2")) ج.م</strong></span>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseApplyPricesModal" disabled="@isApplyingPrices">إلغاء</button>
                <button class="btn btn-primary" @onclick="ExecuteApplyPrices" disabled="@isApplyingPrices">
                    @if (isApplyingPrices)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري التطبيق...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>حفظ وتطبيق الأسعار</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "purchases";
    private List<PurchaseDto> purchases = new();
    private List<PurchaseDto> filteredPurchases = new();
    private List<SupplierDto> suppliers = new();
    private List<SupplierDto> filteredSuppliers = new();
    private List<ProductDto> availableProducts = new();
    private bool isLoading = true;

    private string searchQueryPurchases = string.Empty;
    private string searchQuerySuppliers = string.Empty;

    private int purchasesCurrentPage = 1;
    private int suppliersCurrentPage = 1;
    private int pageSize = 10;
    private IEnumerable<PurchaseDto> PagedPurchases => filteredPurchases.Skip((purchasesCurrentPage - 1) * pageSize).Take(pageSize);
    private IEnumerable<SupplierDto> PagedSuppliers => filteredSuppliers.Skip((suppliersCurrentPage - 1) * pageSize).Take(pageSize);


    private bool showAddSupplierModal = false;
    private bool showEditSupplierModal = false;
    private bool showAddPurchaseModal = false;
    private bool showPayModal = false;
    private PurchaseDto? selectedPurchaseForPayment = null;
    private decimal payAmount = 0;
    private Guid? activeMenuPurchaseId;
    private void TogglePurchaseMenu(Guid id) => activeMenuPurchaseId = activeMenuPurchaseId == id ? null : id;
    private void ClosePurchaseMenu() => activeMenuPurchaseId = null;

    private ProductDto? SelectedProduct =>
        Guid.TryParse(selectedProductIdString, out var id) ? availableProducts.FirstOrDefault(p => p.Id == id) : null;

    private ProductDto? EditSelectedProduct =>
        Guid.TryParse(editSelectedProductIdString, out var id) ? availableProducts.FirstOrDefault(p => p.Id == id) : null;

    // Apply Prices directly from Purchases
    private bool showApplyPricesModal = false;
    private ProductDto? applyPricesProduct = null;
    private decimal applyPurchasePrice = 0;
    private decimal applySellingPrice = 0;
    private decimal applyWholesalePrice = 0;
    private bool isApplyingPrices = false;
    private string applyPricesError = string.Empty;

    private void OpenApplyPricesModal(ProductDto? prod, decimal? pieceCost = null)
    {
        if (prod == null) return;
        applyPricesProduct = prod;
        applyPurchasePrice = pieceCost.HasValue && pieceCost.Value > 0 ? Math.Round(pieceCost.Value, 2) : prod.PurchasePrice;
        applySellingPrice = prod.SellingPrice;
        applyWholesalePrice = prod.WholesalePrice;
        applyPricesError = string.Empty;
        showApplyPricesModal = true;
    }

    private void CloseApplyPricesModal()
    {
        showApplyPricesModal = false;
        applyPricesProduct = null;
    }

    private async Task ExecuteApplyPrices()
    {
        if (applyPricesProduct == null) return;
        if (applySellingPrice <= 0)
        {
            applyPricesError = "الرجاء إدخال سعر بيع صحيح.";
            return;
        }

        isApplyingPrices = true;
        applyPricesError = string.Empty;
        var req = new ApplyProductPricesRequest(applyPurchasePrice, applySellingPrice, applyWholesalePrice);
        var (success, err) = await ApiClient.ApplyProductPricesAsync(applyPricesProduct.Id, req);
        isApplyingPrices = false;

        if (success)
        {
            CloseApplyPricesModal();
            availableProducts = await ApiClient.GetProductsAsync();
        }
        else
        {
            applyPricesError = !string.IsNullOrEmpty(err) ? err : "فشل تطبيق الأسعار على المنتج.";
        }
    }

    // Floating Expiry Notifications State
    public class ExpiryAlertNotification
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public bool IsExpired { get; set; }
        public DateTime CreatedAt { get; set; } = DateTime.Now;
    }
    private List<ExpiryAlertNotification> activeExpiryAlerts = new();

    private void TriggerExpiryAlert(string title, string message, bool isExpired)
    {
        activeExpiryAlerts.RemoveAll(a => a.Title == title);
        var alert = new ExpiryAlertNotification
        {
            Title = title,
            Message = message,
            IsExpired = isExpired
        };
        activeExpiryAlerts.Insert(0, alert);
        if (activeExpiryAlerts.Count > 4)
        {
            activeExpiryAlerts.RemoveAt(activeExpiryAlerts.Count - 1);
        }
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(6000);
            await InvokeAsync(() =>
            {
                activeExpiryAlerts.RemoveAll(a => a.Id == alert.Id);
                StateHasChanged();
            });
        });
    }

    private void DismissExpiryAlert(Guid id)
    {
        activeExpiryAlerts.RemoveAll(a => a.Id == id);
    }

    private void CheckProductStockExpiry(ProductDto? prod)
    {
        if (prod == null || expiringProducts == null || !expiringProducts.Any()) return;

        var expiredBatch = expiringProducts.FirstOrDefault(e => e.ProductId == prod.Id && e.DaysRemaining < 0);
        if (expiredBatch != null)
        {
            var daysAgo = Math.Abs(expiredBatch.DaysRemaining);
            TriggerExpiryAlert(
                "⚠️ تحذير: الصنف به كميات منتهية الصلاحية بالمخزن!",
                $"المنتج: <strong style='color:#fff;'>{prod.NameAr}</strong><br/>توجد دفعة منتهية بالمخزن منذ {daysAgo} يوم ({expiredBatch.ExpiryDate:dd/MM/yyyy})، المتبقي منها: <strong style='color:#fecaca;'>{expiredBatch.QuantityInStock:N0} قطعة</strong>.",
                isExpired: true);
            return;
        }

        var soonBatch = expiringProducts.FirstOrDefault(e => e.ProductId == prod.Id && e.DaysRemaining >= 0 && e.DaysRemaining <= 30);
        if (soonBatch != null)
        {
            TriggerExpiryAlert(
                "⚠️ تنبيه: الصنف يقترب من انتهاء الصلاحية بالمخزن!",
                $"المنتج: <strong style='color:#fff;'>{prod.NameAr}</strong><br/>توجد دفعة بالمخزن تنتهي بعد {soonBatch.DaysRemaining} يوم ({soonBatch.ExpiryDate:dd/MM/yyyy})، المتبقي منها: <strong style='color:#fef08a;'>{soonBatch.QuantityInStock:N0} قطعة</strong>.",
                isExpired: false);
        }
    }

    private static bool TryParseDdMmYyyy(string? input, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(input)) return false;
        var trimmed = input.Trim();
        string[] formats = new[]
        {
            "dd/MM/yyyy", "d/M/yyyy", "dd/M/yyyy", "d/MM/yyyy",
            "dd-MM-yyyy", "d-M-yyyy", "dd-M-yyyy", "d-MM-yyyy",
            "yyyy-MM-dd", "yyyy/MM/dd"
        };
        if (DateTime.TryParseExact(trimmed, formats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out result))
        {
            return true;
        }
        return DateTime.TryParse(trimmed, out result);
    }

