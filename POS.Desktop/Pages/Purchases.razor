                    addItemProductionDateStr = addItemProductionDate.Value.ToString("dd/MM/yyyy");
                    int days = matched.ShelfLifeDays > 0 ? matched.ShelfLifeDays : 365;
                    addItemExpiryDate = addItemProductionDate.Value.Date.AddDays(days);
                }
                else
                {
                    addItemProductionDate = null;
                    addItemProductionDateStr = string.Empty;
                    addItemExpiryDate = null;
                }
                errorMessage = string.Empty;
                CheckProductStockExpiry(matched);
            }
        }
    }

    private void HandleEditProductNameSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var matched = FilteredEditPurchaseProducts.FirstOrDefault();
            if (matched != null)
            {
                editSelectedProductIdString = matched.Id.ToString();
                editCurrentProductPackaging = PackagingUnitHelper.Parse(matched.Description);
                editAddItemCartonFactor = ResolveProductCartonFactor(matched);
                editSelectedUnitType = matched.IsWeighable ? "weight" : "piece";
                editBaseProductPieceCost = matched.PurchasePrice > 0 ? matched.PurchasePrice : matched.SellingPrice;
                editAddItemCost = editBaseProductPieceCost;
                editAddItemQty = matched.IsWeighable ? 1.000m : 1m;
                if (matched.TrackExpiry)
                {
                    editAddItemProductionDate ??= editPurchaseDate.Date;
                    editAddItemProductionDateStr = editAddItemProductionDate.Value.ToString("dd/MM/yyyy");
                    int days = matched.ShelfLifeDays > 0 ? matched.ShelfLifeDays : 365;
                    editAddItemExpiryDate = editAddItemProductionDate.Value.Date.AddDays(days);
                }
                else
                {
                    editAddItemProductionDate = null;
                    editAddItemProductionDateStr = string.Empty;
                    editAddItemExpiryDate = null;
                }
                errorMessage = string.Empty;
                CheckProductStockExpiry(matched);
            }
        }
    }

    private void AddPurchaseLineItem()
    {
        if (!Guid.TryParse(selectedProductIdString, out var pId) || pId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار المنتج أولاً.";
            return;
        }

        if (addItemQty <= 0 || addItemCost <= 0)
        {
            errorMessage = "الرجاء إدخال كمية وسعر شراء صحيحين.";
            return;
        }

        var prod = availableProducts.FirstOrDefault(p => p.Id == pId);
        string unitName = prod != null && prod.IsWeighable
            ? (string.IsNullOrWhiteSpace(prod.BaseUnit) ? "كجم" : prod.BaseUnit)
            : (selectedUnitType == "carton" ? (prod?.ParentUnit ?? "كرتونة") : (prod?.BaseUnit ?? "قطعة"));

        purchaseItems.Add(new CreatePurchaseItemRequest(
            pId,
            addItemQty,
            addItemCost,
            ExpiryDate: (prod != null && prod.TrackExpiry) ? addItemExpiryDate : null,
            BatchNumber: null,
            Unit: unitName));

        if (isFullPayment)
        {
            purchasePaidAmount = purchaseInvoiceTotal;
        }
        SyncDraftState();

        addItemQty = 1;
        addItemCost = 0;
        baseProductPieceCost = 0;
        addItemProductionDate = null;
        addItemProductionDateStr = string.Empty;
        addItemExpiryDate = null;
        addItemBatchNumber = null;
        selectedUnitType = "piece";
        selectedProductIdString = string.Empty;
        errorMessage = string.Empty;
        _ = FocusPurchaseBarcodeAsync();
    }

    private async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(newSupplier.Name))
        {
            errorMessage = "الرجاء إدخال اسم المورد.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newSupplier.Phone))
        {
            errorMessage = "الرجاء إدخال رقم هاتف المورد.";
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        var req = new CreateSupplierRequest(newSupplier.Name, newSupplier.Phone, newSupplier.Email, newSupplier.Address, newSupplier.ContactPerson);
        var (success, error) = await ApiClient.CreateSupplierAsync(req);
        isSaving = false;

        if (success)
        {
            CloseModals();
            activeTab = "suppliers";
            searchQuerySuppliers = string.Empty;
            await LoadData();
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncNowAsync(forceCatalogPush: true));
        }
        else
        {
            errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل إضافة المورد.";
        }
    }

    private async Task SavePurchase()
    {
        if (!Guid.TryParse(selectedSupplierIdString, out var supId) || supId == Guid.Empty)
        {
            errorMessage = "الرجاء اختيار المورد.";
            return;
        }

        if (!purchaseItems.Any())
        {
            errorMessage = "الرجاء إضافة صنف واحد على الأقل في فاتورة الشراء.";
            return;
        }

        isSaving = true;
        errorMessage = string.Empty;

        var userId = AuthState.UserId != Guid.Empty ? AuthState.UserId : Guid.Parse("00000000-0000-0000-0000-000000000001");
        var totalAmount = purchaseItems.Sum(i => i.Quantity * i.UnitCost);
        var finalPaid = isFullPayment ? totalAmount : Math.Clamp(purchasePaidAmount, 0, totalAmount);

        var req = new CreatePurchaseRequest(
            InvoiceNumber: purchaseInvoiceNumber,
            SupplierId: supId,
            CreatedByUserId: userId,
            Items: purchaseItems,
            InternalNumber: null,
            DiscountAmount: 0,
            TaxAmount: 0,
            PaidAmount: finalPaid,
            PaymentMethod: finalPaid < totalAmount ? 4 : 1, // 4: Credit (آجل), 1: Cash (كاش)
            Notes: "فاتورة مشتريات جديدة",
            PurchaseDate: purchaseInvoiceDate);

        var (success, error) = await ApiClient.CreatePurchaseAsync(req);
        isSaving = false;

        if (success)
        {
            DraftState.ClearDraft();
            purchaseItems.Clear();
            CloseModals();
            await LoadData();
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncNowAsync(forceCatalogPush: true));
        }
        else
        {
            errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل تسجيل فاتورة الشراء.";
        }
    }

    private async Task ReceivePurchase(PurchaseDto purchase)
    {
        var userId = AuthState.UserId != Guid.Empty ? AuthState.UserId : Guid.Parse("00000000-0000-0000-0000-000000000001");
        var (success, error) = await ApiClient.ReceivePurchaseAsync(purchase.Id, userId);
        if (success)
        {
            await LoadData();
        }
        else
        {
            errorMessage = !string.IsNullOrEmpty(error) ? error : "فشل استلام فاتورة الشراء.";
        }
    }
}
