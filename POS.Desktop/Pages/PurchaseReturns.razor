@code {
    private List<PurchaseReturnDto> returns = new();
    private List<PurchaseReturnDto> filteredReturns = new();
    private List<PurchaseDto> purchasesList = new();
    private PurchaseDetailDto? selectedPurchaseDetail;

    private string searchQuery = string.Empty;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;
    private string? successMessage;
    private string? modalError;

    // Modals
    private bool showNewReturnModal = false;
    private bool showDetailsModal = false;
    private bool showEditReturnModal = false;
    private bool showDeleteReturnModal = false;

    private PurchaseReturnDetailDto? selectedReturnDetail;
    private PurchaseReturnDto? returnToDelete;
    private PurchaseReturnDetailDto? editReturnModel;

    // New Return fields
    private string selectedPurchaseIdString = string.Empty;
    private string? reason;
    private string? notes;

    // Edit Return fields
    private string? editReason;
    private string? editNotes;

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<PurchaseReturnDto> PagedReturns => filteredReturns.Skip((currentPage - 1) * pageSize).Take(pageSize);

    public class PurchaseReturnItemViewModel
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string? Barcode { get; set; }
        public decimal UnitCost { get; set; }
        public decimal MaxQuantity { get; set; }
        public decimal ReturnedQuantity { get; set; }
        public decimal RemainingQuantity { get; set; }
        public decimal ReturnQuantity { get; set; }

        public string BaseUnit { get; set; } = "قطعة";
        public string ParentUnit { get; set; } = "كرتونة";
        public int ConversionFactor { get; set; } = 1;
        public bool HasCartons => ConversionFactor > 1;
        public string UnitLabel => HasCartons ? ParentUnit : BaseUnit;

        public void SetFullReturn()
        {
            ReturnQuantity = RemainingQuantity;
        }

        public void ClearReturn()
        {
            ReturnQuantity = 0;
        }

        public string GetPackagingSummary(decimal qty)
        {
            if (HasCartons)
            {
                var pieces = qty * ConversionFactor;
                return $"{qty:G29} {ParentUnit} ({pieces:G29} {BaseUnit})";
            }
            return $"{qty:G29} {BaseUnit}";
        }
    }

    private List<PurchaseReturnItemViewModel> returnItems = new();
    private List<PurchaseReturnItemViewModel> editReturnItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            returns = await ApiClient.GetPurchaseReturnsAsync();
            purchasesList = await ApiClient.GetPurchasesListAsync();
            FilterReturns();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطأ في تحميل البيانات: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterReturns()
    {
        currentPage = 1;
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredReturns = returns.ToList();
        }
        else
        {
            filteredReturns = returns.Where(r =>
                r.ReturnNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (r.SupplierName != null && r.SupplierName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }
        EnsureValidPage();
    }

    private void EnsureValidPage()
    {
        int maxPage = Math.Max(1, (int)Math.Ceiling((double)filteredReturns.Count / pageSize));
        if (currentPage > maxPage) currentPage = maxPage;
    }

    private void CloseModals()
    {
        showNewReturnModal = false;
        showDetailsModal = false;
        showEditReturnModal = false;
        showDeleteReturnModal = false;
        modalError = null;
    }

    private string purchaseInvoiceSearchQuery = string.Empty;

    private IEnumerable<PurchaseDto> FilteredPurchaseInvoices =>
        purchasesList.Where(p =>
            string.IsNullOrWhiteSpace(purchaseInvoiceSearchQuery) ||
            p.InvoiceNumber.Contains(purchaseInvoiceSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            (p.SupplierName != null && p.SupplierName.Contains(purchaseInvoiceSearchQuery, StringComparison.OrdinalIgnoreCase)) ||
            p.PurchaseDate.ToString("yyyy-MM-dd").Contains(purchaseInvoiceSearchQuery));

    private void OpenNewReturnModal()
    {
        selectedPurchaseIdString = string.Empty;
        selectedPurchaseDetail = null;
        purchaseInvoiceSearchQuery = string.Empty;
        returnItems.Clear();
        modalError = null;
        reason = null;
        notes = null;
        showNewReturnModal = true;
    }

    private async Task SelectPurchaseInvoice(PurchaseDto purchase)
    {
        modalError = null;
        selectedPurchaseIdString = purchase.Id.ToString();
        selectedPurchaseDetail = await ApiClient.GetPurchaseDetailsAsync(purchase.Id);
        if (selectedPurchaseDetail != null && selectedPurchaseDetail.Items != null)
        {
            returnItems = selectedPurchaseDetail.Items.Select(i =>
            {
                var factor = i.ConversionFactor > 0 ? i.ConversionFactor : 1;
                var remaining = i.RemainingQuantity > 0 
                    ? i.RemainingQuantity 
                    : (i.ReturnedQuantity > 0 ? Math.Max(0, i.Quantity - i.ReturnedQuantity) : i.Quantity);

                return new PurchaseReturnItemViewModel
                {
                    ProductId = i.ProductId,
                    ProductName = i.ProductName ?? "منتج",
                    Barcode = i.Barcode,
                    UnitCost = i.UnitCostPrice,
                    MaxQuantity = i.Quantity,
                    ReturnedQuantity = i.ReturnedQuantity,
                    RemainingQuantity = remaining,
                    ReturnQuantity = 0,
                    BaseUnit = !string.IsNullOrWhiteSpace(i.BaseUnit) ? i.BaseUnit : "قطعة",
                    ParentUnit = !string.IsNullOrWhiteSpace(i.ParentUnit) ? i.ParentUnit : "كرتونة",
                    ConversionFactor = factor
                };
            }).ToList();
        }
        else
        {
            returnItems.Clear();
        }
    }

    private void ResetSelectedPurchase()
    {
        selectedPurchaseDetail = null;
        selectedPurchaseIdString = string.Empty;
        returnItems.Clear();
        purchaseInvoiceSearchQuery = string.Empty;
    }

    private async Task OnPurchaseSelected(ChangeEventArgs e)
    {
        modalError = null;
        selectedPurchaseIdString = e.Value?.ToString() ?? string.Empty;
        if (Guid.TryParse(selectedPurchaseIdString, out var purchaseId))
        {
            selectedPurchaseDetail = await ApiClient.GetPurchaseDetailsAsync(purchaseId);
            if (selectedPurchaseDetail != null && selectedPurchaseDetail.Items != null)
            {
                returnItems = selectedPurchaseDetail.Items.Select(i =>
                {
                    var factor = i.ConversionFactor > 0 ? i.ConversionFactor : 1;
                    var remaining = i.RemainingQuantity > 0 
                        ? i.RemainingQuantity 
                        : (i.ReturnedQuantity > 0 ? Math.Max(0, i.Quantity - i.ReturnedQuantity) : i.Quantity);

                    return new PurchaseReturnItemViewModel
                    {
                        ProductId = i.ProductId,
                        ProductName = i.ProductName ?? "منتج",
                        Barcode = i.Barcode,
                        UnitCost = i.UnitCostPrice,
                        MaxQuantity = i.Quantity,
                        ReturnedQuantity = i.ReturnedQuantity,
                        RemainingQuantity = remaining,
                        ReturnQuantity = 0,
                        BaseUnit = !string.IsNullOrWhiteSpace(i.BaseUnit) ? i.BaseUnit : "قطعة",
                        ParentUnit = !string.IsNullOrWhiteSpace(i.ParentUnit) ? i.ParentUnit : "كرتونة",
                        ConversionFactor = factor
                    };
                }).ToList();
            }
        }
        else
        {
            selectedPurchaseDetail = null;
            returnItems.Clear();
        }
    }

    private decimal CalculateTotalRefund()
    {
        return returnItems.Where(i => i.ReturnQuantity > 0).Sum(i => i.ReturnQuantity * i.UnitCost);
    }

    private async Task SubmitReturn()
    {
        modalError = null;

        var itemsToReturn = returnItems.Where(i => i.ReturnQuantity > 0).ToList();
        if (!itemsToReturn.Any())
        {
            modalError = "يرجى تحديد كمية إرجاع لمنتج واحد على الأقل.";
            return;
        }

        foreach (var it in itemsToReturn)
        {
            if (it.ReturnQuantity > it.RemainingQuantity)
            {
                modalError = $"الكمية المرتجعة للمنتج ({it.ProductName}) أكبر من الكمية المتبقية المتاحة للإرجاع ({it.RemainingQuantity} {it.UnitLabel}).";
                return;
            }
        }

        if (selectedPurchaseDetail == null)
        {
            modalError = "يرجى اختيار فاتورة الشراء الأصلية.";
            return;
        }

        var userId = AuthState.UserId;

        var req = new CreatePurchaseReturnRequest(
            OriginalPurchaseId: selectedPurchaseDetail.Id,
            SupplierId: selectedPurchaseDetail.SupplierId,
            CreatedByUserId: userId,
            Items: itemsToReturn.Select(i => new PurchaseReturnItemRequest(
                ProductId: i.ProductId,
                Quantity: i.ReturnQuantity,
                UnitCost: i.UnitCost,
                Tax: 0
            )).ToList(),
            Reason: reason,
            Notes: notes
        );

        isSubmitting = true;
        var (success, err) = await ApiClient.CreatePurchaseReturnAsync(req);
        isSubmitting = false;

        if (success)
        {
            successMessage = "تم تسجيل مرتجع المشتريات للمورد بنجاح، وتم خصم الكمية من المخزون.";
            showNewReturnModal = false;
            await LoadData();
            try
            {
                purchasesList = await ApiClient.GetPurchasesListAsync();
            }
            catch { }
            selectedPurchaseDetail = null;
            returnItems.Clear();
        }
        else
        {
            modalError = err ?? "فشل تسجيل المرتجع للمورد.";
        }
    }

    private async Task OpenDetailsModal(PurchaseReturnDto ret)
    {
        modalError = null;
        isLoading = true;
        selectedReturnDetail = await ApiClient.GetPurchaseReturnByIdAsync(ret.Id);
        isLoading = false;

        if (selectedReturnDetail != null)
        {
            showDetailsModal = true;
        }
        else
        {
            errorMessage = "تعذر تحميل تفاصيل مرتجع المشتريات.";
        }
    }

    private async Task OpenEditModal(PurchaseReturnDto ret)
    {
        modalError = null;
        isLoading = true;
        editReturnModel = await ApiClient.GetPurchaseReturnByIdAsync(ret.Id);
        isLoading = false;

        if (editReturnModel != null)
        {
            editReason = editReturnModel.Reason;
            editNotes = editReturnModel.Notes;

            editReturnItems = (editReturnModel.Items ?? new()).Select(i => new PurchaseReturnItemViewModel
            {
                ProductId = i.ProductId,
                ProductName = i.ProductName ?? "منتج",
                Barcode = i.Barcode,
                UnitCost = i.UnitCost,
                MaxQuantity = 999999,
                ReturnQuantity = i.Quantity
            }).ToList();

            showEditReturnModal = true;
        }
        else
        {
            errorMessage = "تعذر تحميل بيانات المرتجع للتعديل.";
        }
    }

    private async Task SaveEditReturn()
    {
        if (editReturnModel == null) return;
        modalError = null;

        var itemsToSave = editReturnItems.Where(i => i.ReturnQuantity > 0).ToList();
        if (!itemsToSave.Any())
        {
            modalError = "يجب أن يحتوي المرتجع على صنف واحد على الأقل بكمية أكبر من صفر.";
            return;
        }

        var req = new UpdatePurchaseReturnRequest(
            Id: editReturnModel.Id,
            Reason: editReason,
            Notes: editNotes,
            Items: itemsToSave.Select(i => new PurchaseReturnItemRequest(
                ProductId: i.ProductId,
                Quantity: i.ReturnQuantity,
                UnitCost: i.UnitCost,
                Tax: 0
            )).ToList(),
            UserId: AuthState.UserId != Guid.Empty ? AuthState.UserId : editReturnModel.CreatedByUserId
        );

        isSubmitting = true;
        var (success, err) = await ApiClient.UpdatePurchaseReturnAsync(editReturnModel.Id, req);
        isSubmitting = false;

        if (success)
        {
            successMessage = "تم حفظ تعديلات مرتجع المشتريات وضبط المخزون بنجاح.";
            showEditReturnModal = false;
            await LoadData();
        }
        else
        {
            modalError = err ?? "فشل حفظ التعديلات.";
        }
    }

    private void ConfirmDeleteReturn(PurchaseReturnDto ret)
    {
        modalError = null;
        returnToDelete = ret;
        showDeleteReturnModal = true;
    }

    private async Task DeleteReturnConfirmed()
    {
        if (returnToDelete == null) return;

        isSubmitting = true;
        var (success, err) = await ApiClient.DeletePurchaseReturnAsync(returnToDelete.Id, AuthState.UserId);
        isSubmitting = false;

        if (success)
        {
            successMessage = $"تم حذف مرتجع المشتريات رقم {returnToDelete.ReturnNumber} وإعادة زيادة رصيد المخزن بنجاح.";
            showDeleteReturnModal = false;
            await LoadData();
        }
        else
        {
            modalError = err ?? "فشل حذف المرتجع.";
        }
    }
}
