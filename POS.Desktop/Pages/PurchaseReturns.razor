@page "/returns/purchases"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@using global::POS.Desktop.Services.Auth
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject CustomAuthStateProvider AuthState

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">مرتجع مشتريات الموردين</h2>
            <p class="page-subtitle">إرجاع البضائع التالفة أو الزائدة للموردين، واسترداد المبالغ المالية وتنقيص رصيد المخزون</p>
        </div>
        <div>
            <button class="btn btn-primary" @onclick="OpenNewReturnModal">
                <i class="fa-solid fa-truck-ramp-box me-1"></i> تسجيل مرتجع لمورد
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.85rem 1.25rem; border-radius: 0.6rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background-color: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: var(--accent-emerald); padding: 0.85rem 1.25rem; border-radius: 0.6rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-circle-check"></i> @successMessage
        </div>
    }

    <!-- Search & Filter bar -->
    <div style="display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div class="search-box" style="max-width: 380px;">
            <i class="fa-solid fa-search"></i>
            <input @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterReturns" placeholder="ابحث برقم المرتجع أو اسم المورد..." />
        </div>
        <div style="font-size: 0.85rem; color: var(--text-secondary);">
            إجمالي المرتجعات: <strong style="color: var(--text-primary);">@filteredReturns.Count</strong>
        </div>
    </div>

    <!-- Returns Table -->
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>رقم المرتجع</th>
                    <th>تاريخ المرتجع</th>
                    <th>اسم المورد</th>
                    <th>السبب</th>
                    <th>الملاحظات</th>
                    <th>المبلغ المسترد</th>
                    <th>الحالة</th>
                    <th style="text-align: center; white-space: nowrap; width: 175px;">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                            <p style="margin-top: 0.5rem;">جاري تحميل سجل مرتجعات الموردين...</p>
                        </td>
                    </tr>
                }
                else if (!filteredReturns.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                            <i class="fa-solid fa-truck-ramp-box" style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                            لا توجد مرتجعات مشتريات مسجلة.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var ret in PagedReturns)
                    {
                        <tr>
                            <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@ret.ReturnNumber</code></td>
                            <td>@ret.ReturnDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(ret.SupplierName) ? "مورد عام" : ret.SupplierName)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(ret.Reason) ? "-" : ret.Reason)</td>
                            <td>@(string.IsNullOrWhiteSpace(ret.Notes) ? "-" : ret.Notes)</td>
                            <td style="color: var(--accent-red, #f87171); font-weight: 700; white-space: nowrap;">
                                <span class="badge badge-red me-1" style="font-size: 0.7rem; padding: 0.15rem 0.35rem;"><i class="fa-solid fa-rotate-left"></i> مرتجع</span>
                                -@ret.TotalAmount.ToString("N2") ج.م
                            </td>
                            <td>
                                <span class="badge badge-green">مكتمل</span>
                            </td>
                            <td style="white-space: nowrap; text-align: center;">
                                <div style="display: flex; gap: 0.4rem; align-items: center; justify-content: center; flex-wrap: nowrap; white-space: nowrap;">
                                    <button class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap;" @onclick="() => OpenDetailsModal(ret)" title="عرض تفاصيل وأصناف المرتجع">
                                        <i class="fa-solid fa-eye" style="color: var(--accent-blue);"></i>
                                        <span>التفاصيل</span>
                                    </button>
                                    <button class="btn btn-sm btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap;" @onclick="() => OpenEditModal(ret)" title="تعديل بيانات وأصناف المرتجع">
                                        <i class="fa-solid fa-pen-to-square" style="color: var(--accent-amber);"></i>
                                        <span>تعديل</span>
                                    </button>
                                    <button class="btn btn-sm btn-danger" style="padding: 0.3rem 0.6rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.3rem; white-space: nowrap;" @onclick="() => ConfirmDeleteReturn(ret)" title="حذف المرتجع واستعادة بضاعة المورد للمخزن">
                                        <i class="fa-solid fa-trash"></i>
                                        <span>حذف</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <Pagination CurrentPage="@currentPage" TotalItems="@filteredReturns.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; EnsureValidPage(); })" />
</div>

<!-- Modal: New Purchase Return -->
@if (showNewReturnModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem;">
        <div class="card" style="width: 100%; max-width: 850px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--accent-indigo);">
                    <i class="fa-solid fa-truck-ramp-box me-2"></i> تسجيل مرتجع مشتريات لمورد
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.9rem;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @modalError
                </div>
            }

            <!-- Step 1: Search & Select Original Purchase Invoice -->
            @if (selectedPurchaseDetail == null)
            {
                <div style="background: var(--bg-primary, #0f172a); padding: 1rem; border-radius: 0.6rem; border: 1px solid var(--border-color); display: flex; flex-direction: column; gap: 0.75rem;">
                    <div>
                        <label style="font-weight: 700; margin-bottom: 0.35rem; display: block; font-size: 0.9rem;">
                            <i class="fa-solid fa-magnifying-glass text-primary me-1"></i> ابحث عن فاتورة الشراء برقم الفاتورة أو اسم المورد أو التاريخ:
                        </label>
                        <div class="search-box" style="width: 100%;">
                            <i class="fa-solid fa-search"></i>
                            <input @bind="purchaseInvoiceSearchQuery"
                                   @bind:event="oninput"
                                   placeholder="اكتب رقم فاتورة الشراء أو اسم المورد أو التاريخ..."
                                   style="border-color: var(--accent-blue); font-size: 0.95rem;" />
                        </div>
                    </div>

                    <div class="table-container" style="max-height: 240px; overflow-y: auto;">
                        <table class="data-table" style="font-size: 0.88rem;">
                            <thead>
                                <tr>
                                    <th>رقم الفاتورة</th>
                                    <th>تاريخ الشراء</th>
                                    <th>المورد</th>
                                    <th>إجمالي الفاتورة</th>
                                    <th>الحالة</th>
                                    <th style="text-align: center; width: 100px;">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredPurchaseInvoices.Any())
                                {
                                    <tr>
                                        <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">
                                            لا توجد فواتير مشتريات مطابقة لكلمات البحث.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in FilteredPurchaseInvoices.Take(15))
                                    {
                                        <tr>
                                            <td><code style="font-weight: 700; color: var(--accent-blue);">@p.InvoiceNumber</code></td>
                                            <td>@p.PurchaseDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td style="font-weight: 600;">@p.SupplierName</td>
                                            <td style="font-weight: 700; color: var(--accent-amber);">@p.TotalAmount.ToString("N2") ج.م</td>
                                            <td>
                                                <span class="badge @(p.Status == "Received" ? "badge-green" : "badge-indigo")">
                                                    @(p.Status == "Received" ? "مستلمة" : p.Status)
                                                </span>
                                            </td>
                                            <td style="text-align: center;">
                                                <button type="button" class="btn btn-sm btn-primary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;" @onclick="() => SelectPurchaseInvoice(p)">
                                                    <i class="fa-solid fa-check me-1"></i> اختيار
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <!-- Step 2: Show Selected Purchase Items -->
                <div style="background: rgba(99, 102, 241, 0.08); border: 1px solid var(--accent-indigo); padding: 0.85rem 1.1rem; border-radius: 0.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <div style="display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; font-size: 0.9rem;">
                        <div>
                            <span style="color: var(--text-secondary); font-size: 0.8rem; display: block;">فاتورة الشراء:</span>
                            <code style="font-weight: 700; font-size: 0.95rem; color: var(--accent-blue);">@selectedPurchaseDetail.InvoiceNumber</code>
                        </div>
                        <div>
                            <span style="color: var(--text-secondary); font-size: 0.8rem; display: block;">المورد:</span>
                            <strong style="color: var(--text-primary);">@selectedPurchaseDetail.SupplierName</strong>
                        </div>
                        <div>
                            <span style="color: var(--text-secondary); font-size: 0.8rem; display: block;">تاريخ الشراء:</span>
                            <span>@selectedPurchaseDetail.PurchaseDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div>
                            <span style="color: var(--text-secondary); font-size: 0.8rem; display: block;">إجمالي الفاتورة:</span>
                            <strong style="color: var(--accent-amber);">@selectedPurchaseDetail.TotalAmount.ToString("N2") ج.م</strong>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-secondary" style="font-size: 0.8rem; padding: 0.3rem 0.65rem;" @onclick="ResetSelectedPurchase">
                        <i class="fa-solid fa-arrows-rotate me-1"></i> تغيير الفاتورة
                    </button>
                </div>

                <div style="background: var(--bg-primary, #0f172a); padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--border-color);">
                    <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--accent-blue);">حدد الأصناف والكميات المراد إرجاعها للمورد:</h4>
                    <table class="data-table" style="font-size: 0.88rem;">
                        <thead>
                            <tr>
                                <th>المنتج</th>
                                <th>تكلفة الوحدة</th>
                                <th>الكمية المشتراة</th>
                                <th>تم إرجاع</th>
                                <th>المتبقي للإرجاع</th>
                                <th style="width: 190px; text-align: center;">الكمية المرتجعة</th>
                                <th style="text-align: left;">الإجمالي المسترد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (selectedPurchaseDetail.Items != null && selectedPurchaseDetail.Items.Any())
                            {
                                @foreach (var item in returnItems)
                                {
                                    <tr style="@(item.RemainingQuantity <= 0 ? "opacity: 0.6; background: rgba(255,255,255,0.02);" : "")">
                                        <td>
                                            <strong>@item.ProductName</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                            {
                                                <div style="font-size: 0.75rem; color: var(--text-secondary);"><i class="fa-solid fa-barcode me-1"></i>@item.Barcode</div>
                                            }
                                        </td>
                                        <td>
                                            <span style="font-weight: 700; color: var(--accent-amber);">@item.UnitCost.ToString("N2") ج.م</span>
                                            <div style="font-size: 0.75rem; color: var(--text-secondary);">لكل @item.UnitLabel</div>
                                        </td>
                                        <td>
                                            <span style="font-weight: 600;">@item.GetPackagingSummary(item.MaxQuantity)</span>
                                        </td>
                                        <td>
                                            @if (item.ReturnedQuantity > 0)
                                            {
                                                <span style="color: var(--accent-red); font-weight: 600;">@item.GetPackagingSummary(item.ReturnedQuantity)</span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--text-secondary);">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.RemainingQuantity <= 0)
                                            {
                                                <span class="badge badge-secondary" style="font-size: 0.75rem;"><i class="fa-solid fa-check-double me-1"></i> مسترجع بالكامل</span>
                                            }
                                            else
                                            {
                                                <strong style="color: var(--accent-emerald);">@item.GetPackagingSummary(item.RemainingQuantity)</strong>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @if (item.RemainingQuantity <= 0)
                                            {
                                                <div style="color: var(--text-secondary); font-size: 0.8rem;">لا يوجد متبقي للإرجاع</div>
                                            }
                                            else
                                            {
                                                <div style="display: flex; flex-direction: column; gap: 0.25rem; align-items: center;">
                                                    <div style="display: flex; align-items: center; gap: 0.4rem; justify-content: center;">
                                                        <input type="number" min="0" max="@item.RemainingQuantity" step="1" 
                                                               class="form-control" style="padding: 0.25rem 0.5rem; text-align: center; width: 75px;" 
                                                               @bind="item.ReturnQuantity" @bind:event="oninput" />
                                                        <span style="font-size: 0.8rem; color: var(--text-secondary);">@item.UnitLabel</span>
                                                        <button type="button" class="btn btn-xs btn-outline-primary" style="padding: 0.15rem 0.4rem; font-size: 0.75rem;" @onclick="item.SetFullReturn" title="إرجاع الكل">
                                                            الكل
                                                        </button>
                                                        @if (item.ReturnQuantity > 0)
                                                        {
                                                            <button type="button" class="btn btn-xs btn-outline-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.75rem;" @onclick="item.ClearReturn" title="تفريغ">
                                                                تفريغ
                                                            </button>
                                                        }
                                                    </div>
                                                    @if (item.HasCartons && item.ReturnQuantity > 0)
                                                    {
                                                        <div style="font-size: 0.72rem; color: var(--accent-red);">
                                                            يخصم (@(item.ReturnQuantity * item.ConversionFactor) @item.BaseUnit) من المخزن
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td style="color: var(--accent-red); font-weight: 700; text-align: left; white-space: nowrap;">
                                            @(item.ReturnQuantity > 0 ? $"-{(item.ReturnQuantity * item.UnitCost):N2} ج.م" : "0.00 ج.م")
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="grid-2">
                    <div class="form-group">
                        <label>سبب الإرجاع</label>
                        <input class="form-control" placeholder="مثال: أصناف تالفة / تاريخ صلاحية قريب / خطأ في الشحنة..." @bind="reason" />
                    </div>

                    <div class="form-group">
                        <label>ملاحظات إضافية</label>
                        <input class="form-control" placeholder="ملاحظات..." @bind="notes" />
                    </div>
                </div>

                <!-- Total Refund Summary & Impact -->
                <div style="background: rgba(239, 68, 68, 0.12); border: 2px solid rgba(239, 68, 68, 0.35); padding: 0.9rem 1.25rem; border-radius: 0.6rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="font-weight: 700; font-size: 1rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                            <i class="fa-solid fa-rotate-left" style="color: #f87171;"></i>
                            <span>إجمالي المبلغ المسترد من المورد:</span>
                        </div>
                        <div style="font-size: 1.5rem; font-weight: 900; color: #ef4444;">
                            -@CalculateTotalRefund().ToString("N2") ج.م
                        </div>
                    </div>
                    <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-secondary); display: flex; gap: 1.2rem; flex-wrap: wrap; border-top: 1px dashed rgba(239, 68, 68, 0.25); padding-top: 0.4rem;">
                        <span style="color: #f87171;"><i class="fa-solid fa-boxes-stacked me-1"></i> يخصم رصيد المنتجات المرتجعة من المخزن تلقائياً (- مخزون)</span>
                        <span style="color: #34d399;"><i class="fa-solid fa-hand-holding-dollar me-1"></i> يسترد المبلغ كاش أو يخفض من رصيد مديونية المورد (+ رصيد/نقدية)</span>
                    </div>
                </div>
            }

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                <button class="btn btn-secondary" @onclick="CloseModals" disabled="@isSubmitting">إلغاء</button>
                <button class="btn btn-primary" @onclick="SubmitReturn" disabled="@(isSubmitting || selectedPurchaseDetail == null || CalculateTotalRefund() <= 0)">
                    @if (isSubmitting)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري المعالجة...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>تأكيد تسجيل المرتجع للمورد</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Purchase Return Details -->
@if (showDetailsModal && selectedReturnDetail != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem;">
        <div class="card" style="width: 100%; max-width: 800px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--accent-blue);">
                    <i class="fa-solid fa-file-invoice me-2"></i> تفاصيل مرتجع المشتريات (@selectedReturnDetail.ReturnNumber)
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="CloseModals">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Metadata Cards Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--border-color);">
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">رقم فاتورة الشراء الأصلية</span>
                    <strong>@(string.IsNullOrWhiteSpace(selectedReturnDetail.OriginalInvoiceNumber) ? "-" : selectedReturnDetail.OriginalInvoiceNumber)</strong>
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">تاريخ المرتجع</span>
                    <strong>@selectedReturnDetail.ReturnDate.ToString("yyyy-MM-dd HH:mm")</strong>
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">المورد</span>
                    <strong>@(string.IsNullOrWhiteSpace(selectedReturnDetail.SupplierName) ? "مورد عام" : selectedReturnDetail.SupplierName)</strong>
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">المستخدم المسؤول</span>
                    <strong>@(string.IsNullOrWhiteSpace(selectedReturnDetail.CreatedByUserName) ? "المسؤول" : selectedReturnDetail.CreatedByUserName)</strong>
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">سبب الإرجاع</span>
                    <strong>@(string.IsNullOrWhiteSpace(selectedReturnDetail.Reason) ? "-" : selectedReturnDetail.Reason)</strong>
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-secondary); display: block;">الحالة</span>
                    <span class="badge badge-green">مكتمل</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedReturnDetail.Notes))
            {
                <div style="background: rgba(255,255,255,0.02); border-left: 3px solid var(--accent-indigo); padding: 0.6rem 0.85rem; border-radius: 0.4rem; font-size: 0.88rem;">
                    <strong>ملاحظات:</strong> @selectedReturnDetail.Notes
                </div>
            }

            <!-- Items Table -->
            <div>
