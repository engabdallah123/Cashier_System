@page "/debts"
@using Microsoft.AspNetCore.Authorization
@using global::POS.Desktop.Services.Api
@attribute [Authorize]
@inject PosApiClient ApiClient
@inject global::POS.Desktop.Services.Sync.ICloudSyncService CloudSync
@implements IDisposable

<div>
    <div class="page-header">
        <div>
            <h2 class="page-title">إدارة الديون والفواتير غير المسددة</h2>
            <p class="page-subtitle">نظام وصول سريع وفلترة ذكية لديون العملاء ومستحقات الموردين مع إمكانية التحصيل والسداد الفوري</p>
        </div>
        <div>
            <button type="button" class="btn btn-secondary" style="font-size: 0.85rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;" @onclick="HandleManualRefresh" title="تحديث بيانات ومزامنة الديون">
                <i class="fa-solid fa-arrows-rotate @(isLoading || CloudSync.IsSyncing ? "fa-spin" : "") text-blue"></i>
                <span>تحديث ومزامنة</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.85rem 1.25rem; border-radius: 0.6rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div style="background-color: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: var(--accent-emerald); padding: 0.85rem 1.25rem; border-radius: 0.6rem; font-weight: 600; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="fa-solid fa-circle-check"></i> @successMessage
        </div>
    }

    <!-- KPI Summary Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
        <div class="card" style="border-right: 4px solid var(--accent-red, #f87171); padding: 1.25rem;">
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.35rem;">
                <i class="fa-solid fa-hand-holding-dollar me-1" style="color: #f87171;"></i> إجمالي ديون العملاء (لنا)
            </div>
            <div style="font-size: 1.5rem; font-weight: 800; color: #f87171;">
                @TotalCustomerDebts.ToString("N2") ج.م
            </div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
                @customerDebts.Count فاتورة مبيعات غير مسددة بالكامل
            </div>
        </div>

        <div class="card" style="border-right: 4px solid var(--accent-amber, #fbbf24); padding: 1.25rem;">
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.35rem;">
                <i class="fa-solid fa-file-invoice-dollar me-1" style="color: #fbbf24;"></i> إجمالي مستحقات الموردين (علينا)
            </div>
            <div style="font-size: 1.5rem; font-weight: 800; color: #fbbf24;">
                @TotalSupplierDebts.ToString("N2") ج.م
            </div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
                @supplierDebts.Count فاتورة شراء متبقي عليها دفعات
            </div>
        </div>

        <div class="card" style="border-right: 4px solid var(--accent-indigo, #818cf8); padding: 1.25rem;">
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.35rem;">
                <i class="fa-solid fa-scale-balanced me-1" style="color: #818cf8;"></i> صافي مركز المديونية
            </div>
            <div style="font-size: 1.5rem; font-weight: 800; color: @(TotalCustomerDebts >= TotalSupplierDebts ? "var(--accent-emerald)" : "#f87171");">
                @((TotalCustomerDebts - TotalSupplierDebts).ToString("N2")) ج.م
            </div>
            <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.25rem;">
                @(TotalCustomerDebts >= TotalSupplierDebts ? "فائض مستحق لصالح المتجر" : "عجز مستحق على المتجر")
            </div>
        </div>
    </div>

    <!-- Navigation Tabs & Smart Filter -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; gap: 0.5rem;">
            <button class="btn @(activeTab == "customers" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("customers")'>
                <i class="fa-solid fa-users me-1"></i> ديون العملاء (@filteredCustomerDebts.Count)
            </button>
            <button class="btn @(activeTab == "suppliers" ? "btn-primary" : "btn-secondary")" @onclick='() => SetTab("suppliers")'>
                <i class="fa-solid fa-truck-field me-1"></i> مستحقات الموردين (@filteredSupplierDebts.Count)
            </button>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <div class="search-box" style="min-width: 280px;">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input @bind="searchQuery" @bind:event="oninput" @onkeyup="ApplyFilter" placeholder="بحث ذكي بالاسم أو الهاتف أو رقم الفاتورة..." />
            </div>

            <select class="form-control" style="width: auto; padding: 0.45rem 0.8rem;" @bind="sortBy" @bind:after="ApplyFilter">
                <option value="date_desc">الأحدث تاريخاً</option>
                <option value="amount_desc">الأعلى مديونية</option>
                <option value="amount_asc">الأقل مديونية</option>
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="text-align: center; color: var(--text-muted); padding: 3rem;">
            <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
            <p style="margin-top: 0.5rem;">جاري تحميل بيانات الديون والفواتير غير المسددة...</p>
        </div>
    }
    else if (activeTab == "customers")
    {
        <!-- Customer Debts Table -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ البيع</th>
                        <th>اسم العميل</th>
                        <th>رقم الهاتف</th>
                        <th>إجمالي الفاتورة</th>
                        <th>المدفوع</th>
                        <th>المتبقي (الدين)</th>
                        <th style="width: 140px; text-align: center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!filteredCustomerDebts.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-circle-check" style="font-size: 2rem; margin-bottom: 0.5rem; color: var(--accent-emerald); display: block;"></i>
                                رائع! لا توجد ديون مسجلة على العملاء مطابقة للبحث.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var debt in PagedCustomerDebts)
                        {
                            <tr>
                                <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@debt.InvoiceNumber</code></td>
                                <td>@debt.SaleDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(debt.CustomerName) ? "عميل غير مسجل" : debt.CustomerName)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(debt.CustomerPhone) ? "-" : debt.CustomerPhone)</td>
                                <td>@debt.TotalAmount.ToString("N2") ج.م</td>
                                <td style="color: var(--accent-emerald);">@debt.PaidAmount.ToString("N2") ج.م</td>
                                <td style="color: #f87171; font-weight: 800; font-size: 1.05rem;">@debt.RemainingAmount.ToString("N2") ج.م</td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <button class="btn btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; margin-left: 0.35rem;" @onclick="() => ViewSaleInvoiceDetails(debt.SaleId)" title="عرض تفاصيل الفاتورة">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" @onclick="() => OpenCustomerPayModal(debt)" title="تحصيل دفعة مديونية">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> تحصيل دفعة
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <Pagination CurrentPage="@currentPage" TotalItems="@filteredCustomerDebts.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; })" />
    }
    else
    {
        <!-- Supplier Debts Table -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>تاريخ الشراء</th>
                        <th>المورد</th>
                        <th>رقم الهاتف</th>
                        <th>إجمالي الفاتورة</th>
                        <th>المدفوع</th>
                        <th>المتبقي علينا</th>
                        <th style="width: 140px; text-align: center;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!filteredSupplierDebts.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">
                                <i class="fa-solid fa-circle-check" style="font-size: 2rem; margin-bottom: 0.5rem; color: var(--accent-emerald); display: block;"></i>
                                ممتاز! جميع فواتير المشتريات مسددة بالكامل للموردين.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var debt in PagedSupplierDebts)
                        {
                            <tr>
                                <td><code style="background: rgba(255,255,255,0.05); padding: 0.2rem 0.4rem; border-radius: 0.3rem;">@debt.InvoiceNumber</code></td>
                                <td>@debt.PurchaseDate.ToString("dd/MM/yyyy")</td>
                                <td><strong>@(string.IsNullOrWhiteSpace(debt.SupplierName) ? "مورد عام" : debt.SupplierName)</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(debt.SupplierPhone) ? "-" : debt.SupplierPhone)</td>
                                <td>@debt.TotalAmount.ToString("N2") ج.م</td>
                                <td style="color: var(--accent-emerald);">@debt.PaidAmount.ToString("N2") ج.م</td>
                                <td style="color: var(--accent-amber); font-weight: 800; font-size: 1.05rem;">@debt.RemainingAmount.ToString("N2") ج.م</td>
                                <td style="text-align: center; white-space: nowrap;">
                                    <button class="btn btn-secondary" style="padding: 0.35rem 0.65rem; font-size: 0.8rem; margin-left: 0.35rem;" @onclick="() => ViewPurchaseInvoiceDetails(debt.PurchaseId)" title="عرض تفاصيل الفاتورة">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn btn-primary" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" @onclick="() => OpenPayModal(debt)" title="سداد دفعة للمورد">
                                        <i class="fa-solid fa-money-bill-wave me-1"></i> سداد دفعة
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <Pagination CurrentPage="@currentPage" TotalItems="@filteredSupplierDebts.Count" PageSize="@pageSize" OnPageChanged="@(p => currentPage = p)" OnPageSizeChanged="@(s => { pageSize = s; currentPage = 1; })" />
    }
</div>

<!-- Modal: Collect Customer Debt Payment -->
@if (selectedCustomerDebtToPay != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem;">
        <div class="card" style="width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--accent-emerald);">
                    <i class="fa-solid fa-hand-holding-dollar me-2"></i> تحصيل دفعة من مديونية العميل
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="() => selectedCustomerDebtToPay = null">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div style="background: var(--bg-primary); padding: 0.85rem 1rem; border-radius: 0.5rem; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;">
                <div><strong>فاتورة رقم:</strong> <code>@selectedCustomerDebtToPay.InvoiceNumber</code></div>
                <div><strong>العميل:</strong> @selectedCustomerDebtToPay.CustomerName</div>
                <div><strong>إجمالي الفاتورة:</strong> @selectedCustomerDebtToPay.TotalAmount.ToString("N2") ج.م</div>
                <div><strong>المدفوع سابقاً:</strong> <span style="color: var(--accent-emerald);">@selectedCustomerDebtToPay.PaidAmount.ToString("N2") ج.م</span></div>
                <div><strong>المبلغ المتبقي كدين:</strong> <span style="color: #f87171; font-weight: 800;">@selectedCustomerDebtToPay.RemainingAmount.ToString("N2") ج.م</span></div>
            </div>

            @if (!string.IsNullOrEmpty(customerPayError))
            {
                <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.65rem 0.9rem; border-radius: 0.5rem; font-size: 0.85rem;">
                    @customerPayError
                </div>
            }

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                    <label style="margin: 0;">المبلغ المحصل الآن (ج.م) <span style="color: var(--accent-red);">*</span></label>
                    <button type="button" class="btn btn-secondary" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;" @onclick="() => customerPayAmount = selectedCustomerDebtToPay.RemainingAmount">
                        كامل المتبقي (@selectedCustomerDebtToPay.RemainingAmount.ToString("N2"))
                    </button>
                </div>
                <input type="number" step="0.5" min="1" max="@selectedCustomerDebtToPay.RemainingAmount" class="form-control" @bind="customerPayAmount" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                <button class="btn btn-secondary" @onclick="() => selectedCustomerDebtToPay = null" disabled="@isPayingCustomer">إلغاء</button>
                <button class="btn btn-primary" @onclick="SubmitCustomerPayment" disabled="@(isPayingCustomer || customerPayAmount <= 0)">
                    @if (isPayingCustomer)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري التسجيل...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>تأكيد التحصيل وإيداع في الخزنة</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: Pay Supplier Debt -->
@if (selectedDebtToPay != null)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem;">
        <div class="card" style="width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--accent-indigo);">
                    <i class="fa-solid fa-money-bill-wave me-2"></i> سداد دفعة للمورد
                </h3>
                <button class="btn btn-secondary" style="padding: 0.3rem 0.6rem;" @onclick="() => selectedDebtToPay = null">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div style="background: var(--bg-primary); padding: 0.85rem 1rem; border-radius: 0.5rem; font-size: 0.9rem; display: flex; flex-direction: column; gap: 0.4rem;">
                <div><strong>فاتورة رقم:</strong> <code>@selectedDebtToPay.InvoiceNumber</code></div>
                <div><strong>المورد:</strong> @selectedDebtToPay.SupplierName</div>
                <div><strong>المبلغ المتبقي:</strong> <span style="color: var(--accent-amber); font-weight: 700;">@selectedDebtToPay.RemainingAmount.ToString("N2") ج.م</span></div>
            </div>

            @if (!string.IsNullOrEmpty(payError))
            {
                <div style="background-color: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.65rem 0.9rem; border-radius: 0.5rem; font-size: 0.85rem;">
                    @payError
                </div>
            }

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                    <label style="margin: 0;">المبلغ المراد سداده الآن (ج.م) <span style="color: var(--accent-red);">*</span></label>
                    <button type="button" class="btn btn-secondary" style="padding: 0.15rem 0.5rem; font-size: 0.75rem;" @onclick="() => payAmount = selectedDebtToPay.RemainingAmount">
                        كامل المتبقي (@selectedDebtToPay.RemainingAmount.ToString("N2"))
                    </button>
                </div>
                <input type="number" step="0.5" min="1" max="@selectedDebtToPay.RemainingAmount" class="form-control" @bind="payAmount" />
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                <button class="btn btn-secondary" @onclick="() => selectedDebtToPay = null" disabled="@isPaying">إلغاء</button>
                <button class="btn btn-primary" @onclick="SubmitPayment" disabled="@(isPaying || payAmount <= 0)">
                    @if (isPaying)
                    {
                        <i class="fa-solid fa-spinner fa-spin me-1"></i> <span>جاري السداد...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-check me-1"></i> <span>تأكيد السداد</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal: View Full Invoice Details -->
@if (showInvoiceDetailsModal)
{
    <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.75); display: flex; align-items: center; justify-content: center; z-index: 1050; padding: 1rem;">
        <div class="card" style="width: 1200px; max-width: 96vw; height: 90vh; max-height: 880px; display: flex; flex-direction: column; overflow: hidden; padding: 1.25rem 1.5rem; gap: 0.75rem;">
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.65rem; flex-shrink: 0;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span class="badge @(isSaleInvoice ? "badge-primary" : "badge-amber")" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
                        @(isSaleInvoice ? "فاتورة مبيعات عميل" : "فاتورة مشتريات مورد")
                    </span>
                    <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">
                        <i class="fa-solid fa-file-invoice me-1" style="color: var(--accent-blue);"></i> تفاصيل الفاتورة كاملة
                    </h3>
                </div>
                <button class="btn btn-secondary" style="padding: 0.35rem 0.75rem;" @onclick="CloseInvoiceDetailsModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            @if (isLoadingInvoiceDetails)
            {
                <div style="text-align: center; padding: 3rem; color: var(--text-secondary); margin: auto;">
                    <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: var(--accent-blue);"></i>
                    <p style="margin-top: 0.5rem;">جاري تحميل تفاصيل الفاتورة...</p>
                </div>
            }
            else if (isSaleInvoice && detailedSaleInvoice != null)
            {
                <!-- Customer Sale Invoice Details -->
                <div style="flex-shrink: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; background: var(--bg-primary); padding: 0.65rem 1rem; border-radius: 0.5rem; font-size: 0.86rem; border: 1px solid var(--border-color-light);">
                    <div><span style="color: var(--text-secondary);">رقم الفاتورة:</span> <code style="font-size: 0.95rem; font-weight: 700;">@detailedSaleInvoice.InvoiceNumber</code></div>
                    <div><span style="color: var(--text-secondary);">تاريخ الفاتورة:</span> <strong>@detailedSaleInvoice.SaleDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    <div><span style="color: var(--text-secondary);">العميل:</span> <strong style="color: var(--accent-blue);">@(detailedSaleInvoice.CustomerName ?? "عميل عام")</strong></div>
                    <div><span style="color: var(--text-secondary);">الكاشير:</span> <strong>@(detailedSaleInvoice.CashierName ?? "-")</strong></div>
                    <div><span style="color: var(--text-secondary);">طريقة الدفع:</span> <span class="badge @(detailedSaleInvoice.PaymentMethod == "Credit" || detailedSaleInvoice.PaymentMethod == "آجل" ? "badge-amber" : "badge-secondary")">@(detailedSaleInvoice.PaymentMethod == "Credit" || detailedSaleInvoice.PaymentMethod == "آجل" ? "آجل" : detailedSaleInvoice.PaymentMethod == "Cash" ? "كاش" : detailedSaleInvoice.PaymentMethod)</span></div>
                    <div><span style="color: var(--text-secondary);">حالة الفاتورة:</span> <span class="badge badge-amber">@detailedSaleInvoice.Status</span></div>
                </div>

                <div style="flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;">
                    <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-primary);">
                        <i class="fa-solid fa-boxes-stacked me-1" style="color: var(--accent-blue);"></i> الأصناف في الفاتورة (@(detailedSaleInvoice.Items?.Count ?? 0) صنف)
                    </h4>
                    <span style="font-size: 0.8rem; color: var(--text-secondary);">عرض مريح لجميع سطور الفاتورة (5 أصناف وأكثر ظاهرة معاً)</span>
                </div>

                <!-- Products Table with expanded vertical space -->
                <div class="table-container" style="flex: 1; min-height: 320px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
                    <table class="data-table" style="font-size: 0.88rem; width: 100%;">
                        <thead style="position: sticky; top: 0; background: var(--bg-card); z-index: 2; box-shadow: 0 1px 0 var(--border-color);">
                            <tr>
                                <th style="width: 45px; text-align: center; padding: 0.55rem 0.75rem;">#</th>
                                <th style="min-width: 220px; padding: 0.55rem 0.75rem;">اسم المنتج</th>
                                <th style="min-width: 140px; padding: 0.55rem 0.75rem;">الباركود</th>
                                <th style="width: 100px; text-align: center; padding: 0.55rem 0.75rem;">الكمية</th>
                                <th style="min-width: 120px; text-align: left; padding: 0.55rem 0.75rem;">سعر الوحدة</th>
                                <th style="min-width: 100px; text-align: left; padding: 0.55rem 0.75rem;">الخصم</th>
                                <th style="min-width: 130px; text-align: left; padding: 0.55rem 0.75rem;">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detailedSaleInvoice.Items != null && detailedSaleInvoice.Items.Any())
                            {
                                int rowIdx = 1;
                                @foreach (var itm in detailedSaleInvoice.Items)
                                {
                                    <tr>
                                        <td style="text-align: center; color: var(--text-muted); padding: 0.5rem 0.75rem;">@(rowIdx++)</td>
                                        <td style="padding: 0.5rem 0.75rem;"><strong style="color: var(--text-primary);">@itm.ProductName</strong></td>
                                        <td style="padding: 0.5rem 0.75rem;"><code>@(itm.Barcode ?? "-")</code></td>
                                        <td style="text-align: center; font-weight: 800; font-size: 0.95rem; padding: 0.5rem 0.75rem;">@itm.Quantity</td>
                                        <td style="text-align: left; padding: 0.5rem 0.75rem;">@itm.UnitPrice.ToString("N2") ج.م</td>
                                        <td style="text-align: left; color: var(--text-muted); padding: 0.5rem 0.75rem;">@itm.Discount.ToString("N2") ج.م</td>
                                        <td style="text-align: left; font-weight: 800; color: var(--accent-emerald); padding: 0.5rem 0.75rem;">@itm.Total.ToString("N2") ج.م</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">لا توجد أصناف مسجلة داخل الفاتورة</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Financial Summary (Compact Ribbon) & Notes -->
                <div style="flex-shrink: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    @if (!string.IsNullOrWhiteSpace(detailedSaleInvoice.Notes))
                    {
                        <div style="font-size: 0.82rem; color: var(--text-secondary); background: rgba(255,255,255,0.02); padding: 0.35rem 0.75rem; border-radius: 0.35rem; border: 1px solid var(--border-color-light);">
                            <strong>ملاحظات:</strong> @detailedSaleInvoice.Notes
                        </div>
                    }

                    <div style="background: var(--bg-primary); padding: 0.65rem 1rem; border-radius: 0.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.88rem; border: 1px solid var(--border-color-light);">
                        <div><span style="color: var(--text-secondary);">المجموع الفرعي:</span> <strong>@detailedSaleInvoice.SubTotal.ToString("N2") ج.م</strong></div>
                        @if (detailedSaleInvoice.DiscountAmount > 0)
                        {
                            <div style="color: var(--accent-amber);"><span style="color: var(--text-secondary);">الخصم:</span> <strong>-@detailedSaleInvoice.DiscountAmount.ToString("N2") ج.م</strong></div>
                        }
                        @if (detailedSaleInvoice.TaxAmount > 0)
                        {
                            <div><span style="color: var(--text-secondary);">الضريبة:</span> <strong>+@detailedSaleInvoice.TaxAmount.ToString("N2") ج.م</strong></div>
                        }
                        <div style="border-right: 1px solid var(--border-color); padding-right: 0.75rem;"><span style="color: var(--text-secondary);">إجمالي الفاتورة:</span> <strong style="color: var(--accent-blue); font-size: 1.05rem;">@detailedSaleInvoice.TotalAmount.ToString("N2") ج.م</strong></div>
                        <div><span style="color: var(--text-secondary);">المبلغ المسدد:</span> <strong style="color: var(--accent-emerald); font-size: 1.05rem;">@detailedSaleInvoice.PaidAmount.ToString("N2") ج.م</strong></div>
                        <div style="background: rgba(239, 68, 68, 0.1); padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(239, 68, 68, 0.25);"><span style="color: #f87171;">المتبقي (الدين):</span> <strong style="color: #f87171; font-size: 1.05rem;">@((detailedSaleInvoice.TotalAmount - detailedSaleInvoice.PaidAmount).ToString("N2")) ج.م</strong></div>
                    </div>
                </div>
            }
            else if (!isSaleInvoice && detailedPurchaseInvoice != null)
            {
                <!-- Supplier Purchase Invoice Details -->
                <div style="flex-shrink: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem; background: var(--bg-primary); padding: 0.65rem 1rem; border-radius: 0.5rem; font-size: 0.86rem; border: 1px solid var(--border-color-light);">
                    <div><span style="color: var(--text-secondary);">رقم الفاتورة:</span> <code style="font-size: 0.95rem; font-weight: 700;">@detailedPurchaseInvoice.InvoiceNumber</code></div>
                    <div><span style="color: var(--text-secondary);">تاريخ الشراء:</span> <strong>@detailedPurchaseInvoice.PurchaseDate.ToString("dd/MM/yyyy")</strong></div>
                    <div><span style="color: var(--text-secondary);">المورد:</span> <strong style="color: var(--accent-amber);">@(detailedPurchaseInvoice.SupplierName ?? "مورد عام")</strong></div>
                    <div><span style="color: var(--text-secondary);">حالة الفاتورة:</span> <span class="badge badge-amber">@detailedPurchaseInvoice.Status</span></div>
                </div>

                <div style="flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;">
                    <h4 style="font-size: 0.95rem; font-weight: 700; margin: 0; color: var(--text-primary);">
                        <i class="fa-solid fa-boxes-stacked me-1" style="color: var(--accent-amber);"></i> الأصناف في الفاتورة (@(detailedPurchaseInvoice.Items?.Count ?? 0) صنف)
                    </h4>
                    <span style="font-size: 0.8rem; color: var(--text-secondary);">عرض مريح لجميع سطور الفاتورة (5 أصناف وأكثر ظاهرة معاً)</span>
                </div>

                <!-- Products Table with expanded vertical space -->
                <div class="table-container" style="flex: 1; min-height: 320px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
                    <table class="data-table" style="font-size: 0.88rem; width: 100%;">
                        <thead style="position: sticky; top: 0; background: var(--bg-card); z-index: 2; box-shadow: 0 1px 0 var(--border-color);">
                            <tr>
                                <th style="width: 45px; text-align: center; padding: 0.55rem 0.75rem;">#</th>
                                <th style="min-width: 200px; padding: 0.55rem 0.75rem;">اسم المنتج</th>
                                <th style="min-width: 130px; padding: 0.55rem 0.75rem;">الباركود</th>
                                <th style="width: 100px; text-align: center; padding: 0.55rem 0.75rem;">الكمية</th>
                                <th style="min-width: 120px; text-align: left; padding: 0.55rem 0.75rem;">سعر الشراء</th>
                                <th style="min-width: 120px; text-align: left; padding: 0.55rem 0.75rem;">الإجمالي</th>
                                <th style="min-width: 120px; padding: 0.55rem 0.75rem;">تاريخ الصلاحية</th>
                                <th style="min-width: 110px; padding: 0.55rem 0.75rem;">رقم الدفعة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (detailedPurchaseInvoice.Items != null && detailedPurchaseInvoice.Items.Any())
                            {
                                int rowIdx = 1;
                                @foreach (var itm in detailedPurchaseInvoice.Items)
                                {
                                    <tr>
                                        <td style="text-align: center; color: var(--text-muted); padding: 0.5rem 0.75rem;">@(rowIdx++)</td>
                                        <td style="padding: 0.5rem 0.75rem;"><strong style="color: var(--text-primary);">@itm.ProductName</strong></td>
                                        <td style="padding: 0.5rem 0.75rem;"><code>@(itm.Barcode ?? "-")</code></td>
                                        <td style="text-align: center; font-weight: 800; font-size: 0.95rem; padding: 0.5rem 0.75rem;">@itm.Quantity</td>
                                        <td style="text-align: left; padding: 0.5rem 0.75rem;">@itm.UnitCost.ToString("N2") ج.م</td>
                                        <td style="text-align: left; font-weight: 800; color: var(--accent-emerald); padding: 0.5rem 0.75rem;">@itm.Total.ToString("N2") ج.م</td>
                                        <td style="padding: 0.5rem 0.75rem;">@(itm.ExpiryDate.HasValue ? itm.ExpiryDate.Value.ToString("dd/MM/yyyy") : "-")</td>
                                        <td style="padding: 0.5rem 0.75rem;"><code>@(itm.BatchNumber ?? "-")</code></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 2rem;">لا توجد أصناف مسجلة داخل الفاتورة</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Financial Summary (Compact Ribbon) & Notes -->
                <div style="flex-shrink: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                    @if (!string.IsNullOrWhiteSpace(detailedPurchaseInvoice.Notes))
                    {
                        <div style="font-size: 0.82rem; color: var(--text-secondary); background: rgba(255,255,255,0.02); padding: 0.35rem 0.75rem; border-radius: 0.35rem; border: 1px solid var(--border-color-light);">
                            <strong>ملاحظات:</strong> @detailedPurchaseInvoice.Notes
                        </div>
                    }

                    <div style="background: var(--bg-primary); padding: 0.65rem 1rem; border-radius: 0.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; font-size: 0.88rem; border: 1px solid var(--border-color-light);">
                        <div><span style="color: var(--text-secondary);">المجموع الفرعي:</span> <strong>@detailedPurchaseInvoice.SubTotal.ToString("N2") ج.م</strong></div>
                        @if (detailedPurchaseInvoice.DiscountAmount > 0)
                        {
                            <div style="color: var(--accent-amber);"><span style="color: var(--text-secondary);">الخصم:</span> <strong>-@detailedPurchaseInvoice.DiscountAmount.ToString("N2") ج.م</strong></div>
                        }
                        @if (detailedPurchaseInvoice.TaxAmount > 0)
                        {
                            <div><span style="color: var(--text-secondary);">الضريبة:</span> <strong>+@detailedPurchaseInvoice.TaxAmount.ToString("N2") ج.م</strong></div>
                        }
                        <div style="border-right: 1px solid var(--border-color); padding-right: 0.75rem;"><span style="color: var(--text-secondary);">إجمالي الفاتورة:</span> <strong style="color: var(--accent-blue); font-size: 1.05rem;">@detailedPurchaseInvoice.TotalAmount.ToString("N2") ج.م</strong></div>
                        <div><span style="color: var(--text-secondary);">المبلغ المسدد للمورد:</span> <strong style="color: var(--accent-emerald); font-size: 1.05rem;">@detailedPurchaseInvoice.PaidAmount.ToString("N2") ج.م</strong></div>
                        <div style="background: rgba(245, 158, 11, 0.1); padding: 0.25rem 0.6rem; border-radius: 6px; border: 1px solid rgba(245, 158, 11, 0.25);"><span style="color: var(--accent-amber);">المتبقي علينا (دين للمورد):</span> <strong style="color: var(--accent-amber); font-size: 1.05rem;">@detailedPurchaseInvoice.RemainingAmount.ToString("N2") ج.م</strong></div>
                    </div>
                </div>
            }
            else
            {
                <div style="text-align: center; padding: 2rem; color: #f87171; margin: auto;">
                    <i class="fa-solid fa-circle-exclamation fa-2x"></i>
                    <p style="margin-top: 0.5rem;">تعذر تحميل تفاصيل الفاتورة.</p>
                </div>
            }

            <div style="display: flex; justify-content: flex-end; border-top: 1px solid var(--border-color); padding-top: 0.6rem; flex-shrink: 0;">
                <button class="btn btn-secondary" @onclick="CloseInvoiceDetailsModal">إغلاق</button>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "customers";
    private List<CustomerDebtDto> customerDebts = new();
    private List<CustomerDebtDto> filteredCustomerDebts = new();
    private List<SupplierDebtDto> supplierDebts = new();
    private List<SupplierDebtDto> filteredSupplierDebts = new();

    // Invoice Details Modal
    private bool showInvoiceDetailsModal = false;
    private bool isLoadingInvoiceDetails = false;
    private bool isSaleInvoice = true;
    private SaleDto? detailedSaleInvoice = null;
    private PurchaseDetailDto? detailedPurchaseInvoice = null;

    private async Task ViewSaleInvoiceDetails(Guid saleId)
    {
        showInvoiceDetailsModal = true;
        isLoadingInvoiceDetails = true;
        isSaleInvoice = true;
        detailedSaleInvoice = null;
        detailedPurchaseInvoice = null;

        detailedSaleInvoice = await ApiClient.GetSaleByIdAsync(saleId);
        isLoadingInvoiceDetails = false;
    }

    private async Task ViewPurchaseInvoiceDetails(Guid purchaseId)
    {
        showInvoiceDetailsModal = true;
        isLoadingInvoiceDetails = true;
        isSaleInvoice = false;
        detailedSaleInvoice = null;
        detailedPurchaseInvoice = null;

        detailedPurchaseInvoice = await ApiClient.GetPurchaseDetailsAsync(purchaseId);
        isLoadingInvoiceDetails = false;
    }

    private void CloseInvoiceDetailsModal()
    {
        showInvoiceDetailsModal = false;
        detailedSaleInvoice = null;
        detailedPurchaseInvoice = null;
    }

    private string searchQuery = string.Empty;
    private string sortBy = "date_desc";
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    private int currentPage = 1;
    private int pageSize = 10;
    private IEnumerable<CustomerDebtDto> PagedCustomerDebts => filteredCustomerDebts.Skip((currentPage - 1) * pageSize).Take(pageSize);
    private IEnumerable<SupplierDebtDto> PagedSupplierDebts => filteredSupplierDebts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private decimal TotalCustomerDebts => customerDebts.Sum(c => c.RemainingAmount);
    private decimal TotalSupplierDebts => supplierDebts.Sum(s => s.RemainingAmount);

    // Pay Supplier Modal
    private SupplierDebtDto? selectedDebtToPay;
    private decimal payAmount;
    private bool isPaying = false;
    private string? payError;

    // Pay Customer Debt Modal
    private CustomerDebtDto? selectedCustomerDebtToPay;
    private decimal customerPayAmount;
    private bool isPayingCustomer = false;
    private string? customerPayError;

    protected override async Task OnInitializedAsync()
    {
        CloudSync.OnSyncStateChanged += HandleSyncStateChanged;
        await LoadDebts();
    }

    private async void HandleSyncStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDebts(silent: true);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CloudSync.OnSyncStateChanged -= HandleSyncStateChanged;
    }

    private async Task HandleManualRefresh()
    {
        isLoading = true;
        _ = Task.Run(async () => await CloudSync.SyncNowAsync());
        await LoadDebts();
    }

    private async Task LoadDebts(bool silent = false)
    {
        if (!silent) isLoading = true;
        if (!silent) errorMessage = null;
        try
        {
            customerDebts = await ApiClient.GetCustomerDebtsAsync() ?? new();
            supplierDebts = await ApiClient.GetSupplierDebtsAsync() ?? new();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            if (!silent) errorMessage = $"خطأ في تحميل الديون: {ex.Message}";
        }
        finally
        {
            if (!silent) isLoading = false;
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        currentPage = 1;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        currentPage = 1;

        // Filter Customer Debts
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredCustomerDebts = customerDebts.ToList();
        }
        else
        {
            filteredCustomerDebts = customerDebts.Where(c =>
                c.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (c.CustomerName != null && c.CustomerName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (c.CustomerPhone != null && c.CustomerPhone.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }

        // Filter Supplier Debts
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredSupplierDebts = supplierDebts.ToList();
        }
        else
        {
            filteredSupplierDebts = supplierDebts.Where(s =>
                s.InvoiceNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (s.SupplierName != null && s.SupplierName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) ||
                (s.SupplierPhone != null && s.SupplierPhone.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();
        }

        // Sort Customer Debts
        filteredCustomerDebts = sortBy switch
        {
            "amount_desc" => filteredCustomerDebts.OrderByDescending(c => c.RemainingAmount).ToList(),
            "amount_asc" => filteredCustomerDebts.OrderBy(c => c.RemainingAmount).ToList(),
            _ => filteredCustomerDebts.OrderByDescending(c => c.SaleDate).ToList()
        };

        // Sort Supplier Debts
        filteredSupplierDebts = sortBy switch
        {
            "amount_desc" => filteredSupplierDebts.OrderByDescending(s => s.RemainingAmount).ToList(),
            "amount_asc" => filteredSupplierDebts.OrderBy(s => s.RemainingAmount).ToList(),
            _ => filteredSupplierDebts.OrderByDescending(s => s.PurchaseDate).ToList()
        };
    }

    private void OpenPayModal(SupplierDebtDto debt)
    {
        selectedDebtToPay = debt;
        payAmount = debt.RemainingAmount;
        payError = null;
    }

    private void OpenCustomerPayModal(CustomerDebtDto debt)
    {
        selectedCustomerDebtToPay = debt;
        customerPayAmount = debt.RemainingAmount;
        customerPayError = null;
    }

    private async Task SubmitCustomerPayment()
    {
        if (selectedCustomerDebtToPay == null || customerPayAmount <= 0) return;
        if (customerPayAmount > selectedCustomerDebtToPay.RemainingAmount + 0.01m)
        {
            customerPayError = "المبلغ المحصل أكبر من المبلغ المتبقي على الفاتورة.";
            return;
        }

        isPayingCustomer = true;
        customerPayError = null;
        var (success, err) = await ApiClient.PayCustomerDebtAsync(selectedCustomerDebtToPay.SaleId, customerPayAmount);
        isPayingCustomer = false;

        if (success)
        {
            successMessage = $"تم تسجيل تحصيل مبلغ {customerPayAmount:N2} ج.م من العميل ({selectedCustomerDebtToPay.CustomerName}) بنجاح.";
            selectedCustomerDebtToPay = null;
            await LoadDebts();
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncNowAsync());
        }
        else
        {
            customerPayError = err ?? "فشل تسجيل تحصيل الدفعة.";
        }
    }

    private async Task SubmitPayment()
    {
        if (selectedDebtToPay == null || payAmount <= 0) return;
        if (payAmount > selectedDebtToPay.RemainingAmount + 0.01m)
        {
            payError = "مبلغ السداد أكبر من المبلغ المتبقي على الفاتورة.";
            return;
        }

        isPaying = true;
        payError = null;
        var (success, err) = await ApiClient.PayPurchaseInvoiceAsync(selectedDebtToPay.PurchaseId, payAmount);
        isPaying = false;

        if (success)
        {
            successMessage = $"تم سداد مبلغ {payAmount:N2} ج.م للفاتورة {selectedDebtToPay.InvoiceNumber} بنجاح.";
            selectedDebtToPay = null;
            await LoadDebts();
            CloudSync.RecordLocalChange();
            _ = Task.Run(async () => await CloudSync.SyncNowAsync(forceCatalogPush: true));
        }
        else
        {
            payError = err ?? "فشل سداد الفاتورة.";
        }
    }
}
