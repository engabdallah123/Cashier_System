<Window x:Class="POS.Desktop.DraftExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنبيه قبل الخروج"
        Width="580" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="#0f172a" 
            BorderBrush="#f59e0b" 
            BorderThickness="1.5" 
            CornerRadius="14"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#261b07" BorderBrush="#f59e0b" BorderThickness="1" Margin="0,0,12,0">
                    <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="تنبيه قبل الخروج من البرنامج" Foreground="#f8fafc" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="توجد فاتورة مشتريات ومخزون قيد الإدخال لم تُحفظ بعد" Foreground="#94a3b8" FontSize="12.5" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Close / Stay Button -->
                <Button Grid.Column="2" Width="32" Height="32" Click="OnCancelClick" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="البقاء في البرنامج وإلغاء الخروج">
                    <TextBlock Text="✕" Foreground="#94a3b8" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Content Card -->
            <Border Grid.Row="1" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDraftSummary" Text="تحتوي سلة المخزون حالياً على (0) أصناف بإجمالي 0.00 ج.م." Foreground="#fbbf24" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    
                    <TextBlock Text="إذا قمت بالخروج دون حفظ، سيتم فقدان الأصناف المدخلة ما لم تختر حفظها كمسودة." Foreground="#cbd5e1" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,6" />
                    
                    <TextBlock Text="• اختر [حفظ الفاتورة كمسودة] لاستعادتها تلقائياً بالكامل عند فتح البرنامج مجدداً دون الحاجة لإعادة إدخالها." Foreground="#34d399" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Actions Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Save Draft & Exit -->
                <Button Grid.Column="0" Click="OnSaveAndExitClick" Height="42" Cursor="Hand" Background="#059669" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="حفظ كمسودة والخروج" Foreground="#ffffff" FontSize="13" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <!-- Discard & Exit -->
                <Button Grid.Column="2" Click="OnDiscardAndExitClick" Height="42" Cursor="Hand" Background="#dc2626" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="إلغاء الفاتورة والخروج" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Stay in Application -->
                <Button Grid.Column="4" Click="OnCancelClick" Height="42" Padding="14,0" Cursor="Hand" Background="#334155" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="البقاء بالبرنامج" Foreground="#e2e8f0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
