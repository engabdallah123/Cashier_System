@inject LicenseStateContainer LicenseState
@implements IDisposable

@if (!LicenseState.IsLicensed)
{
    <Activation />
}
else
{
    <CascadingAuthenticationState>
        <AuthorizeView Context="authGlobalCtx">
            <Authorized>
                <Router AppAssembly="@typeof(AppRoutes).Assembly">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                            <NotAuthorized Context="notAuthRouteCtx">
                                <LayoutView Layout="@typeof(AuthLayout)">
                                    <Login />
                                </LayoutView>
                            </NotAuthorized>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                    </Found>
                    <NotFound>
                        <LayoutView Layout="@typeof(MainLayout)">
                            <p role="alert">الصفحة غير موجودة.</p>
                        </LayoutView>
                    </NotFound>
                </Router>
            </Authorized>
            <NotAuthorized Context="notAuthGlobalCtx">
                <LayoutView Layout="@typeof(AuthLayout)">
                    <Login />
                </LayoutView>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>
}

@code {
    protected override void OnInitialized()
    {
        LicenseState.OnLicenseStateChanged += OnLicenseChanged;
    }

    private void OnLicenseChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LicenseState.OnLicenseStateChanged -= OnLicenseChanged;
    }
}
